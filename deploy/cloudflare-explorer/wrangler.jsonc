{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "refspec-atlas-explorer",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-17",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Default "auto-trailing-slash" canonicalizes a direct request for
    // "/index.html" (or any "<name>.html") by 307-redirecting to its
    // extension-less clean URL. The Worker's own PAGE_ROUTES rewrite
    // ("/" -> "/index.html", etc.) would then bounce right back off that
    // redirect and loop forever, so route canonicalization is disabled
    // here -- this Worker does its own routing instead.
    "html_handling": "none",
    // The Worker rewrites "/", "/release", "/agencies" to their .html
    // files and proxies "/data/*" to R2 itself -- run it first everywhere
    // so those rewrites and the range-proxy always take effect. This is a
    // low-traffic reference explorer, not a high-QPS site, so the extra
    // Worker invocation per static-asset request is not worth trading
    // away the simplicity/correctness of a single "always run" rule.
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "refspec-atlas-explorer-data"
    }
  ]
}
