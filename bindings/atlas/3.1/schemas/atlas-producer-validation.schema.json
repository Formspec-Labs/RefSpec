{
  "$id": "https://refspec.org/bindings/atlas/3.1/schemas/atlas-producer-validation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertedInventoryDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "binding": {
      "$ref": "atlas-manifest.schema.json#/$defs/binding"
    },
    "constructorProfile": {
      "const": "atlas-3-source-and-evidence-backed-mapping-v1"
    },
    "constructionSummary": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "path": {
          "const": "atlas-construction-summary.json"
        },
        "profile": {
          "const": "atlas-3-authenticated-construction-summary-v1"
        },
        "releaseCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "releaseInventoryDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "profile",
        "path",
        "digest",
        "releaseCount",
        "releaseInventoryDigest"
      ],
      "type": "object"
    },
    "counts": {
      "$ref": "atlas-manifest.schema.json#/$defs/aggregateCounts"
    },
    "mode": {
      "const": "compiledSourceAndEvidenceBackedMappingProducerValidation"
    },
    "semanticConstruction": {
      "additionalProperties": false,
      "properties": {
        "inputFileCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "inputInventoryDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "profile": {
          "const": "atlas-3-exact-input-whole-distribution-reuse-v1"
        },
        "reuseScope": {
          "const": "wholeDistributionExactInputsOnly"
        }
      },
      "required": [
        "profile",
        "reuseScope",
        "inputInventoryDigest",
        "inputFileCount"
      ],
      "type": "object"
    },
    "sourceAccountingDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "sourceReleaseCount": {
      "$ref": "common.schema.json#/$defs/nonnegativeInteger",
      "minimum": 1
    },
    "status": {
      "const": "passed"
    },
    "type": {
      "const": "AtlasProducerValidation"
    },
    "version": {
      "const": "3.1"
    }
  },
  "required": [
    "type",
    "version",
    "status",
    "mode",
    "constructorProfile",
    "constructionSummary",
    "binding",
    "assertedInventoryDigest",
    "sourceAccountingDigest",
    "sourceReleaseCount",
    "counts"
  ],
  "title": "RefSpec Atlas 3.1 source and publisher-mapping producer receipt",
  "type": "object"
}
