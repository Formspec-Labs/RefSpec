{
  "$id": "https://refspec.org/bindings/atlas/3.1/schemas/registry-descriptors.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "path": {
          "const": "registry-descriptors.nq"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "byteLength",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "atlasIndexPlacementCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "conceptSchemeCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "memberDispositionCounts": {
          "additionalProperties": false,
          "properties": {
            "assignmentEvidenceOnly": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
            "childReleaseOnly": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
            "definitionOnly": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
            "historicalEvidenceOnly": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
            "mappingAssertionsOnly": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
            "memberRelease": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
            "noPublisherRecord": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
            "resourceFamily": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
            "reviewWithheld": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" }
          },
          "required": [
            "assignmentEvidenceOnly",
            "childReleaseOnly",
            "definitionOnly",
            "historicalEvidenceOnly",
            "mappingAssertionsOnly",
            "memberRelease",
            "noPublisherRecord",
            "resourceFamily",
            "reviewWithheld"
          ],
          "type": "object"
        },
        "quadCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "registrySourceCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "resourceSchemeCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "supportedRingStatementCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        }
      },
      "required": [
        "atlasIndexPlacementCount",
        "conceptSchemeCount",
        "memberDispositionCounts",
        "quadCount",
        "registrySourceCount",
        "resourceSchemeCount",
        "supportedRingStatementCount"
      ],
      "type": "object"
    },
    "format": {
      "const": "refspec-atlas-registry-descriptors/3.1"
    },
    "graphIri": {
      "$ref": "common.schema.json#/$defs/absoluteIri",
      "const": "urn:ref:atlas-v3:registry-descriptors"
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "atlasIndexDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "registryResourceProfilesDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "resourceCatalogDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "atlasIndexDigest",
        "registryResourceProfilesDigest",
        "resourceCatalogDigest"
      ],
      "type": "object"
    },
    "proofDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "resourceIdSetDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "schemaVersion": {
      "const": "3.1"
    }
  },
  "required": [
    "artifact",
    "counts",
    "format",
    "graphIri",
    "inputs",
    "proofDigest",
    "resourceIdSetDigest",
    "schemaVersion"
  ],
  "title": "RefSpec Atlas 3.1 registry descriptors",
  "type": "object"
}
