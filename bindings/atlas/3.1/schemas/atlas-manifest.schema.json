{
  "$id": "https://refspec.org/bindings/atlas/3.1/schemas/atlas-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "aggregateCounts": {
      "additionalProperties": false,
      "properties": {
        "crossRingRelationAssertions": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "derivedRelations": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "evidenceBindings": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "identifiers": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "labels": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "mappingAssertions": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "nativeRelationAssertions": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "projectedRelations": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "relationAssertions": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "releases": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "resources": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "sourceAssignments": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "sourceRecords": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        }
      },
      "required": [
        "releases",
        "resources",
        "identifiers",
        "labels",
        "sourceRecords",
        "evidenceBindings",
        "relationAssertions",
        "crossRingRelationAssertions",
        "mappingAssertions",
        "nativeRelationAssertions",
        "sourceAssignments",
        "projectedRelations",
        "derivedRelations"
      ],
      "type": "object"
    },
    "binding": {
      "additionalProperties": false,
      "properties": {
        "acceptanceSchemaDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "contractDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "manifestSchemaDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "ontologyDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "shapesDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "sourceAccountingSchemaDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "validatorVersion": {
          "const": "3.1"
        },
        "version": {
          "const": "3.1"
        }
      },
      "required": [
        "version",
        "contractDigest",
        "ontologyDigest",
        "shapesDigest",
        "manifestSchemaDigest",
        "sourceAccountingSchemaDigest",
        "acceptanceSchemaDigest",
        "validatorVersion"
      ],
      "type": "object"
    },
    "graphCounts": {
      "additionalProperties": false,
      "properties": {
        "asserted": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "derived": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "projection": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        }
      },
      "required": [
        "asserted",
        "projection",
        "derived"
      ],
      "type": "object"
    },
    "graphInventory": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "quadCount": {
                "const": 0
              }
            },
            "required": [
              "quadCount"
            ]
          },
          "then": {
            "properties": {
              "packCount": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "packCount": {
                "minimum": 1
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/absoluteIri"
        },
        "inventoryDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "packCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "quadCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger"
        },
        "role": {
          "enum": [
            "asserted",
            "projection",
            "derived"
          ]
        }
      },
      "required": [
        "role",
        "id",
        "quadCount",
        "packCount",
        "inventoryDigest"
      ],
      "type": "object"
    },
    "jsonMember": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "mediaType": {
          "const": "application/json"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/safeRelativePath"
        },
        "role": {
          "enum": [
            "sourceAccounting",
            "acceptance",
            "producerValidation",
            "constructionSummary"
          ]
        }
      },
      "required": [
        "role",
        "path",
        "mediaType",
        "digest",
        "byteLength"
      ],
      "type": "object"
    },
    "nquadsContent": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "mediaType": {
          "const": "application/n-quads"
        },
        "quadCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        }
      },
      "required": [
        "mediaType",
        "digest",
        "byteLength",
        "quadCount"
      ],
      "type": "object"
    },
    "pack": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sourceRelease"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "graphCounts": {
                "properties": {
                  "asserted": {
                    "minimum": 1
                  },
                  "derived": {
                    "const": 0
                  },
                  "projection": {
                    "const": 0
                  }
                }
              },
              "sourceReleases": {
                "maxItems": 1,
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "catalog",
                  "mapping"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "graphCounts": {
                "properties": {
                  "asserted": {
                    "minimum": 1
                  },
                  "derived": {
                    "const": 0
                  },
                  "projection": {
                    "const": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "view"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "graphCounts": {
                    "properties": {
                      "projection": {
                        "minimum": 1
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "graphCounts": {
                    "properties": {
                      "derived": {
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            ],
            "properties": {
              "dependencies": {
                "minItems": 1
              },
              "graphCounts": {
                "properties": {
                  "asserted": {
                    "const": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "graphCounts": {
                    "properties": {
                      "projection": {
                        "minimum": 1
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "graphCounts": {
                    "properties": {
                      "derived": {
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            ],
            "required": [
              "graphCounts"
            ]
          },
          "then": {
            "required": [
              "inputAssertedDigest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mapping"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "dependencies": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "properties": {
                  "compression": {
                    "const": "zstd"
                  }
                },
                "required": [
                  "compression"
                ]
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "\\.nq\\.zst$"
              }
            }
          },
          "else": {
            "properties": {
              "path": {
                "pattern": "\\.nq$"
              }
            }
          }
        }
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/nquadsContent"
        },
        "dependencies": {
          "items": {
            "$ref": "common.schema.json#/$defs/absoluteIri"
          },
          "type": "array",
          "uniqueItems": true
        },
        "graphCounts": {
          "$ref": "#/$defs/graphCounts"
        },
        "inputAssertedDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "kind": {
          "enum": [
            "catalog",
            "sourceRelease",
            "mapping",
            "view",
            "aggregate"
          ]
        },
        "packId": {
          "$ref": "common.schema.json#/$defs/absoluteIri"
        },
        "partition": {
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "pattern": "^[0-9a-f]{1,8}$",
              "type": "string"
            },
            "strategy": {
              "const": "sha256-subject-iri-prefix"
            }
          },
          "required": [
            "strategy",
            "prefix"
          ],
          "type": "object"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/safeRelativePath"
        },
        "rings": {
          "items": {
            "enum": [
              "subject",
              "entity",
              "value",
              "legalIdentity"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "sourceReleases": {
          "items": {
            "$ref": "common.schema.json#/$defs/absoluteIri"
          },
          "type": "array",
          "uniqueItems": true
        },
        "transport": {
          "$ref": "#/$defs/transport"
        }
      },
      "required": [
        "packId",
        "kind",
        "path",
        "transport",
        "content",
        "graphCounts",
        "dependencies",
        "sourceReleases",
        "rings"
      ],
      "type": "object"
    },
    "transport": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "byteLength": {
              "$ref": "common.schema.json#/$defs/nonnegativeInteger",
              "minimum": 1
            },
            "compression": {
              "const": "none"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "mediaType": {
              "const": "application/n-quads"
            }
          },
          "required": [
            "compression",
            "mediaType",
            "digest",
            "byteLength"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "byteLength": {
              "$ref": "common.schema.json#/$defs/nonnegativeInteger",
              "minimum": 1
            },
            "compression": {
              "const": "zstd"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "mediaType": {
              "const": "application/zstd"
            }
          },
          "required": [
            "compression",
            "mediaType",
            "digest",
            "byteLength"
          ],
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "canonicalPayloadDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "counts": {
      "$ref": "#/$defs/aggregateCounts"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "distributionId": {
      "$ref": "common.schema.json#/$defs/absoluteIri"
    },
    "format": {
      "const": "refspec-atlas-packed-nquads-3.1"
    },
    "graphs": {
      "items": false,
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/graphInventory"
            },
            {
              "properties": {
                "packCount": {
                  "minimum": 1
                },
                "quadCount": {
                  "minimum": 1
                },
                "role": {
                  "const": "asserted"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/graphInventory"
            },
            {
              "properties": {
                "role": {
                  "const": "projection"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/graphInventory"
            },
            {
              "properties": {
                "role": {
                  "const": "derived"
                }
              }
            }
          ]
        }
      ],
      "type": "array"
    },
    "members": {
      "items": false,
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/jsonMember"
            },
            {
              "properties": {
                "path": {
                  "const": "atlas-source-accounting.json"
                },
                "role": {
                  "const": "sourceAccounting"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/jsonMember"
            },
            {
              "properties": {
                "path": {
                  "const": "atlas-acceptance.json"
                },
                "role": {
                  "const": "acceptance"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/jsonMember"
            },
            {
              "properties": {
                "path": {
                  "const": "atlas-producer-validation.json"
                },
                "role": {
                  "const": "producerValidation"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/jsonMember"
            },
            {
              "properties": {
                "path": {
                  "const": "atlas-construction-summary.json"
                },
                "role": {
                  "const": "constructionSummary"
                }
              }
            }
          ]
        }
      ],
      "type": "array"
    },
    "packs": {
      "items": {
        "$ref": "#/$defs/pack"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "3.1"
    },
    "type": {
      "const": "AtlasManifest"
    }
  },
  "required": [
    "type",
    "schemaVersion",
    "format",
    "distributionId",
    "createdAt",
    "binding",
    "graphs",
    "packs",
    "members",
    "counts",
    "canonicalPayloadDigest"
  ],
  "title": "RefSpec Atlas 3.1 packed manifest",
  "type": "object"
}
