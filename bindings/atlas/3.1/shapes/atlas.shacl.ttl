@prefix atlas:   <https://refspec.org/ns/atlas/v3#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rkaf:    <https://rulespec.org/ns/v1#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl:  <http://www.w3.org/2008/05/skos-xl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://refspec.org/ns/atlas/v3/shapes>
  a owl:Ontology ;
  rdfs:label "RefSpec Atlas SHACL shapes 3.1"@en ;
  rdfs:comment "Closed-world publication constraints for the asserted, projection, and derived roles of an Atlas 3.1 dataset."@en ;
  owl:versionInfo "3.1" .

# Reusable value shapes

atlas:DigestValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:Literal ;
  sh:datatype xsd:string ;
  sh:pattern "^sha256:[0-9a-f]{64}$" ;
  sh:message "A digest MUST use the lowercase sha256:<64 hex> form." .

atlas:SemanticRingValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:IRI .

atlas:ResourceProfileValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:IRI .

atlas:NonEmptyStringValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:Literal ;
  sh:datatype xsd:string ;
  sh:minLength 1 .

atlas:EnglishTextLiteralValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:Literal ;
  sh:datatype rdf:langString ;
  sh:languageIn ( "en" ) .

atlas:DateTimeValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:Literal ;
  sh:datatype xsd:dateTime .

# Releases, schemes, resources, identifiers, and source records

atlas:RegistrySourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:RegistrySource ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path atlas:descriptorPayload ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype rdf:JSON
  ] ;
  sh:property [
    sh:path atlas:memberDisposition ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:in (
      "assignmentEvidenceOnly"
      "childReleaseOnly"
      "definitionOnly"
      "historicalEvidenceOnly"
      "mappingAssertionsOnly"
      "memberRelease"
      "noPublisherRecord"
      "resourceFamily"
      "reviewWithheld"
    )
  ] .

atlas:SourceReleaseShape
  a sh:NodeShape ;
  sh:targetClass atlas:SourceRelease ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:sourceIssued ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path atlas:sourceDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceLocator ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] .

atlas:AtlasReleaseShape
  a sh:NodeShape ;
  sh:targetClass atlas:AtlasRelease ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path dcterms:issued ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path atlas:inScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:ResourceScheme
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:resourceProfile ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:ResourceProfileValueShape
  ] ;
  # Rulespec owns this vocabulary: #ReferenceResourceMembershipMode in
  # constraints/core/reference-resource-release.cue, over the same
  # prov:hadMember carrier. The per-mode obligations below are upstream's --
  # both enumerating modes require at least one member, and
  # membershipNotEnumerated forbids the property rather than leaving it empty.
  # Atlas emits only rkaf:completeMembership today; admitting the other two
  # costs nothing and stops Atlas from minting a parallel term when it needs
  # them.
  sh:property [
    sh:path rkaf:membershipMode ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( rkaf:completeMembership rkaf:partialMembership rkaf:membershipNotEnumerated )
  ] ;
  sh:property [
    sh:path prov:hadMember ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasResource
  ] ;
  sh:xone (
    [
      sh:property [
        sh:path rkaf:membershipMode ;
        sh:hasValue rkaf:completeMembership
      ] ;
      sh:property [ sh:path prov:hadMember ; sh:minCount 1 ]
    ]
    [
      sh:property [
        sh:path rkaf:membershipMode ;
        sh:hasValue rkaf:partialMembership
      ] ;
      sh:property [ sh:path prov:hadMember ; sh:minCount 1 ]
    ]
    [
      sh:property [
        sh:path rkaf:membershipMode ;
        sh:hasValue rkaf:membershipNotEnumerated
      ] ;
      sh:property [ sh:path prov:hadMember ; sh:maxCount 0 ]
    ]
  ) ;
  sh:property [
    sh:path ( atlas:inScheme atlas:resourceProfile ) ;
    sh:equals atlas:resourceProfile
  ] .

atlas:ResourceSchemeShape
  a sh:NodeShape ;
  sh:targetClass atlas:ResourceScheme ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:resourceProfile ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:ResourceProfileValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceDescriptor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:RegistrySource
  ] ;
  sh:property [
    sh:path atlas:supportedRing ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:descriptorPayload ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype rdf:JSON
  ] ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path atlas:collectionMember ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:ResourceScheme
  ] ;
  sh:property [ sh:path atlas:validationRule ; sh:node atlas:NonEmptyStringValueShape ] ;
  sh:property [ sh:path atlas:recordStatus ; sh:maxCount 1 ; sh:node atlas:NonEmptyStringValueShape ] ;
  sh:property [ sh:path atlas:definition ; sh:node atlas:EnglishTextLiteralValueShape ] ;
  sh:property [ sh:path atlas:note ; sh:node atlas:EnglishTextLiteralValueShape ] ;
  sh:property [
    sh:path atlas:validFrom ;
    sh:maxCount 1 ;
    sh:node atlas:DateTimeValueShape ;
    sh:lessThanOrEquals atlas:validUntil
  ] ;
  sh:property [ sh:path atlas:validUntil ; sh:maxCount 1 ; sh:node atlas:DateTimeValueShape ] ;
  sh:or (
    [ sh:not [ sh:property [ sh:path atlas:resourceProfile ; sh:hasValue atlas:conceptScheme ] ] ]
    [ sh:class skos:ConceptScheme ]
  ) .

atlas:ConceptHostingSchemeShape
  a sh:NodeShape ;
  sh:targetObjectsOf skos:inScheme ;
  sh:class skos:ConceptScheme .

atlas:AtlasResourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:AtlasResource ;
  sh:targetClass atlas:SubjectConcept ;
  sh:targetClass atlas:EntityResource ;
  sh:targetClass atlas:ValueResource ;
  sh:targetClass atlas:LegalIdentityResource ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:inRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasRelease
  ] ;
  sh:property [
    sh:path atlas:inScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:ResourceScheme
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:resourceProfile ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:ResourceProfileValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceRecord ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRecord
  ] ;
  sh:property [ sh:path atlas:notation ; sh:node atlas:NonEmptyStringValueShape ] ;
  sh:property [ sh:path atlas:recordStatus ; sh:maxCount 1 ; sh:node atlas:NonEmptyStringValueShape ] ;
  sh:property [ sh:path atlas:definition ; sh:node atlas:EnglishTextLiteralValueShape ] ;
  sh:property [ sh:path atlas:note ; sh:node atlas:EnglishTextLiteralValueShape ] ;
  sh:property [
    sh:path atlas:componentPosition ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0
  ] ;
  sh:property [
    sh:path atlas:validFrom ;
    sh:maxCount 1 ;
    sh:node atlas:DateTimeValueShape ;
    sh:lessThanOrEquals atlas:validUntil
  ] ;
  sh:property [ sh:path atlas:validUntil ; sh:maxCount 1 ; sh:node atlas:DateTimeValueShape ] ;
  sh:property [
    sh:path skos:inScheme ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class skos:ConceptScheme
  ] ;
  sh:property [
    sh:path skosxl:prefLabel ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class skosxl:Label ;
    sh:disjoint skosxl:altLabel ;
    sh:disjoint skosxl:hiddenLabel
  ] ;
  sh:property [
    sh:path skosxl:altLabel ;
    sh:nodeKind sh:IRI ;
    sh:class skosxl:Label ;
    sh:disjoint skosxl:hiddenLabel
  ] ;
  sh:property [
    sh:path skosxl:hiddenLabel ;
    sh:nodeKind sh:IRI ;
    sh:class skosxl:Label
  ] ;
  sh:property [
    sh:path [ sh:alternativePath ( skosxl:prefLabel skosxl:altLabel skosxl:hiddenLabel ) ] ;
    sh:minCount 1
  ] ;
  sh:property [ sh:path skos:prefLabel ; sh:maxCount 0 ] ;
  sh:property [ sh:path skos:altLabel ; sh:maxCount 0 ] ;
  sh:property [ sh:path skos:hiddenLabel ; sh:maxCount 0 ] ;
  sh:property [
    sh:path ( atlas:inRelease atlas:inScheme ) ;
    sh:equals atlas:inScheme
  ] ;
  sh:property [
    sh:path ( atlas:inRelease atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( atlas:inRelease atlas:resourceProfile ) ;
    sh:equals atlas:resourceProfile
  ] ;
  sh:property [
    sh:path [ sh:inversePath prov:hadMember ] ;
    sh:equals atlas:inRelease
  ] .

atlas:SubjectConceptShape
  a sh:NodeShape ;
  sh:targetClass atlas:SubjectConcept ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:subject ] ;
  sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:equals atlas:inScheme ] .

atlas:EntityResourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:EntityResource ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:entity ] ;
  sh:property [ sh:path skos:inScheme ; sh:maxCount 0 ] .

atlas:ValueResourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:ValueResource ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:value ] ;
  sh:or (
    [
      sh:not [ sh:class skos:Concept ] ;
      sh:property [ sh:path skos:inScheme ; sh:maxCount 0 ]
    ]
    [
      sh:class skos:Concept ;
      sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:equals atlas:inScheme ]
    ]
  ) .

atlas:LegalIdentityResourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:LegalIdentityResource ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:legalIdentity ] ;
  sh:property [ sh:path skos:inScheme ; sh:maxCount 0 ] .

atlas:IdentifierShape
  a sh:NodeShape ;
  sh:targetClass atlas:Identifier ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:identifierValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path atlas:identifierScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:ResourceScheme
  ] ;
  sh:property [
    sh:path atlas:identifies ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasResource
  ] ;
  sh:property [
    sh:path atlas:sourceRecord ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRecord
  ] ;
  sh:property [
    sh:path ( atlas:identifierScheme atlas:resourceProfile ) ;
    sh:hasValue atlas:identifierScheme
  ] .

atlas:SourceRecordShape
  a sh:NodeShape ;
  sh:targetClass atlas:SourceRecord ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:inSourceRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRelease
  ] ;
  sh:property [
    sh:path atlas:sourceDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceLocator ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:nativePayload ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype rdf:JSON
  ] ;
  sh:property [
    sh:path atlas:representsResource ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasResource
  ] .

atlas:EditorialPolicyShape
  a sh:NodeShape ;
  sh:targetClass atlas:EditorialPolicy ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:policyPayload ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype rdf:JSON
  ] .

# rkaf:RegistryConflict, upstream's #RegistryConflict over the three fields
# Atlas writes. This shape says what a conflict record must LOOK like; that the
# entries it names are the ones actually disagreeing is a comparison between
# several Identifier records and one conflict record, so per-property SHACL
# cannot reach it and tools/validate.py's dataset.identifier-uniqueness gate
# owns it -- the same division the machine-adjudication block states.
#
# rkaf:conflictingScope and rkaf:detectedBy are upstream-optional and absent.
# The scope is already derivable from the entries: each names its own
# atlas:identifierScheme and atlas:identifierValue, so a scope literal beside
# them could only agree or disagree with the pair the conflict is about. The
# detector is the binding validator, which this wire gives no IRI -- the
# acceptance record names it by name and version instead. A field nothing
# writes and nothing checks is how atlas:eventType got into the state that
# deleted it.
atlas:RegistryConflictShape
  a sh:NodeShape ;
  sh:targetClass rkaf:RegistryConflict ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  # Two upstream, two here: one entry cannot disagree with itself, and a
  # "conflict" naming a single record is a mislabelled unilateral claim.
  # Class-ranged to atlas:Identifier because that is the only registry entry
  # Atlas detects a disagreement between -- see the registry-conflict block in
  # ontology/atlas.ttl for why the SKOS integrity conditions are not on this
  # path and are not licensable by a record at all.
  sh:property [
    sh:path rkaf:conflictingEntries ;
    sh:minCount 2 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:Identifier
  ] ;
  # Narrowed from upstream's four to the two a PUBLISHED distribution can
  # honestly declare about itself. rkaf:publicationBlocking says the conflict
  # blocks publication and rkaf:authorityCritical says it breaks an authority
  # chain; a distribution carrying either and still passing acceptance would be
  # contradicting its own record. A conflict at those severities has no
  # published artifact to ride in -- the build refuses, which is what the
  # severity means.
  sh:property [
    sh:path rkaf:severity ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( rkaf:informational rkaf:operationalConflict )
  ] ;
  sh:property [
    sh:path rkaf:detectedAt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DateTimeValueShape
  ] .

# Canonical SKOS-XL labels

atlas:SkosXlLabelShape
  a sh:NodeShape ;
  sh:targetClass skosxl:Label ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path skosxl:literalForm ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1 ;
    sh:datatype rdf:langString ;
    sh:message "Atlas 3.1 label literals MUST carry a language tag. The canonical RDF layer requires lowercase BCP 47 spelling."
  ] ;
  sh:property [
    sh:path atlas:inRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasRelease
  ] ;
  sh:property [
    sh:path atlas:sourceRecord ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRecord
  ] .

# Evidence-bearing relation assertions

atlas:RelationAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:RelationAssertion ;
  sh:targetClass atlas:MappingAssertion ;
  sh:targetClass atlas:SkosMappingAssertion ;
  sh:targetClass atlas:NativeRelationAssertion ;
  sh:targetClass atlas:SourceAssignment ;
  sh:targetClass atlas:CrossRingRelationAssertion ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path rdf:subject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rdf:predicate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rdf:object ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:sourceRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:Release
  ] ;
  sh:property [
    sh:path atlas:targetRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:Release
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:targetRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path rkaf:assertedAt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path atlas:governedByPolicy ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:EditorialPolicy
  ] ;
  # No status property. Rulespec's envelope already carries the supersession
  # edge -- "the successor names the assertions it replaces; the predecessors
  # stay addressable" (constraints/core/assertion.cue) -- and withdrawal is a
  # rescission rkaf:LifecycleEvent. A stored status could only agree or
  # disagree with those, and disagreement was the only thing it was checked
  # for. Atlas narrows rkaf's list-valued edge to at most one successor,
  # because the dataset validator rejects a predecessor with two.
  sh:property [
    sh:path rkaf:supersedesAssertion ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:RelationAssertion
  ] ;
  # The temporal context, admitted here because this shape is sh:closed and a
  # closed shape can only permit a path by naming it. Permission is all this
  # says: WHICH assertions must carry a period is a ring rule, and rings differ
  # per assertion class, so the obligation is on atlas:MappingAssertionShape
  # below. What every carrier is held to here is well-formedness -- the object
  # is an IRI that resolves to an rkaf:EffectivePeriod, and that record is
  # shaped by atlas:EffectivePeriodShape.
  sh:property [
    sh:path rkaf:hasEffectivePeriod ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class rkaf:EffectivePeriod
  ] ;
  sh:property [
    sh:path atlas:assertionIdentityDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path [ sh:inversePath rkaf:bindsAssertion ] ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class rkaf:EvidenceBinding
  ] ;
  sh:xone (
    [
      sh:property [ sh:path atlas:semanticRing ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:sourceRing ; sh:maxCount 0 ] ;
      sh:property [ sh:path atlas:targetRing ; sh:maxCount 0 ]
    ]
    [
      sh:property [ sh:path atlas:semanticRing ; sh:maxCount 0 ] ;
      sh:property [ sh:path atlas:sourceRing ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:targetRing ; sh:minCount 1 ]
    ]
  ) .

atlas:MappingAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:MappingAssertion ;
  sh:property [
    sh:path rdf:subject ;
    sh:class atlas:AtlasResource
  ] ;
  sh:property [
    sh:path rdf:object ;
    sh:class atlas:AtlasResource
  ] ;
  sh:property [
    sh:path atlas:sourceRelease ;
    sh:class atlas:AtlasRelease
  ] ;
  sh:property [
    sh:path atlas:targetRelease ;
    sh:class atlas:AtlasRelease
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:inRelease ) ;
    sh:equals atlas:sourceRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:inRelease ) ;
    sh:equals atlas:targetRelease
  ] ;
  # Ring temporal context. A value-ring mapping is a crosswalk between two code
  # editions and a legal-identity mapping is an equivalence between two
  # codifications; both are claims about a period, and an undated one cannot be
  # applied to a dated question. Subject and entity mappings are not: a topical
  # or entity equivalence holds of the concepts themselves, and a period on one
  # would be a fact no source states and nothing could check. That asymmetry is
  # exactly what the registry has enforced since it had rings
  # (semantic_foundation.py's _validated_relation_context, which requires the
  # context for value and legalIdentity and REFUSES it for subject and entity);
  # this is the same rule on the wire.
  #
  # sh:xone, not two sh:or branches: the ring sets partition the four rings and
  # an assertion carries exactly one ring, so precisely one branch can match the
  # ring test, and a mapping that matches its branch's ring but violates its
  # period rule conforms to neither. The four ring individuals are named rather
  # than negated so that a fifth ring, if one is ever minted, lands in no branch
  # and fails loudly instead of silently inheriting "no period required".
  sh:xone (
    [
      sh:property [
        sh:path atlas:semanticRing ;
        sh:in ( atlas:value atlas:legalIdentity )
      ] ;
      sh:property [
        sh:path rkaf:hasEffectivePeriod ;
        sh:minCount 1 ;
        sh:maxCount 1
      ]
    ]
    [
      sh:property [
        sh:path atlas:semanticRing ;
        sh:in ( atlas:subject atlas:entity )
      ] ;
      sh:property [ sh:path rkaf:hasEffectivePeriod ; sh:maxCount 0 ]
    ]
  ) .

# rkaf:EffectivePeriod, upstream's #EffectivePeriod field for field over the two
# fields Atlas writes. rkaf:retroactiveFrom and rkaf:sunsetAt are upstream-
# optional and absent: no Atlas producer supplies either, and a field nothing
# writes cannot be violated, so admitting it would be ceremony. The start is
# required upstream and required here; the end is optional in both, and its
# omission means open-ended -- which is a claim a producer must have a source
# for, not a default the wire manufactures from a bare date. See decision 2 in
# the ring-temporal block of ontology/atlas.ttl.
#
# THE DAY-TO-INSTANT CONVENTION, PINNED. Every date Atlas has to publish here
# arrives from the registry as an ISO calendar day -- `effectiveFrom` and
# `effectiveThrough` on a mapping context
# (src/refspec/registry/infrastructure/semantic_foundation.py) -- while rkaf
# coerces both period bounds to xsd:dateTime (context/rkaf-context.jsonld), so
# a day must become an instant and SOMETHING has to decide which one. Prose
# would not: two producers reading the same paragraph could publish
# 2026-01-01T00:00:00+00:00 and 2026-01-01T00:00:00-05:00 for one source day
# and both would validate, which is a difference of five hours in when a
# crosswalk starts applying.
#
#   start  ->  <day>T00:00:00+00:00       the first instant of the day, UTC
#   end    ->  <day>T23:59:59+00:00       the last whole second of the day, UTC
#
# UTC, because a registry crosswalk is not scoped to any one jurisdiction's
# civil time -- rkaf's own timezone rule (spec/rkaf-rulemaking.md §4) attaches
# a governing timezone to a comment DEADLINE, which has a forum, and a mapping
# between two code schemes has none. The end takes 23:59:59 rather than the
# following midnight because rkaf compares an as-of instant INSIDE
# [start, end] inclusively, so the next day's midnight would publish the
# mapping as effective for one instant of a day the source excluded. A second
# short under-claims; an instant over the boundary states something false, and
# under-claiming is the only one of those a producer may do silently.
atlas:EffectivePeriodShape
  a sh:NodeShape ;
  sh:targetClass rkaf:EffectivePeriod ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path rkaf:effectivePeriodStart ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DateTimeValueShape ;
    sh:pattern "^-?[0-9]{4,}-[0-9]{2}-[0-9]{2}T00:00:00[+]00:00$" ;
    # An end before its start is not a short period, it is a contradiction. The
    # comparison is stated once, from the start, so a period with no end is
    # vacuously conforming rather than needing a second branch to exempt it.
    sh:lessThanOrEquals rkaf:effectivePeriodEnd
  ] ;
  sh:property [
    sh:path rkaf:effectivePeriodEnd ;
    sh:maxCount 1 ;
    sh:node atlas:DateTimeValueShape ;
    sh:pattern "^-?[0-9]{4,}-[0-9]{2}-[0-9]{2}T23:59:59[+]00:00$"
  ] .

atlas:SkosMappingAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:SkosMappingAssertion ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:subject ] ;
  sh:property [ sh:path rdf:subject ; sh:class atlas:SubjectConcept ] ;
  sh:property [ sh:path rdf:object ; sh:class atlas:SubjectConcept ] ;
  sh:property [ sh:path atlas:sourceRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [ sh:path atlas:targetRelease ; sh:class atlas:AtlasRelease ] .

atlas:NativeRelationAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:NativeRelationAssertion ;
  sh:property [ sh:path rdf:subject ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path rdf:object ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path atlas:sourceRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [ sh:path atlas:targetRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [
    sh:path ( rdf:subject atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:inRelease ) ;
    sh:equals atlas:sourceRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:inRelease ) ;
    sh:equals atlas:targetRelease
  ] .

atlas:SourceAssignmentShape
  a sh:NodeShape ;
  sh:targetClass atlas:SourceAssignment ;
  sh:property [ sh:path rdf:subject ; sh:class atlas:SourceRecord ] ;
  sh:property [ sh:path rdf:object ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path atlas:targetRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [
    sh:path ( rdf:subject atlas:inSourceRelease ) ;
    sh:equals atlas:sourceRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:inRelease ) ;
    sh:equals atlas:targetRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] .

atlas:CrossRingRelationAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:CrossRingRelationAssertion ;
  sh:property [ sh:path rdf:subject ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path rdf:object ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path atlas:sourceRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [ sh:path atlas:targetRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [
    sh:path atlas:sourceRing ;
    sh:disjoint atlas:targetRing
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:semanticRing ) ;
    sh:equals atlas:sourceRing
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:semanticRing ) ;
    sh:equals atlas:targetRing
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:inRelease ) ;
    sh:equals atlas:sourceRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:inRelease ) ;
    sh:equals atlas:targetRelease
  ] .

# Rulespec owns decision-making, so the evidence node is rkaf:EvidenceBinding
# and its epistemic properties are rkaf's. What stays Atlas-owned is the pair
# of structural pointers below: Atlas addresses evidence at whole-source-record
# granularity, and an atlas:SourceRecord carries a locator and a digest but no
# selector or coordinate system, so rkaf:bindsSourceFragment would claim an
# addressability Atlas does not have. That gap is recorded on
# atlas:evidenceSourceRecord in the ontology rather than papered over here.
atlas:EvidenceBindingShape
  a sh:NodeShape ;
  sh:targetClass rkaf:EvidenceBinding ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path rkaf:bindsAssertion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:RelationAssertion
  ] ;
  sh:property [
    sh:path atlas:evidenceSourceRecord ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRecord
  ] ;
  sh:property [
    sh:path atlas:evidenceSourceDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path rkaf:attestor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  # #AttestorKind, all nine values. atlas:reviewedBy was a bare sh:nodeKind
  # sh:IRI with no way to say what kind of party the reviewer was, so a model
  # and a formal reviewer were indistinguishable on the wire.
  sh:property [
    sh:path rkaf:attestorKind ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:humanUser rkaf:aiModel rkaf:aiAgent rkaf:automatedParser rkaf:team
      rkaf:organization rkaf:community rkaf:formalReviewer
      rkaf:conceptMintingAuthority
    )
  ] ;
  # #AttestationDecision has seven values; Atlas publishes only approved
  # evidence, and this is the only place that invariant is stated. A pinned
  # value earns its keep here precisely because nothing else rejects a
  # published rkaf:rejected binding.
  sh:property [
    sh:path rkaf:decision ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue rkaf:approved
  ] ;
  sh:property [
    sh:path rkaf:attestedAt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime
  ] ;
  # The four axes atlas:reviewMethod used to conflate. Each is closed to its
  # upstream enum here; the sh:xone at the end of this shape closes the set of
  # admissible COMBINATIONS, which is what the six-value enum used to do.
  sh:property [
    sh:path rkaf:assertionOrigin ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:humanAsserted rkaf:aiSuggested rkaf:imported
      rkaf:deterministicExtraction
    )
  ] ;
  sh:property [
    sh:path rkaf:epistemicBasis ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:sourceExplicit rkaf:deterministicDerivation
      rkaf:statisticalInference rkaf:editorialAssertion rkaf:userAssertion
    )
  ] ;
  sh:property [
    sh:path rkaf:evidenceRole ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:textualEvidence rkaf:structuralEvidence rkaf:retrievalSignal
      rkaf:authorityCitation rkaf:officialSourceMetadata
      rkaf:reviewedAuthorityChain rkaf:formalAdoptionEvent
      rkaf:mappingRationale rkaf:registrationEvent rkaf:rescissionEvidence
    )
  ] ;
  sh:property [
    sh:path rkaf:evidentiaryFunction ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:supports rkaf:qualifies rkaf:contradicts rkaf:definesScope
      rkaf:providesContext
    )
  ] ;
  # atlas:adoptedEvidence was a hand-rolled subset of #LocalAdoption's
  # basedOnAttestation link. Atlas fuses the binding and its attestation into
  # one node, so the prior binding IS the prior attestation.
  sh:property [
    sh:path rkaf:basedOnAttestation ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class rkaf:EvidenceBinding
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  # The six former atlas:ReviewMethod individuals, restated as the six
  # admissible axis combinations. Exactly one branch must hold, so a producer
  # cannot assemble a combination no review method sanctioned -- which is the
  # closure the single enum used to provide. rkaf:basedOnAttestation is
  # PERMITTED by exactly one branch and forbidden by the other five, which is
  # what keeps operatorAdoption the only warrant that may name a prior
  # attestation. It is not REQUIRED there -- see that branch's comment for why
  # the atlas:adoptedEvidence biconditional this shape used to carry did not
  # survive contact with the only real adoption source Atlas has.
  sh:xone (
    [
      # publisherAssertion
      sh:property [ sh:path rkaf:epistemicBasis ; sh:hasValue rkaf:sourceExplicit ] ;
      sh:property [ sh:path rkaf:evidenceRole ; sh:hasValue rkaf:officialSourceMetadata ] ;
      sh:property [ sh:path rkaf:assertionOrigin ; sh:hasValue rkaf:imported ] ;
      sh:property [ sh:path rkaf:basedOnAttestation ; sh:maxCount 0 ]
    ]
    [
      # deterministicTransformation
      sh:property [ sh:path rkaf:epistemicBasis ; sh:hasValue rkaf:deterministicDerivation ] ;
      sh:property [ sh:path rkaf:evidenceRole ; sh:hasValue rkaf:structuralEvidence ] ;
      sh:property [ sh:path rkaf:assertionOrigin ; sh:hasValue rkaf:deterministicExtraction ] ;
      sh:property [ sh:path rkaf:basedOnAttestation ; sh:maxCount 0 ]
    ]
    [
      # humanReview
      sh:property [ sh:path rkaf:assertionOrigin ; sh:hasValue rkaf:humanAsserted ] ;
      sh:property [ sh:path rkaf:attestorKind ; sh:hasValue rkaf:humanUser ] ;
      sh:property [ sh:path rkaf:epistemicBasis ; sh:hasValue rkaf:editorialAssertion ] ;
      sh:property [ sh:path rkaf:evidenceRole ; sh:hasValue rkaf:textualEvidence ] ;
      sh:property [ sh:path rkaf:basedOnAttestation ; sh:maxCount 0 ]
    ]
    [
      # operatorAdoption -- the only branch that MAY name what it adopted.
      # rkaf:basedOnAttestation is optional here, deliberately. REF-016 records
      # this warrant for Atlas re-applying a pinned publisher claim to an
      # edition the publisher did not scope; when what was adopted is an
      # external publisher artifact, Atlas never minted a binding for it, so no
      # prior rkaf:EvidenceBinding exists to point at. The adoption still names
      # what it adopted -- by atlas:evidenceSourceRecord and its digest, the
      # whole-source-record granularity this shape's head comment states is the
      # only granularity Atlas can address. Requiring a finer, Atlas-internal
      # referent claimed an addressability Atlas does not have, and no real
      # build satisfied it on any day it stood. rkaf agrees: the field is
      # optional on #LocalAdoption, as it already is in this binding's own
      # compact JSON layer (validate.py COMPACT_RECORD_FIELDS).
      #
      # When a prior Atlas attestation DOES exist, this branch remains the only
      # sanctioned place to name it, and the chain must still resolve to a
      # non-adoption terminal without cycling -- see _check_evidence_bindings,
      # proved by invalid/adoption-without-referent and adoption-chain-cycle.
      # Exactly-one-branch is unaffected: rkaf:evidenceRole is minCount 1 /
      # maxCount 1 and every branch pins a distinct value, so evidenceRole
      # alone still resolves the sh:xone.
      sh:property [ sh:path rkaf:epistemicBasis ; sh:hasValue rkaf:editorialAssertion ] ;
      sh:property [ sh:path rkaf:evidenceRole ; sh:hasValue rkaf:formalAdoptionEvent ] ;
      sh:property [ sh:path rkaf:assertionOrigin ; sh:hasValue rkaf:imported ]
    ]
    [
      # twoMachineAdjudication
      sh:property [ sh:path rkaf:assertionOrigin ; sh:hasValue rkaf:aiSuggested ] ;
      sh:property [ sh:path rkaf:epistemicBasis ; sh:hasValue rkaf:statisticalInference ] ;
      sh:property [ sh:path rkaf:evidenceRole ; sh:hasValue rkaf:reviewedAuthorityChain ] ;
      sh:property [ sh:path rkaf:basedOnAttestation ; sh:maxCount 0 ]
    ]
    [
      # trustedPipelineReview -- a cryptographic warrant: these bytes are what
      # the digest says. Publishers should use a more specific combination when
      # one applies; that guidance came from the atlas:trustedPipelineReview
      # rdfs:comment and is preserved here because the term it annotated is gone.
      sh:property [ sh:path rkaf:epistemicBasis ; sh:hasValue rkaf:deterministicDerivation ] ;
      sh:property [ sh:path rkaf:evidenceRole ; sh:hasValue rkaf:authorityCitation ] ;
      sh:property [ sh:path rkaf:assertionOrigin ; sh:hasValue rkaf:imported ] ;
      sh:property [ sh:path rkaf:basedOnAttestation ; sh:maxCount 0 ]
    ]
  ) .

# Rulespec owns lifecycle, so the event node is rkaf:LifecycleEvent and its
# subject, kind, and date are rkaf's. atlas:eventType carried no rdfs:range at
# all and no sh:in, so a producer could name any IRI as an event kind and
# nothing rejected it; rkaf:lifecycleEventKind is closed here to the two
# kernel kinds Atlas can act on. rkaf:supersession and rkaf:rescission are the
# whole set on purpose: the other six #LifecycleEventKind values -- and every
# #ConceptLifecycleOperation -- describe transitions Atlas neither emits nor
# checks, and admitting a value nothing enforces is how atlas:eventType got
# into this state.
atlas:LifecycleEventShape
  a sh:NodeShape ;
  sh:targetClass rkaf:LifecycleEvent ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  # Narrowed from rkaf's list-valued rkaf:appliesTo: one Atlas event names one
  # assertion, and sh:class rejects an event pointed at a resource or a
  # release, which the bare sh:nodeKind sh:IRI on atlas:eventSubject did not.
  sh:property [
    sh:path rkaf:appliesTo ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:RelationAssertion
  ] ;
  # No sh:in here: the sh:xone below names both admissible kinds with
  # sh:hasValue, so it already closes the set. A separate sh:in could not be
  # violated on its own -- an unknown kind satisfies neither branch -- and a
  # constraint no fixture can isolate is a second copy of the value set, not a
  # check. This is unlike atlas:EvidenceBindingShape, where an axis sh:in IS
  # independently violable: no branch constrains rkaf:evidentiaryFunction and
  # only two of six constrain rkaf:attestorKind, so a value outside those enums
  # is rejected by the sh:in alone and by nothing else. The reachability is
  # partial, not uniform, and saying otherwise overstated it: every branch pins
  # rkaf:evidenceRole, so four of its ten enumerated values (retrievalSignal,
  # mappingRationale, registrationEvent, rescissionEvidence) satisfy no branch
  # and cannot appear on a conforming binding; rkaf:epistemicBasis has one such
  # value (userAssertion). Those enums are wider than the warrant table on
  # purpose -- they are rkaf's, restated whole rather than trimmed to Atlas's
  # current six warrants -- but the gap is a fact about this shape, not a claim
  # that every enumerated value is reachable.
  sh:property [
    sh:path rkaf:lifecycleEventKind ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [ sh:path rkaf:effectiveDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
  sh:property [ sh:path atlas:fromRelease ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class atlas:Release ] ;
  sh:property [ sh:path atlas:toRelease ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class atlas:Release ] ;
  sh:property [ sh:path atlas:sourceRecord ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class atlas:SourceRecord ] ;
  # Each kind names the release it moves the assertion across, and only that
  # one. A rescission leaves a release; a supersession admits the successor
  # into one. Without this a producer could emit either pointer on either kind
  # and nothing would notice.
  sh:xone (
    [
      sh:property [ sh:path rkaf:lifecycleEventKind ; sh:hasValue rkaf:rescission ] ;
      sh:property [ sh:path atlas:fromRelease ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:toRelease ; sh:maxCount 0 ]
    ]
    [
      sh:property [ sh:path rkaf:lifecycleEventKind ; sh:hasValue rkaf:supersession ] ;
      sh:property [ sh:path atlas:toRelease ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:fromRelease ; sh:maxCount 0 ]
    ]
  ) .

# Machine-adjudication proof records
#
# Rulespec owns the whole protocol, so all five node classes and every property
# below are rkaf's; Atlas mints nothing here. Each shape carries EVERY field its
# upstream definition requires -- constraints/analysis/resolver-proof-record.cue,
# machine-adjudication.cue, relation-comparison-context.cue, and
# constraints/core/{ai-lineage,artifact}.cue -- because these shapes are
# sh:closed and a closed shape that drops a required upstream field is
# nonconforming in both directions at once: it accepts records rulespec would
# reject, and it rejects the records rulespec requires. Adoption is the term AND
# the shape.
#
# Atlas narrows upstream in three places, which is the direction a binding
# profile is allowed to move -- every record Atlas accepts is one rulespec
# accepts:
#
#   * upstream-OPTIONAL fields Atlas requires: rkaf:proofInputDigest,
#     rkaf:hasContentDigest. Atlas resolves every named input to bundled bytes,
#     so a digest-free input is not admissible here.
#   * rkaf:proofType pinned to rkaf:machineAdjudicationProof. Six of
#     #ResolverProofType's seven members name resolver protocols Atlas does not
#     run, and a value Atlas would accept but never check is how atlas:eventType
#     got into the state that deleted it.
#   * rkaf:proofOutcome restricted to #GateStatus. #ResolverProofOutcome also
#     unions the six #ScopeRelation values, which are what a SCOPE COMPARATOR
#     returns; an adjudication of two concepts is a gate result. All three gate
#     values are admitted, which is the point -- see the outcome note below.
#
# THE OUTCOME VALUES ARE NOT PINNED, deliberately. An earlier revision pinned
# rkaf:proofOutcome to rkaf:gatePass and rkaf:comparisonOutcome to
# rkaf:comparisonSatisfied, which made "never adjudicated" and "adjudicated and
# refused" the same wire state -- the exact distinction
# relation-comparison-context.cue keeps five outcome values to preserve, so that
# an auditor can tell "checked, nothing found" from "never checked". Atlas now
# publishes refusals: a comparison MAY carry any of the five outcomes and a
# proof any of the three gate statuses. What stays strict is LICENSING, and that
# rule is cross-node: only an rkaf:comparisonSatisfied comparison whose cited
# proofs are all rkaf:gatePass can license a mapping, and only that comparison
# is held to the independence and lattice rules. tools/validate.py owns it.
#
# Everything here constrains ONE node. Five-axis independence, one sealed
# question per comparison, complete-support retention, the verdict lattice, the
# snapshot chain, and the resolution of every artifact and digest to bundled
# bytes all relate several records, so they live in tools/validate.py, exactly
# where rulespec puts its own equivalents (hand-authored SPARQL in
# shapes/rkaf-shapes-analysis.ttl) and for the same stated reason.

# rkaf:Artifact is what makes a digest resolvable. Atlas 1.0 required the
# candidate to name one atlas:inputContextArtifact whose atlas:contentDigest
# equalled the declared atlas:inputContextDigest, and said why: every other
# check compares the records to one another, so all of them can agree on a
# digest whose bytes exist nowhere. rkaf:Artifact is that record, upstream's own
# term for it (constraints/core/artifact.cue), and the machine-adjudication
# records reach bundled bytes through it four ways -- the two compared
# endpoints, the sealed request, and each sealed response.
atlas:ArtifactShape
  a sh:NodeShape ;
  sh:targetClass rkaf:Artifact ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path rkaf:hasArtifactIdentifier ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minLength 1
  ] ;
  # Closed upstream to thirteen schemes. Atlas admits only the one that
  # describes what it mints: an identifier the producer defined, in a namespace
  # no external registry governs. Admitting rkaf:doi or rkaf:eli here would let
  # a producer claim a citation identity Atlas never checks.
  sh:property [
    sh:path rkaf:artifactIdentifierScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( rkaf:partner-defined )
  ] ;
  # Upstream-optional, required here: an artifact with no content digest cannot
  # resolve a sealed request digest to bytes, which is this record's whole job
  # in the adjudication protocol.
  sh:property [
    sh:path rkaf:hasContentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] .

atlas:ResolverProofRecordShape
  a sh:NodeShape ;
  sh:targetClass rkaf:ResolverProofRecord ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path rkaf:proofType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue rkaf:machineAdjudicationProof
  ] ;
  # The validator-actor axis, and -- one hop on -- the provider axis. Class-
  # ranged so "issued under version 3" resolves to a record rather than to a
  # version string a reader must trust.
  sh:property [
    sh:path rkaf:proofIssuer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class rkaf:ResolverProofIssuer
  ] ;
  # Declaring the comparison is all one node can do; that the named comparison
  # is the one actually CITING this proof is checked in validate.py.
  sh:property [
    sh:path rkaf:proofComparisonContext ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class rkaf:RelationComparisonContext
  ] ;
  # All three #GateStatus values. A refusal (rkaf:gateFail) and an undecidable
  # question (rkaf:gateUnknown) are exactly where v1's dropped "unrelated" and
  # "insufficient_evidence" verdicts went, and a published refusal is an audit
  # record, not a defect -- it just licenses nothing.
  sh:property [
    sh:path rkaf:proofOutcome ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( rkaf:gatePass rkaf:gateFail rkaf:gateUnknown )
  ] ;
  # Required and non-empty upstream, and carried here for that reason: a
  # decision with no stated reason is not reviewable. It is NOT evidence. Atlas
  # 1.0 said the same thing about atlas:reason -- nothing ties the literal to
  # the sealed response it quotes -- and the answer is the sealed response
  # artifact, which this protocol now resolves to bundled bytes. A consumer
  # reads rkaf:proofRationale to see why, and rkaf:sealedResponseArtifact to
  # know what was actually returned.
  sh:property [
    sh:path rkaf:proofRationale ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minLength 1
  ] ;
  # Deliberately no sh:class, matching upstream, which ranges proofInput to
  # nothing: validate.py resolves each input to a bundled rkaf:Artifact so the
  # failure names the missing bytes rather than a missing rdf:type.
  sh:property [
    sh:path rkaf:proofInput ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rkaf:proofInputDigest ;
    sh:minCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path rkaf:proofEvaluatedAt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime
  ] ;
  # The immutable snapshot this proof read. validate.py binds it to the
  # comparison's own snapshot and that to the release the mapping targets, so a
  # proof run against an older release cannot license a mapping into a newer one.
  sh:property [
    sh:path rkaf:proofSnapshot ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:NonEmptyStringValueShape
  ] ;
  # rkaf's own name for the record-integrity digest every other Atlas carrier
  # spells atlas:contentDigest. The rkaf term wins on a proof record because
  # rkaf defines it there; the validator computes it with the one node-digest
  # algorithm the binding uses everywhere.
  sh:property [
    sh:path rkaf:proofRecordDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path rkaf:hasAILineage ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class rkaf:AILineage
  ] ;
  sh:property [
    sh:path rkaf:independenceGroup ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rkaf:adjudicationVerdict ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:verdictSame rkaf:verdictNearSame rkaf:verdictTargetBroader
      rkaf:verdictTargetNarrower rkaf:verdictRelated
    )
  ] ;
  sh:property [
    sh:path rkaf:sealedRequestDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  # sh:maxCount 1 is load-bearing, not tidiness: rulespec found a bypass in
  # which one proof carried a shared response artifact plus a decoy unique one,
  # and the pairwise-distinctness search bound the decoy and passed. One value
  # per proof is what makes artifact-IRI inequality mean run inequality.
  # Deliberately NOT sh:class here -- validate.py resolves it to a bundled
  # rkaf:Artifact so the failure names the missing bytes rather than a type.
  sh:property [
    sh:path rkaf:sealedResponseArtifact ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] .

atlas:ResolverProofIssuerShape
  a sh:NodeShape ;
  sh:targetClass rkaf:ResolverProofIssuer ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  # All four upstream fields. The provider axis is rkaf:proofResolver alone --
  # one hop coarser than the issuer IRI, which is the validator-actor axis --
  # and the version/policy pair is what makes two issuer records distinguishable
  # when the underlying resolver build is the same.
  sh:property [
    sh:path rkaf:proofResolver ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rkaf:proofResolverVersion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:NonEmptyStringValueShape
  ] ;
  sh:property [
    sh:path rkaf:proofPolicy ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rkaf:proofPolicyVersion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:NonEmptyStringValueShape
  ] .

atlas:AILineageShape
  a sh:NodeShape ;
  sh:targetClass rkaf:AILineage ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  # Every field #AILineage requires: which model, at which version, under which
  # prompt contract and sampling settings, over which input context. Upstream's
  # three optional fields (rkaf:seed, rkaf:humanApprover, rkaf:humanRationale)
  # are absent, which is what an optional field means -- and the conditional
  # they carry upstream, that a rationale without an approver is a review
  # attributed to nobody, cannot be violated by a record that has neither.
  sh:property [
    sh:path rkaf:modelId ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:NonEmptyStringValueShape
  ] ;
  sh:property [
    sh:path rkaf:modelVersion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:NonEmptyStringValueShape
  ] ;
  sh:property [
    sh:path rkaf:promptTemplateRef ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rkaf:temperature ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 2.0
  ] ;
  # "Over which input context" -- and in Atlas that context is the sealed
  # request, so validate.py requires this digest to equal the proof's
  # rkaf:sealedRequestDigest, which in turn resolves to a bundled artifact.
  sh:property [
    sh:path rkaf:inputContextHash ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] .

atlas:RelationComparisonContextShape
  a sh:NodeShape ;
  sh:targetClass rkaf:RelationComparisonContext ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  # The artifact pair, at exact versions. validate.py binds each one to an
  # endpoint of the assertion under comparison and to that endpoint's recorded
  # content digest, which is Atlas 1.0's input-context rule restated on rkaf's
  # records.
  sh:property [
    sh:path rkaf:comparisonBaselineArtifact ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class rkaf:Artifact
  ] ;
  sh:property [
    sh:path rkaf:comparisonObservedArtifact ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class rkaf:Artifact
  ] ;
  # The Atlas claim this comparison was run for. v1 pointed the other way,
  # from the mapping to its supports through atlas:qualifiedBy; rkaf already
  # owns this direction, so no atlas: link property is minted.
  sh:property [
    sh:path rkaf:comparisonExpectedAssertion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:RelationAssertion
  ] ;
  sh:property [
    sh:path rkaf:comparisonConsumer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rkaf:comparisonScope ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rkaf:comparisonEvaluationTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path rkaf:comparisonPolicyVersion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:NonEmptyStringValueShape
  ] ;
  sh:property [
    sh:path rkaf:comparisonDetector ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rkaf:comparisonDetectorVersion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:NonEmptyStringValueShape
  ] ;
  sh:property [
    sh:path rkaf:comparisonSnapshot ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:NonEmptyStringValueShape
  ] ;
  # All five #RelationComparisonOutcome values. Only rkaf:comparisonSatisfied
  # licenses a mapping; the other four are the audit record that says a
  # comparison was run and did not license one, which is the state a pinned
  # value made unrepresentable.
  sh:property [
    sh:path rkaf:comparisonOutcome ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:comparisonSatisfied rkaf:comparisonAffirmedDeniedDiscrepancy
      rkaf:comparisonConflict rkaf:comparisonNotComparable
      rkaf:comparisonUnknown
    )
  ] ;
  sh:property [
    sh:path rkaf:comparisonProofRecord ;
    sh:nodeKind sh:IRI ;
    sh:class rkaf:ResolverProofRecord
  ] ;
  # Upstream requires at least one proof record for every outcome except
  # rkaf:comparisonUnknown, which may be reached before any resolver could be
  # consulted. Restated as a disjunction rather than as a flat sh:minCount so a
  # published "nobody could decide" record stays representable. "At least one
  # independent PAIR" is not a cardinality -- two proofs from one provider are
  # still one opinion -- so the count that matters is in validate.py, where the
  # message can say which axis collapsed.
  sh:or (
    [
      sh:property [
        sh:path rkaf:comparisonOutcome ;
        sh:hasValue rkaf:comparisonUnknown
      ]
    ]
    [ sh:property [ sh:path rkaf:comparisonProofRecord ; sh:minCount 1 ] ]
  ) .

# Reproducible projection records

atlas:ProjectedRelationShape
  a sh:NodeShape ;
  sh:targetClass atlas:ProjectedRelation ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type rdfs:label ) ;
  sh:property [
    sh:path atlas:relationSubject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:relationPredicate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:relationObject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:targetRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:supportingAssertion ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:xone (
    [
      sh:property [ sh:path atlas:semanticRing ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:sourceRing ; sh:maxCount 0 ] ;
      sh:property [ sh:path atlas:targetRing ; sh:maxCount 0 ]
    ]
    [
      sh:property [ sh:path atlas:semanticRing ; sh:maxCount 0 ] ;
      sh:property [ sh:path atlas:sourceRing ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:targetRing ; sh:minCount 1 ]
    ]
  ) .

# Explicitly non-authoritative derived relation records

atlas:DerivedRelationShape
  a sh:NodeShape ;
  sh:targetClass atlas:DerivedRelation ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type rdfs:label ) ;
  sh:property [
    sh:path atlas:relationSubject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:relationPredicate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:relationObject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:derivedFromAssertion ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:derivationRule ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:engine ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:engineVersion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path rkaf:inputDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:generatedAt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime
  ] ;
  # No authority-status property. It was pinned here with
  # sh:hasValue atlas:nonAuthoritative, so it took one value in every
  # conforming dataset and told a consumer nothing the atlas:DerivedRelation
  # type and the derived graph do not already say. What still breaks when a
  # producer claims authority for a derived row is the graph-placement check
  # in validate.py, proved by derived-is-authoritative and derived-extra-type.
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] .
