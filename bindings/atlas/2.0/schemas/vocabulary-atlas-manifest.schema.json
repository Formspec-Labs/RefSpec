{
  "$id": "https://refspec.org/bindings/atlas/2.0/schemas/vocabulary-atlas-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonicalPayloadDigest": {
      "$ref": "#/$defs/digest"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "format": {
      "const": "refspec-vocabulary-atlas-nquads-2.0"
    },
    "generationDigest": {
      "$ref": "#/$defs/digest"
    },
    "graphs": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/releaseFactsGraph"
        },
        {
          "$ref": "#/$defs/crossReleaseGraph"
        }
      ],
      "type": "array"
    },
    "id": {
      "pattern": "^urn:ref:vocabulary-atlas:[0-9a-f]{64}$",
      "type": "string"
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "rings": {
      "items": false,
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/subjectRing"
        },
        {
          "$ref": "#/$defs/entityRing"
        },
        {
          "$ref": "#/$defs/valueRing"
        },
        {
          "$ref": "#/$defs/legalIdentityRing"
        }
      ],
      "type": "array"
    },
    "schemaVersion": {
      "const": "2.0"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "type": {
      "const": "urn:ref:type:VocabularyAtlasManifest"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "format",
    "generationDigest",
    "scope",
    "implementation",
    "policies",
    "graphs",
    "output",
    "counts",
    "rings",
    "canonicalPayloadDigest"
  ],
  "type": "object",
  "$defs": {
    "absoluteIri": {
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>]+$",
      "type": "string"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "conceptReleases": {
          "$ref": "#/$defs/positiveInteger"
        },
        "concepts": {
          "$ref": "#/$defs/positiveInteger"
        },
        "evidenceAssertions": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "machineProofs": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "mappingAssertions": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "relationBundles": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "releaseRecords": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "required": [
        "conceptReleases",
        "concepts",
        "releaseRecords",
        "relationBundles",
        "evidenceAssertions",
        "mappingAssertions",
        "machineProofs"
      ],
      "type": "object"
    },
    "crossReleaseGraph": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "quadCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "role": {
          "const": "crossRelease"
        }
      },
      "required": [
        "role",
        "id",
        "quadCount"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "entityRing": {
      "$ref": "#/$defs/ringSummary",
      "properties": {
        "semanticRing": {
          "const": "entity"
        }
      }
    },
    "implementation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "runtime": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        "sourceModules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "path",
              "digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sourceModules",
        "runtime"
      ],
      "type": "object"
    },
    "legalIdentityRing": {
      "$ref": "#/$defs/ringSummary",
      "properties": {
        "semanticRing": {
          "const": "legalIdentity"
        }
      }
    },
    "nonnegativeInteger": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/positiveInteger"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "const": "application/n-quads"
        },
        "path": {
          "const": "atlas.nq"
        },
        "quadCount": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "required": [
        "path",
        "mediaType",
        "digest",
        "byteLength",
        "quadCount"
      ],
      "type": "object"
    },
    "policies": {
      "additionalProperties": false,
      "properties": {
        "graphPartition": {
          "const": "releaseFactsAndCrossReleaseRecords"
        },
        "labelEquality": {
          "const": "discoveryOnly"
        },
        "permission": {
          "const": "externalProductPolicyOnly"
        },
        "recordEncoding": {
          "const": "canonicalRefJsonV1"
        },
        "recordIndexing": {
          "const": "derivedExactEqualityV1"
        }
      },
      "required": [
        "graphPartition",
        "recordEncoding",
        "recordIndexing",
        "labelEquality",
        "permission"
      ],
      "type": "object"
    },
    "positiveInteger": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "releaseFactsGraph": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "quadCount": {
          "$ref": "#/$defs/positiveInteger"
        },
        "role": {
          "const": "releaseFacts"
        }
      },
      "required": [
        "role",
        "id",
        "quadCount"
      ],
      "type": "object"
    },
    "ringSummary": {
      "additionalProperties": false,
      "properties": {
        "conceptCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "mappingAssertionCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "relationBundleCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "releaseCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "semanticRing": {
          "$ref": "#/$defs/semanticRing"
        }
      },
      "required": [
        "semanticRing",
        "releaseCount",
        "conceptCount",
        "relationBundleCount",
        "mappingAssertionCount"
      ],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/positiveInteger"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "id": {
          "pattern": "^urn:ref:vocabulary-atlas-scope:[0-9a-f]{64}$",
          "type": "string"
        },
        "mediaType": {
          "const": "application/vnd.refspec.vocabulary-atlas-scope+json"
        },
        "path": {
          "const": "atlas-scope.json"
        }
      },
      "required": [
        "path",
        "mediaType",
        "id",
        "contentDigest",
        "digest",
        "byteLength"
      ],
      "type": "object"
    },
    "semanticRing": {
      "enum": [
        "subject",
        "entity",
        "value",
        "legalIdentity"
      ]
    },
    "subjectRing": {
      "$ref": "#/$defs/ringSummary",
      "properties": {
        "semanticRing": {
          "const": "subject"
        }
      }
    },
    "valueRing": {
      "$ref": "#/$defs/ringSummary",
      "properties": {
        "semanticRing": {
          "const": "value"
        }
      }
    }
  }
}
