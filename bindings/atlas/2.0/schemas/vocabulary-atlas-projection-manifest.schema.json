{
  "$id": "https://refspec.org/bindings/atlas/2.0/schemas/vocabulary-atlas-projection-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "counts": {
            "properties": {
              "relationBundles": {
                "const": 0
              }
            },
            "required": [
              "relationBundles"
            ]
          }
        },
        "required": [
          "counts"
        ]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "evidenceAssertions": {
                "const": 0
              },
              "machineProofs": {
                "const": 0
              },
              "mappingAssertions": {
                "const": 0
              }
            }
          },
          "graphs": {
            "prefixItems": [
              {},
              {
                "properties": {
                  "quadCount": {
                    "const": 0
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "counts": {
            "properties": {
              "evidenceAssertions": {
                "$ref": "#/$defs/positiveInteger"
              },
              "mappingAssertions": {
                "$ref": "#/$defs/positiveInteger"
              }
            }
          },
          "graphs": {
            "prefixItems": [
              {},
              {
                "properties": {
                  "quadCount": {
                    "$ref": "#/$defs/positiveInteger"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "canonicalPayloadDigest": {
      "$ref": "#/$defs/digest"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "derivedFrom": {
      "$ref": "#/$defs/derivedFrom"
    },
    "format": {
      "const": "refspec-vocabulary-atlas-projection-nquads-2.0"
    },
    "graphs": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/releaseFactsGraph"
        },
        {
          "$ref": "#/$defs/crossReleaseGraph"
        }
      ],
      "type": "array"
    },
    "id": {
      "pattern": "^urn:ref:vocabulary-atlas-projection:[0-9a-f]{64}$",
      "type": "string"
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "projectionDigest": {
      "$ref": "#/$defs/digest"
    },
    "projectionPolicy": {
      "$ref": "#/$defs/projectionPolicy"
    },
    "rings": {
      "items": false,
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/subjectRing"
        },
        {
          "$ref": "#/$defs/entityRing"
        },
        {
          "$ref": "#/$defs/valueRing"
        },
        {
          "$ref": "#/$defs/legalIdentityRing"
        }
      ],
      "type": "array"
    },
    "schemaVersion": {
      "const": "2.0"
    },
    "type": {
      "const": "urn:ref:type:VocabularyAtlasProjectionManifest"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "format",
    "projectionDigest",
    "derivedFrom",
    "projectionPolicy",
    "implementation",
    "graphs",
    "output",
    "counts",
    "rings",
    "canonicalPayloadDigest"
  ],
  "type": "object",
  "$defs": {
    "absoluteIri": {
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>]+$",
      "type": "string"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "conceptReleases": {
          "$ref": "#/$defs/positiveInteger"
        },
        "concepts": {
          "$ref": "#/$defs/positiveInteger"
        },
        "evidenceAssertions": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "machineProofs": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "mappingAssertions": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "relationBundles": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "releaseRecords": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "required": [
        "conceptReleases",
        "concepts",
        "releaseRecords",
        "relationBundles",
        "evidenceAssertions",
        "mappingAssertions",
        "machineProofs"
      ],
      "type": "object"
    },
    "crossReleaseGraph": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^urn:ref:vocabulary-atlas-projection:[0-9a-f]{64}:cross-release$",
          "type": "string"
        },
        "quadCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "role": {
          "const": "crossRelease"
        }
      },
      "required": [
        "role",
        "id",
        "quadCount"
      ],
      "type": "object"
    },
    "derivedFrom": {
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "pattern": "^urn:ref:vocabulary-atlas:[0-9a-f]{64}$",
          "type": "string"
        },
        "distributionDigest": {
          "$ref": "#/$defs/digest"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "assetId",
        "manifestDigest",
        "distributionDigest"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "entityRing": {
      "$ref": "#/$defs/ringSummary",
      "properties": {
        "semanticRing": {
          "const": "entity"
        }
      }
    },
    "implementation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "runtime": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        "sourceModules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "path",
              "digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sourceModules",
        "runtime"
      ],
      "type": "object"
    },
    "legalIdentityRing": {
      "$ref": "#/$defs/ringSummary",
      "properties": {
        "semanticRing": {
          "const": "legalIdentity"
        }
      }
    },
    "modulePolicy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^urn:ref:policy:vocabulary-atlas-projection:module:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$",
          "type": "string"
        },
        "selectors": {
          "additionalProperties": false,
          "properties": {
            "sourceModule": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$",
              "type": "string"
            }
          },
          "required": [
            "sourceModule"
          ],
          "type": "object"
        },
        "version": {
          "const": "1"
        }
      },
      "required": [
        "id",
        "version",
        "selectors"
      ],
      "type": "object"
    },
    "nonnegativeInteger": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/positiveInteger"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "const": "application/n-quads"
        },
        "path": {
          "const": "atlas.nq"
        },
        "quadCount": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "required": [
        "path",
        "mediaType",
        "digest",
        "byteLength",
        "quadCount"
      ],
      "type": "object"
    },
    "positiveInteger": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "projectionPolicy": {
      "oneOf": [
        {
          "$ref": "#/$defs/subjectRingPolicy"
        },
        {
          "$ref": "#/$defs/entityRingPolicy"
        },
        {
          "$ref": "#/$defs/valueRingPolicy"
        },
        {
          "$ref": "#/$defs/legalIdentityRingPolicy"
        },
        {
          "$ref": "#/$defs/modulePolicy"
        }
      ]
    },
    "releaseFactsGraph": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^urn:ref:vocabulary-atlas-projection:[0-9a-f]{64}:release-facts$",
          "type": "string"
        },
        "quadCount": {
          "$ref": "#/$defs/positiveInteger"
        },
        "role": {
          "const": "releaseFacts"
        }
      },
      "required": [
        "role",
        "id",
        "quadCount"
      ],
      "type": "object"
    },
    "ringPolicyBase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "selectors": {
          "type": "object"
        },
        "version": {
          "const": "1"
        }
      },
      "required": [
        "id",
        "version",
        "selectors"
      ],
      "type": "object"
    },
    "subjectRingPolicy": {
      "$ref": "#/$defs/ringPolicyBase",
      "properties": {
        "id": {
          "const": "urn:ref:policy:vocabulary-atlas-projection:ring:subject"
        },
        "selectors": {
          "additionalProperties": false,
          "properties": {
            "semanticRing": {
              "const": "subject"
            }
          },
          "required": [
            "semanticRing"
          ],
          "type": "object"
        }
      }
    },
    "entityRingPolicy": {
      "$ref": "#/$defs/ringPolicyBase",
      "properties": {
        "id": {
          "const": "urn:ref:policy:vocabulary-atlas-projection:ring:entity"
        },
        "selectors": {
          "additionalProperties": false,
          "properties": {
            "semanticRing": {
              "const": "entity"
            }
          },
          "required": [
            "semanticRing"
          ],
          "type": "object"
        }
      }
    },
    "valueRingPolicy": {
      "$ref": "#/$defs/ringPolicyBase",
      "properties": {
        "id": {
          "const": "urn:ref:policy:vocabulary-atlas-projection:ring:value"
        },
        "selectors": {
          "additionalProperties": false,
          "properties": {
            "semanticRing": {
              "const": "value"
            }
          },
          "required": [
            "semanticRing"
          ],
          "type": "object"
        }
      }
    },
    "legalIdentityRingPolicy": {
      "$ref": "#/$defs/ringPolicyBase",
      "properties": {
        "id": {
          "const": "urn:ref:policy:vocabulary-atlas-projection:ring:legalIdentity"
        },
        "selectors": {
          "additionalProperties": false,
          "properties": {
            "semanticRing": {
              "const": "legalIdentity"
            }
          },
          "required": [
            "semanticRing"
          ],
          "type": "object"
        }
      }
    },
    "ringSummary": {
      "additionalProperties": false,
      "properties": {
        "conceptCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "mappingAssertionCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "relationBundleCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "releaseCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "semanticRing": {
          "enum": [
            "subject",
            "entity",
            "value",
            "legalIdentity"
          ]
        }
      },
      "required": [
        "semanticRing",
        "releaseCount",
        "conceptCount",
        "relationBundleCount",
        "mappingAssertionCount"
      ],
      "type": "object"
    },
    "subjectRing": {
      "$ref": "#/$defs/ringSummary",
      "properties": {
        "semanticRing": {
          "const": "subject"
        }
      }
    },
    "valueRing": {
      "$ref": "#/$defs/ringSummary",
      "properties": {
        "semanticRing": {
          "const": "value"
        }
      }
    }
  }
}
