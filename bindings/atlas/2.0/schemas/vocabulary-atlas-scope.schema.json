{
  "$id": "https://refspec.org/bindings/atlas/2.0/schemas/vocabulary-atlas-scope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atlasIndex": {
      "$ref": "#/$defs/atlasIndex"
    },
    "contentDigest": {
      "$ref": "#/$defs/digest"
    },
    "id": {
      "pattern": "^urn:ref:vocabulary-atlas-scope:[0-9a-f]{64}$",
      "type": "string"
    },
    "relationBundles": {
      "items": {
        "$ref": "#/$defs/relationBundlePin"
      },
      "type": "array",
      "uniqueItems": true
    },
    "releases": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/sourceConceptReleasePin"
          },
          {
            "$ref": "#/$defs/managedReferenceReleasePin"
          }
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "scopeKind": {
      "enum": [
        "bench",
        "published",
        "product"
      ]
    },
    "scopeName": {
      "$ref": "#/$defs/absoluteIri"
    },
    "type": {
      "const": "VocabularyAtlasScope"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "scopeName",
    "scopeKind",
    "atlasIndex",
    "releases",
    "relationBundles",
    "contentDigest"
  ],
  "type": "object",
  "$defs": {
    "absoluteIri": {
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>]+$",
      "type": "string"
    },
    "atlasIndex": {
      "additionalProperties": false,
      "properties": {
        "fileDigest": {
          "$ref": "#/$defs/digest"
        },
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "indexDigest": {
          "$ref": "#/$defs/digest"
        },
        "role": {
          "const": "AtlasIndex"
        }
      },
      "required": [
        "role",
        "id",
        "indexDigest",
        "fileDigest"
      ],
      "type": "object"
    },
    "atlasIndexRow": {
      "additionalProperties": false,
      "properties": {
        "rowDigest": {
          "$ref": "#/$defs/digest"
        },
        "rowId": {
          "$ref": "#/$defs/absoluteIri"
        }
      },
      "required": [
        "rowId",
        "rowDigest"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "managedReferenceReleasePin": {
      "additionalProperties": false,
      "properties": {
        "atlasIndexRows": {
          "$ref": "#/$defs/nonemptyAtlasIndexRows"
        },
        "declaredReleaseDigest": {
          "$ref": "#/$defs/digest"
        },
        "managedBundleReleaseId": {
          "$ref": "#/$defs/absoluteIri"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "releaseId": {
          "$ref": "#/$defs/absoluteIri"
        },
        "releaseKind": {
          "const": "managedReferenceRelease"
        },
        "ringAssignment": {
          "$ref": "#/$defs/ringAssignment"
        },
        "rulespecGraph": {
          "$ref": "#/$defs/rulespecGraph"
        },
        "semanticRing": {
          "$ref": "#/$defs/semanticRing"
        }
      },
      "required": [
        "releaseKind",
        "semanticRing",
        "releaseId",
        "manifestDigest",
        "managedBundleReleaseId",
        "ringAssignment",
        "rulespecGraph",
        "declaredReleaseDigest",
        "atlasIndexRows"
      ],
      "type": "object"
    },
    "nonemptyAtlasIndexRows": {
      "items": {
        "$ref": "#/$defs/atlasIndexRow"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "relationBundlePin": {
      "additionalProperties": false,
      "properties": {
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "role": {
          "const": "RelationAssertionBundle"
        },
        "semanticRing": {
          "$ref": "#/$defs/semanticRing"
        }
      },
      "required": [
        "role",
        "id",
        "semanticRing",
        "contentDigest",
        "manifestDigest"
      ],
      "type": "object"
    },
    "ringAssignment": {
      "additionalProperties": false,
      "properties": {
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "fileDigest": {
          "$ref": "#/$defs/digest"
        },
        "id": {
          "$ref": "#/$defs/absoluteIri"
        }
      },
      "required": [
        "id",
        "contentDigest",
        "fileDigest"
      ],
      "type": "object"
    },
    "rulespecGraph": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "id": {
          "$ref": "#/$defs/absoluteIri"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object"
    },
    "semanticRing": {
      "enum": [
        "subject",
        "entity",
        "value",
        "legalIdentity"
      ]
    },
    "sourceConceptReleasePin": {
      "additionalProperties": false,
      "properties": {
        "atlasIndexRows": {
          "$ref": "#/$defs/nonemptyAtlasIndexRows"
        },
        "logicalDigest": {
          "$ref": "#/$defs/digest"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "releaseDigest": {
          "$ref": "#/$defs/digest"
        },
        "releaseId": {
          "$ref": "#/$defs/absoluteIri"
        },
        "releaseKind": {
          "const": "sourceConceptRelease"
        },
        "semanticRing": {
          "$ref": "#/$defs/semanticRing"
        }
      },
      "required": [
        "releaseKind",
        "semanticRing",
        "releaseId",
        "manifestDigest",
        "releaseDigest",
        "logicalDigest",
        "atlasIndexRows"
      ],
      "type": "object"
    }
  }
}
