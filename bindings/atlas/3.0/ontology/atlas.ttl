@prefix atlas:  <https://refspec.org/ns/atlas/v3#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rkaf:   <https://rulespec.org/ns/v1#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<https://refspec.org/ns/atlas/v3>
  a owl:Ontology ;
  rdfs:label "RefSpec Atlas vocabulary 3.0"@en ;
  rdfs:comment "Authority-first vocabulary for immutable reference-resource releases, evidence-bearing assertions, reproducible projections, and explicitly non-authoritative derivations."@en ;
  owl:versionInfo "3.0" .

# Classes

atlas:SemanticRing
  a owl:Class ;
  rdfs:label "semantic ring"@en .

atlas:ResourceProfile
  a owl:Class ;
  rdfs:label "resource profile"@en .

# atlas:AssertionStatus and its three individuals are gone, and so is
# atlas:assertionStatus. Rulespec models a status change as an event, not as a
# field on the record it changes: #LifecycleEventKind carries rkaf:supersession
# and rkaf:rescission. Atlas now says the same thing with rkaf:LifecycleEvent,
# so "superseded" is read off the rkaf:supersedesAssertion edge that already
# had to exist and "withdrawn" is read off a rescission event. A stored status
# could only ever agree or disagree with those two facts, and the validator's
# only use for it was checking that it agreed.

# atlas:AuthorityStatus, atlas:authoritative, atlas:nonAuthoritative and
# atlas:authorityStatus are gone. The only shape that used the property pinned
# it with sh:hasValue atlas:nonAuthoritative, so every conforming dataset
# carried the same value and the property could not distinguish two datasets:
# it restated what atlas:DerivedRelation and the derived graph already say.
# atlas:authoritative was never emitted at all. Rulespec's #AuthorityKind and
# #AuthorityChainStatus were deliberately NOT adopted in its place -- Atlas has
# no authority values to record, and adopting them would mint the information
# this deletion removes.

# Editorial decision status and review method were Atlas classes. Both are
# decision-making vocabulary, which Rulespec owns: a decision is now
# rkaf:decision over rkaf's #AttestationDecision, and the single review-method
# enum is decomposed into the orthogonal rkaf axes it used to conflate. See
# the EvidenceBinding shapes in shapes/atlas.shacl.ttl.

atlas:Release
  a owl:Class ;
  rdfs:label "release"@en .

atlas:AtlasRelease
  a owl:Class ;
  rdfs:subClassOf atlas:Release ;
  rdfs:label "Atlas release"@en .

atlas:SourceRelease
  a owl:Class ;
  rdfs:subClassOf atlas:Release ;
  rdfs:label "source release"@en .

atlas:ResourceScheme
  a owl:Class ;
  rdfs:label "resource scheme"@en .

atlas:RegistrySource
  a owl:Class ;
  rdfs:label "registry source"@en ;
  rdfs:comment "Cataloged publisher or reference source from which one or more governed resource schemes may be emitted."@en .

atlas:AtlasResource
  a owl:Class ;
  rdfs:label "Atlas resource"@en .

atlas:SubjectConcept
  a owl:Class ;
  rdfs:subClassOf atlas:AtlasResource, skos:Concept ;
  rdfs:label "subject concept"@en .

atlas:EntityResource
  a owl:Class ;
  rdfs:subClassOf atlas:AtlasResource ;
  rdfs:label "entity resource"@en .

atlas:ValueResource
  a owl:Class ;
  rdfs:subClassOf atlas:AtlasResource ;
  rdfs:label "value resource"@en .

atlas:LegalIdentityResource
  a owl:Class ;
  rdfs:subClassOf atlas:AtlasResource ;
  rdfs:label "legal identity resource"@en .

atlas:Identifier
  a owl:Class ;
  rdfs:label "identifier"@en .

atlas:SourceRecord
  a owl:Class ;
  rdfs:label "source record"@en .

atlas:EditorialPolicy
  a owl:Class ;
  rdfs:label "editorial policy"@en .

# The lifecycle-event class is rkaf:LifecycleEvent. Its event kind, effective
# date, and subject are rkaf's too; see atlas:LifecycleEventShape in
# shapes/atlas.shacl.ttl, which closes the kind to the two kernel kinds Atlas
# can justify. Only the two release pointers below stay Atlas-owned, because a
# release is structure RefSpec owns.

atlas:RelationAssertion
  a owl:Class ;
  rdfs:label "relation assertion"@en .

atlas:MappingAssertion
  a owl:Class ;
  rdfs:subClassOf atlas:RelationAssertion ;
  rdfs:label "mapping assertion"@en .

atlas:SkosMappingAssertion
  a owl:Class ;
  rdfs:subClassOf atlas:MappingAssertion ;
  rdfs:label "SKOS mapping assertion"@en ;
  rdfs:comment "Subject-ring mapping assertion constrained to one of SKOS's five concrete mapping predicates."@en .

atlas:NativeRelationAssertion
  a owl:Class ;
  rdfs:subClassOf atlas:RelationAssertion ;
  rdfs:label "native relation assertion"@en .

atlas:SourceAssignment
  a owl:Class ;
  rdfs:subClassOf atlas:RelationAssertion ;
  rdfs:label "source assignment"@en .

atlas:CrossRingRelationAssertion
  a owl:Class ;
  rdfs:subClassOf atlas:RelationAssertion ;
  rdfs:label "cross-ring relation assertion"@en ;
  rdfs:comment "Evidence-bearing relation whose source and target resources belong to different, explicitly named semantic rings."@en .

atlas:ProjectedRelation
  a owl:Class ;
  rdfs:label "projected relation"@en .

atlas:DerivedRelation
  a owl:Class ;
  rdfs:label "derived relation"@en .

# The four semantic resource types are mutually exclusive. Identifier is a
# separate record and is deliberately not a fifth AtlasResource subtype.

atlas:SubjectConcept
  owl:disjointWith atlas:EntityResource,
    atlas:ValueResource,
    atlas:LegalIdentityResource .

atlas:EntityResource
  owl:disjointWith atlas:ValueResource,
    atlas:LegalIdentityResource .

atlas:ValueResource
  owl:disjointWith atlas:LegalIdentityResource .

atlas:AtlasResource
  owl:disjointWith atlas:Identifier,
    atlas:RegistrySource,
    atlas:SourceRecord,
    rkaf:EvidenceBinding,
    atlas:EditorialPolicy,
    atlas:RelationAssertion,
    atlas:ProjectedRelation,
    atlas:DerivedRelation,
    skosxl:Label .

atlas:Identifier
  owl:disjointWith atlas:RegistrySource,
    atlas:SourceRecord,
    rkaf:EvidenceBinding,
    atlas:EditorialPolicy,
    atlas:RelationAssertion,
    atlas:ProjectedRelation,
    atlas:DerivedRelation,
    skosxl:Label .

atlas:SourceRecord
  owl:disjointWith rkaf:EvidenceBinding,
    atlas:EditorialPolicy,
    atlas:RelationAssertion,
    atlas:ProjectedRelation,
    atlas:DerivedRelation,
    skosxl:Label .

atlas:RegistrySource
  owl:disjointWith atlas:ResourceScheme,
    atlas:SourceRecord,
    rkaf:EvidenceBinding,
    atlas:EditorialPolicy,
    atlas:RelationAssertion,
    atlas:ProjectedRelation,
    atlas:DerivedRelation,
    skosxl:Label .

atlas:RelationAssertion
  owl:disjointWith atlas:ProjectedRelation,
    atlas:DerivedRelation .

atlas:MappingAssertion
  owl:disjointWith atlas:NativeRelationAssertion,
    atlas:SourceAssignment,
    atlas:CrossRingRelationAssertion .

atlas:NativeRelationAssertion
  owl:disjointWith atlas:SourceAssignment,
    atlas:CrossRingRelationAssertion .

atlas:SourceAssignment
  owl:disjointWith atlas:CrossRingRelationAssertion .

atlas:ProjectedRelation
  owl:disjointWith atlas:DerivedRelation .

# Controlled vocabulary individuals

atlas:subject a atlas:SemanticRing ; rdfs:label "subject"@en .
atlas:entity a atlas:SemanticRing ; rdfs:label "entity"@en .
atlas:value a atlas:SemanticRing ; rdfs:label "value"@en .
atlas:legalIdentity a atlas:SemanticRing ; rdfs:label "legal identity"@en .

atlas:conceptScheme a atlas:ResourceProfile ; rdfs:label "concept scheme"@en .
atlas:codeScheme a atlas:ResourceProfile ; rdfs:label "code scheme"@en .
atlas:identifierScheme a atlas:ResourceProfile ; rdfs:label "identifier scheme"@en .
atlas:structureScheme a atlas:ResourceProfile ; rdfs:label "structure scheme"@en .
atlas:resourceCollection a atlas:ResourceProfile ; rdfs:label "resource collection"@en .

# The six atlas:ReviewMethod individuals conflated four independent Rulespec
# axes into one enum, so a consumer could not tell WHAT constructed a record
# (rkaf:assertionOrigin) from WHY it may be believed (rkaf:epistemicBasis),
# from what KIND of evidence backs it (rkaf:evidenceRole), from HOW that
# evidence bears on the claim (rkaf:evidentiaryFunction). Rulespec keeps the
# four apart deliberately -- the comment on #EvidenceRole says the split
# "prevents a consumer from treating retrieval evidence as authority evidence
# merely because both point at the same fragment". The six former values are
# now the six admissible axis combinations, enforced by the sh:xone on
# atlas:EvidenceBindingShape, which is what keeps the set closed.
#
#   publisherAssertion          sourceExplicit + officialSourceMetadata
#   deterministicTransformation deterministicDerivation + structuralEvidence
#   humanReview                 humanAsserted + humanUser attestor
#   operatorAdoption            editorialAssertion + formalAdoptionEvent,
#                               and rkaf:basedOnAttestation names what it adopted
#   twoMachineAdjudication      aiSuggested + reviewedAuthorityChain
#   trustedPipelineReview       deterministicDerivation + authorityCitation

# Shared object properties

atlas:inRelease
  a owl:ObjectProperty ;
  rdfs:range atlas:AtlasRelease ;
  rdfs:label "in release"@en .

atlas:inSourceRelease
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:SourceRelease ;
  rdfs:label "in source release"@en .

atlas:inScheme
  a owl:ObjectProperty ;
  rdfs:range atlas:ResourceScheme ;
  rdfs:label "in scheme"@en .

atlas:semanticRing
  a owl:ObjectProperty ;
  rdfs:range atlas:SemanticRing ;
  rdfs:label "semantic ring"@en .

atlas:sourceRing
  a owl:ObjectProperty ;
  rdfs:range atlas:SemanticRing ;
  rdfs:label "source ring"@en ;
  rdfs:comment "Semantic ring of the source endpoint of a cross-ring assertion or projected relation."@en .

atlas:targetRing
  a owl:ObjectProperty ;
  rdfs:range atlas:SemanticRing ;
  rdfs:label "target ring"@en ;
  rdfs:comment "Semantic ring of the target endpoint of a cross-ring assertion or projected relation."@en .

atlas:supportedRing
  a owl:ObjectProperty ;
  rdfs:domain atlas:ResourceScheme ;
  rdfs:range atlas:SemanticRing ;
  rdfs:label "supported ring"@en .

atlas:resourceProfile
  a owl:ObjectProperty ;
  rdfs:range atlas:ResourceProfile ;
  rdfs:label "resource profile"@en .

atlas:sourceRecord
  a owl:ObjectProperty ;
  rdfs:range atlas:SourceRecord ;
  rdfs:label "source record"@en .

atlas:representsResource
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:AtlasResource ;
  rdfs:label "represents resource"@en .

atlas:collectionMember
  a owl:ObjectProperty ;
  rdfs:domain atlas:ResourceScheme ;
  rdfs:range atlas:ResourceScheme ;
  rdfs:label "collection member"@en .

atlas:sourceDescriptor
  a owl:ObjectProperty ;
  rdfs:domain atlas:ResourceScheme ;
  rdfs:range atlas:RegistrySource ;
  rdfs:label "source descriptor"@en ;
  rdfs:comment "Cataloged source that defines or supplies this governed resource scheme."@en .

atlas:sourceLocator
  a owl:ObjectProperty ;
  rdfs:label "source locator"@en .

atlas:identifierScheme
  a owl:ObjectProperty ;
  rdfs:domain atlas:Identifier ;
  rdfs:range atlas:ResourceScheme ;
  rdfs:label "identifier scheme"@en .

atlas:identifies
  a owl:ObjectProperty ;
  rdfs:domain atlas:Identifier ;
  rdfs:range atlas:AtlasResource ;
  rdfs:label "identifies"@en .

# Assertion and evidence properties

atlas:sourceRelease
  a owl:ObjectProperty ;
  rdfs:domain atlas:RelationAssertion ;
  rdfs:range atlas:Release ;
  rdfs:label "source release"@en .

atlas:targetRelease
  a owl:ObjectProperty ;
  rdfs:domain atlas:RelationAssertion ;
  rdfs:range atlas:Release ;
  rdfs:label "target release"@en .

atlas:governedByPolicy
  a owl:ObjectProperty ;
  rdfs:domain atlas:RelationAssertion ;
  rdfs:range atlas:EditorialPolicy ;
  rdfs:label "governed by policy"@en .

atlas:evidenceSourceRecord
  a owl:ObjectProperty ;
  rdfs:domain rkaf:EvidenceBinding ;
  rdfs:range atlas:SourceRecord ;
  rdfs:label "evidence source record"@en ;
  rdfs:comment "Atlas addresses evidence at whole-source-record granularity. rkaf:bindsSourceFragment is deliberately not used: an Atlas source record carries a locator and a digest but no selector or coordinate system, so calling it an rkaf:SourceFragment would claim an addressability Atlas does not have."@en .

atlas:relationSubject
  a owl:ObjectProperty ;
  rdfs:label "relation subject"@en .

atlas:relationPredicate
  a owl:ObjectProperty ;
  rdfs:label "relation predicate"@en .

atlas:relationObject
  a owl:ObjectProperty ;
  rdfs:label "relation object"@en .

atlas:fromRelease
  a owl:ObjectProperty ;
  rdfs:domain rkaf:LifecycleEvent ;
  rdfs:range atlas:Release ;
  rdfs:label "from release"@en ;
  rdfs:comment "Release a rescinded assertion is withdrawn from. Rulespec's kernel lifecycle event has no release pointer outside its concept-lifecycle branch, and an Atlas release is structure RefSpec owns, so this pointer stays atlas:."@en .

atlas:toRelease
  a owl:ObjectProperty ;
  rdfs:domain rkaf:LifecycleEvent ;
  rdfs:range atlas:Release ;
  rdfs:label "to release"@en ;
  rdfs:comment "Release a superseding assertion is admitted into. Atlas-owned for the same reason as atlas:fromRelease."@en .

# Projection and derivation properties

atlas:supportingAssertion
  a owl:ObjectProperty ;
  rdfs:domain atlas:ProjectedRelation ;
  rdfs:label "supporting assertion"@en ;
  rdfs:comment "Cross-graph assertion reference. Its target type is checked by the dataset validator rather than inferred into the projection graph."@en .

atlas:derivedFromAssertion
  a owl:ObjectProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:label "derived from assertion"@en ;
  rdfs:comment "Cross-graph assertion reference. Its target type is checked by the dataset validator rather than inferred into the derived graph."@en .

atlas:derivationRule
  a owl:ObjectProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:label "derivation rule"@en .

atlas:engine
  a owl:ObjectProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:label "engine"@en .

# Datatype properties

atlas:sourceDigest
  a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:label "source digest"@en .

atlas:evidenceSourceDigest
  a owl:DatatypeProperty ;
  rdfs:domain rkaf:EvidenceBinding ;
  rdfs:range xsd:string ;
  rdfs:label "evidence source digest"@en ;
  rdfs:comment "Pins the exact contentDigest of the SourceRecord named by an evidence binding."@en .

atlas:policyPayload
  a owl:DatatypeProperty ;
  rdfs:domain atlas:EditorialPolicy ;
  rdfs:range rdfs:Literal ;
  rdfs:label "policy payload"@en .

atlas:assertionIdentityDigest
  a owl:DatatypeProperty ;
  rdfs:domain atlas:RelationAssertion ;
  rdfs:range xsd:string ;
  rdfs:label "assertion identity digest"@en .

atlas:nativePayload
  a owl:DatatypeProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range rdfs:Literal ;
  rdfs:label "native payload"@en .

atlas:descriptorPayload
  a owl:DatatypeProperty ;
  rdfs:range rdfs:Literal ;
  rdfs:label "descriptor payload"@en ;
  rdfs:comment "Source or scheme catalog metadata retained as canonical JSON."@en .

atlas:memberDisposition
  a owl:DatatypeProperty ;
  rdfs:domain atlas:RegistrySource ;
  rdfs:range xsd:string ;
  rdfs:label "member disposition"@en ;
  rdfs:comment "How Atlas represents, defers, or declines member data from this cataloged source, including sources represented only by mapping assertions."@en .

atlas:notation
  a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:label "notation"@en .

atlas:definition
  a owl:DatatypeProperty ;
  rdfs:range rdfs:Literal ;
  rdfs:label "definition"@en .

atlas:note
  a owl:DatatypeProperty ;
  rdfs:range rdfs:Literal ;
  rdfs:label "note"@en .

atlas:recordStatus
  a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:label "record status"@en .

atlas:validationRule
  a owl:DatatypeProperty ;
  rdfs:domain atlas:ResourceScheme ;
  rdfs:range xsd:string ;
  rdfs:label "validation rule"@en .

atlas:componentPosition
  a owl:DatatypeProperty ;
  rdfs:domain atlas:AtlasResource ;
  rdfs:range xsd:integer ;
  rdfs:label "component position"@en .

atlas:validFrom
  a owl:DatatypeProperty ;
  rdfs:range xsd:dateTime ;
  rdfs:label "valid from"@en .

atlas:validUntil
  a owl:DatatypeProperty ;
  rdfs:range xsd:dateTime ;
  rdfs:label "valid until"@en .

atlas:identifierValue
  a owl:DatatypeProperty ;
  rdfs:domain atlas:Identifier ;
  rdfs:range xsd:string ;
  rdfs:label "identifier value"@en .

atlas:engineVersion
  a owl:DatatypeProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:range xsd:string ;
  rdfs:label "engine version"@en .

atlas:generatedAt
  a owl:DatatypeProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:range xsd:dateTime ;
  rdfs:label "generated at"@en .

atlas:contentDigest
  a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:label "content digest"@en .

# Atlas-native predicates. These are intentionally ordinary object properties:
# the baseline does not declare any of them symmetric, transitive, inverse, or
# functional.

atlas:thesaurusUse
  a owl:ObjectProperty ;
  rdfs:domain atlas:SubjectConcept ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "thesaurus USE"@en ;
  rdfs:comment "Publisher-authored non-preferred-term pointer preserved without treating it as a SKOS semantic relation."@en .

atlas:thesaurusUsedFor
  a owl:ObjectProperty ;
  rdfs:domain atlas:SubjectConcept ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "thesaurus used for"@en ;
  rdfs:comment "Publisher-authored preferred-to-non-preferred-term pointer preserved without declaring inverse or label semantics."@en .

atlas:thesaurusRelated
  a owl:ObjectProperty ;
  rdfs:domain atlas:SubjectConcept ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "thesaurus related"@en ;
  rdfs:comment "Publisher-authored associative link retained when projecting it as skos:related would violate a SKOS integrity condition."@en .

atlas:sameEntityAs
  a owl:ObjectProperty ;
  rdfs:domain atlas:EntityResource ;
  rdfs:range atlas:EntityResource ;
  rdfs:label "same entity as"@en .

atlas:parentEntity
  a owl:ObjectProperty ;
  rdfs:domain atlas:EntityResource ;
  rdfs:range atlas:EntityResource ;
  rdfs:label "parent entity"@en .

atlas:relatedEntity
  a owl:ObjectProperty ;
  rdfs:domain atlas:EntityResource ;
  rdfs:range atlas:EntityResource ;
  rdfs:label "related entity"@en .

atlas:equivalentValue
  a owl:ObjectProperty ;
  rdfs:domain atlas:ValueResource ;
  rdfs:range atlas:ValueResource ;
  rdfs:label "equivalent value"@en .

atlas:broaderValue
  a owl:ObjectProperty ;
  rdfs:domain atlas:ValueResource ;
  rdfs:range atlas:ValueResource ;
  rdfs:label "broader value"@en .

atlas:replacementValue
  a owl:ObjectProperty ;
  rdfs:domain atlas:ValueResource ;
  rdfs:range atlas:ValueResource ;
  rdfs:label "replacement value"@en .

atlas:sameLegalIdentityAs
  a owl:ObjectProperty ;
  rdfs:domain atlas:LegalIdentityResource ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "same legal identity as"@en .

atlas:versionOf
  a owl:ObjectProperty ;
  rdfs:domain atlas:LegalIdentityResource ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "version of"@en .

atlas:relatedLegalIdentity
  a owl:ObjectProperty ;
  rdfs:domain atlas:LegalIdentityResource ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "related legal identity"@en .

atlas:hasIndexedSubject
  a owl:ObjectProperty ;
  rdfs:domain atlas:AtlasResource ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "has indexed subject"@en ;
  rdfs:comment "Reviewed indexing relation from an entity or legal-identity resource to a subject concept; the closed cross-ring policy determines admissible source rings."@en .

atlas:referencesLegalIdentity
  a owl:ObjectProperty ;
  rdfs:domain atlas:EntityResource ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "references legal identity"@en ;
  rdfs:comment "Reviewed relation from an entity resource to a legal-identity resource that it references."@en .

atlas:assignedSubject
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "assigned subject"@en .

atlas:assignedEntity
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:EntityResource ;
  rdfs:label "assigned entity"@en .

atlas:assignedValue
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:ValueResource ;
  rdfs:label "assigned value"@en .

atlas:assignedLegalIdentity
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "assigned legal identity"@en .
