@prefix atlas:  <https://refspec.org/ns/atlas/v3#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rkaf:   <https://rulespec.org/ns/v1#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<https://refspec.org/ns/atlas/v3>
  a owl:Ontology ;
  rdfs:label "RefSpec Atlas vocabulary 3.0"@en ;
  rdfs:comment "Authority-first vocabulary for immutable reference-resource releases, evidence-bearing assertions, reproducible projections, and explicitly non-authoritative derivations."@en ;
  owl:versionInfo "3.0" .

# Classes

atlas:SemanticRing
  a owl:Class ;
  rdfs:label "semantic ring"@en .

atlas:ResourceProfile
  a owl:Class ;
  rdfs:label "resource profile"@en .

# atlas:AssertionStatus and its three individuals are gone, and so is
# atlas:assertionStatus. Rulespec models a status change as an event, not as a
# field on the record it changes: #LifecycleEventKind carries rkaf:supersession
# and rkaf:rescission. Atlas now says the same thing with rkaf:LifecycleEvent,
# so "superseded" is read off the rkaf:supersedesAssertion edge that already
# had to exist and "withdrawn" is read off a rescission event. A stored status
# could only ever agree or disagree with those two facts, and the validator's
# only use for it was checking that it agreed.

# atlas:AuthorityStatus, atlas:authoritative, atlas:nonAuthoritative and
# atlas:authorityStatus are gone. The only shape that used the property pinned
# it with sh:hasValue atlas:nonAuthoritative, so every conforming dataset
# carried the same value and the property could not distinguish two datasets:
# it restated what atlas:DerivedRelation and the derived graph already say.
# atlas:authoritative was never emitted at all. Rulespec's #AuthorityKind and
# #AuthorityChainStatus were deliberately NOT adopted in its place -- Atlas has
# no authority values to record, and adopting them would mint the information
# this deletion removes.

# Editorial decision status and review method were Atlas classes. Both are
# decision-making vocabulary, which Rulespec owns: a decision is now
# rkaf:decision over rkaf's #AttestationDecision, and the single review-method
# enum is decomposed into the orthogonal rkaf axes it used to conflate. See
# the EvidenceBinding shapes in shapes/atlas.shacl.ttl.

atlas:Release
  a owl:Class ;
  rdfs:label "release"@en .

atlas:AtlasRelease
  a owl:Class ;
  rdfs:subClassOf atlas:Release ;
  rdfs:label "Atlas release"@en .

atlas:SourceRelease
  a owl:Class ;
  rdfs:subClassOf atlas:Release ;
  rdfs:label "source release"@en .

atlas:ResourceScheme
  a owl:Class ;
  rdfs:label "resource scheme"@en .

atlas:RegistrySource
  a owl:Class ;
  rdfs:label "registry source"@en ;
  rdfs:comment "Cataloged publisher or reference source from which one or more governed resource schemes may be emitted."@en .

atlas:AtlasResource
  a owl:Class ;
  rdfs:label "Atlas resource"@en .

atlas:SubjectConcept
  a owl:Class ;
  rdfs:subClassOf atlas:AtlasResource, skos:Concept ;
  rdfs:label "subject concept"@en .

atlas:EntityResource
  a owl:Class ;
  rdfs:subClassOf atlas:AtlasResource ;
  rdfs:label "entity resource"@en .

atlas:ValueResource
  a owl:Class ;
  rdfs:subClassOf atlas:AtlasResource ;
  rdfs:label "value resource"@en .

atlas:LegalIdentityResource
  a owl:Class ;
  rdfs:subClassOf atlas:AtlasResource ;
  rdfs:label "legal identity resource"@en .

atlas:Identifier
  a owl:Class ;
  rdfs:label "identifier"@en .

atlas:SourceRecord
  a owl:Class ;
  rdfs:label "source record"@en .

atlas:EditorialPolicy
  a owl:Class ;
  rdfs:label "editorial policy"@en .

# The lifecycle-event class is rkaf:LifecycleEvent. Its event kind, effective
# date, and subject are rkaf's too; see atlas:LifecycleEventShape in
# shapes/atlas.shacl.ttl, which closes the kind to the two kernel kinds Atlas
# can justify. Only the two release pointers below stay Atlas-owned, because a
# release is structure RefSpec owns.

# MACHINE ADJUDICATION -- five more adopted rkaf classes, no atlas: term at all.
#
# Atlas 1.0 carried a private protocol for machine-qualified mappings:
# atlas:MachineValidation, atlas:verdictRelation, atlas:adjudicatedRelation,
# atlas:qualifiedBy, atlas:requestArtifact, atlas:inputContextArtifact /
# atlas:inputContextDigest. Rulespec now owns every one of those semantics
# (constraints/analysis/resolver-proof-record.cue, machine-adjudication.cue,
# relation-comparison-context.cue, constraints/core/{ai-lineage,artifact}.cue),
# so Atlas 3.0 publishes rkaf's records rather than a second name for them, and
# mints nothing of its own here:
#
#   rkaf:ResolverProofRecord        one machine's sealed, reviewable answer to
#                                   one comparison question -- was
#                                   atlas:MachineValidation. Narrowed by
#                                   rkaf:proofType, never by a second rdf:type,
#                                   exactly as machine-adjudication.cue
#                                   requires; #MachineAdjudicationProof is that
#                                   narrowing, not a second wire class.
#   rkaf:ResolverProofIssuer        the versioned resolver and policy a proof
#                                   was issued under. The independence axes
#                                   "validator actor" and "provider" are read
#                                   here (the issuer IRI, and its
#                                   rkaf:proofResolver) rather than copied onto
#                                   every proof.
#   rkaf:AILineage                  which model answered, at which version,
#                                   under which prompt contract and sampling
#                                   settings, over which input context. The
#                                   "provider model id" axis is
#                                   rkaf:hasAILineage -> rkaf:modelId.
#   rkaf:Artifact                   an immutable state with a content digest.
#                                   Four per comparison: the two compared
#                                   endpoints, the sealed request, and one
#                                   sealed response per proof -- was
#                                   atlas:inputContextArtifact plus
#                                   atlas:requestArtifact and the sealed
#                                   response artifact.
#   rkaf:RelationComparisonContext  the comparison itself: the artifact pair,
#                                   which Atlas assertion it was run for, its
#                                   outcome, and the COMPLETE set of proofs
#                                   that supported it -- was atlas:qualifiedBy
#                                   on the mapping.
#
# Three v1 -> rkaf mapping decisions are recorded here because nothing else on
# the wire records them:
#
# 1. THE VERDICT ENUM LOSES TWO VALUES, AND THE OUTCOME ENUM GAINS THEM BACK.
#    v1's atlas:verdictRelation had seven (same, near_same, target_is_broader,
#    target_is_narrower, related, unrelated, insufficient_evidence). rkaf's
#    #MachineAdjudicationVerdict has five: a verdict NAMES A RELATION, and
#    "unrelated" and "insufficient_evidence" name no relation -- they are
#    refusals, and a refusal is a gate result. On the v3 wire a refusal rides in
#    rkaf:proofOutcome (rkaf:gateFail for a refused comparison,
#    rkaf:gateUnknown for one nobody could decide), and the comparison carrying
#    it takes one of the four non-satisfied #RelationComparisonOutcome values.
#    Atlas PUBLISHES those records rather than pinning them away: a consumer
#    that cannot tell "never adjudicated" from "adjudicated and refused" has
#    lost exactly the distinction relation-comparison-context.cue keeps five
#    outcomes to preserve. Licensing stays strict and lives in validate.py.
#
# 2. atlas:adjudicatedRelation AND atlas:qualifiedBy BOTH DISAPPEAR, and
#    neither is replaced by an atlas: term. The adjudicated relation is the
#    mapping assertion's own rdf:predicate -- v1 needed a separate field only
#    because its candidate record was not yet an assertion, and a second copy
#    of the relation could only agree or disagree with the one the mapping
#    already states (the same argument that deleted atlas:assertionStatus).
#    The proof set is rkaf:comparisonProofRecord on the comparison, and the
#    link from the Atlas mapping record to its comparison is
#    rkaf:comparisonExpectedAssertion pointing the other way -- "the baseline
#    assertion the comparison was run for", which is exactly the fact an
#    atlas: link property would have minted. rkaf has the term; Atlas uses it.
#
# 3. atlas:reason BECOMES rkaf:proofRationale, AND STAYS NON-AUTHORITATIVE.
#    v1 carried the model's free text as atlas:reason and said a consumer MUST
#    NOT treat it as evidence, because nothing tied the literal to the sealed
#    response it quoted. Dropping the field was the wrong fix: upstream requires
#    a rationale on every proof, for the good reason that a decision with no
#    stated reason is not reviewable. So the field is carried under rkaf's name
#    and the v1 caveat is answered rather than deleted -- the authoritative text
#    is the rkaf:sealedResponseArtifact, which this binding resolves to bundled
#    bytes. A consumer reads rkaf:proofRationale to see why a machine decided as
#    it did, and the sealed response artifact when it needs what was returned.
#
# Every field each of the five classes requires upstream is on the wire; the
# shapes are sh:closed, and a closed shape missing a required upstream field
# would both accept records rulespec rejects and reject records rulespec
# requires. Upstream's optional fields Atlas does not use are simply absent,
# and the two it requires anyway (rkaf:proofInputDigest, rkaf:hasContentDigest)
# are narrowing, which a binding profile may do.
#
# The cross-node rules -- at least one independent pair on five axes, one
# sealed question per comparison, complete support retained, the verdict
# lattice, the snapshot chain, and the resolution of every artifact and digest
# to bundled bytes -- are in bindings/atlas/3.0/tools/validate.py, not here and
# not in the SHACL, for the reason rulespec gives: they relate several proof
# records to one comparison, and per-property SHACL constrains one node.

# RING TEMPORAL CONTEXT -- one more adopted rkaf class, and one atlas: term
# deliberately NOT minted.
#
# A crosswalk between two code editions and a legal-identity equivalence are
# both claims about a period, not about all time: "these two codes mean the
# same thing from 2022-01-01" is a different assertion from "these two codes
# mean the same thing". The registry has enforced that since it had rings --
# src/refspec/registry/infrastructure/semantic_foundation.py requires a
# value-ring mapping to carry effective dates and a legal-identity mapping to
# carry an instant -- but none of it reached the wire, so a consumer reading
# the published Atlas could not tell a dated crosswalk from an undated one.
#
#   rkaf:EffectivePeriod           the period itself, upstream's own record for
#                                  it (constraints/core/effective-period.cue),
#                                  reached through rkaf:hasEffectivePeriod and
#                                  carrying rkaf:effectivePeriodStart and the
#                                  optional rkaf:effectivePeriodEnd. Atlas
#                                  publishes those two fields; upstream's other
#                                  two optional fields, rkaf:retroactiveFrom and
#                                  rkaf:sunsetAt, are absent, which is what an
#                                  optional field means -- Atlas has no producer
#                                  for either, and a field nothing writes and
#                                  nothing checks is how atlas:eventType got
#                                  into the state that deleted it.
#
# The same predicate already names the RELEASE-level period upstream
# (reference-resource-release.cue:42), which src/refspec/atlas/model.py folds
# into the closed digest preimage of an rkaf:ReferenceResourceRelease. That is
# a sibling use of one rkaf term on a different subject, not a second term:
# rkaf reuses rkaf:hasEffectivePeriod on four upstream shapes for exactly this
# reason, and attestation.cue records the rule -- domain expansion, not a
# parallel predicate. Atlas follows it.
#
# TWO MAPPING DECISIONS, recorded here because nothing else on the wire records
# them:
#
# 1. NO atlas:sourceEdition / atlas:targetEdition. The registry's value-ring
#    context carries a sourceEdition and a targetEdition beside its effective
#    dates, and minting the pair here would be legal -- neither local name is
#    rkaf's. It would also be the atlas:assertionStatus mistake again. An
#    edition of a scheme IS an atlas:AtlasRelease: the release IRIs the real
#    registry emits are the editions
#    (urn:ref:atlas-release:3:eurovoc:4.24, :elsst:r6,
#    :doe-osti-thesaurus:v1-2020, and the content-digest-keyed form in
#    src/refspec/atlas/v3_registry_codes.py), a second capture of one scheme at
#    a different edition is necessarily a different release node, and every
#    mapping already pins both: atlas:sourceRelease and atlas:targetRelease,
#    each SHACL-equal to its endpoint's own atlas:inRelease
#    (atlas:MappingAssertionShape, negative case mapping-wrong-endpoint-release).
#    An edition literal beside them could only agree or disagree with the pin,
#    and disagreement is the only thing it could ever be checked for. What the
#    wire was missing is the DATES, and dates are what this adds.
#
# 2. legalIdentity's effectiveAt BECOMES A START WITH NO END. The registry
#    models a legal-identity mapping as a single instant; rkaf models a period
#    whose end may be omitted, and says what the omission means -- "omitted =
#    open-ended". Those are the same claim, so the instant rides as
#    rkaf:effectivePeriodStart and no rkaf:effectivePeriodEnd is written.
#    Writing the instant into both fields would state a zero-length period,
#    which is a different and false claim; inventing an end would state a
#    termination no source supplies.
#
# Which assertions must carry a period is a ring rule, and it is in
# atlas:MappingAssertionShape: value and legal-identity mappings carry exactly
# one, subject and entity mappings carry none. The registry's own rule is the
# same rule, and this is the wire half of it.

# REGISTRY CONFLICT -- one more adopted rkaf class, one rkaf class deliberately
# NOT adopted, and the one contradiction Atlas can publish instead of refusing.
#
#   rkaf:RegistryConflict          upstream's own record for "two or more
#                                  registry entries disagree on the same
#                                  canonical claim" (constraints/core/
#                                  registry-conflict.cue), carrying
#                                  rkaf:conflictingEntries (two or more),
#                                  rkaf:severity from the closed
#                                  #ConflictSeverity, and rkaf:detectedAt.
#                                  Shaped in atlas:RegistryConflictShape.
#
# WHAT CHANGES. Atlas has always detected one Atlas-local contradiction: two
# atlas:Identifier records claiming the same (atlas:identifierScheme,
# atlas:identifierValue) pair for different resources. Until now the only thing
# it could do about it was refuse the whole distribution, which retains nothing
# a consumer can read: the disagreement is deleted along with the artifact, and
# the next producer run rediscovers it. The rule is now two-sided --
#
#   contradiction, no record  -> the build still fails, exactly as before
#                                (negative case identifier-pair-conflict,
#                                unchanged)
#   contradiction + a record naming EXACTLY the entries that disagree
#                             -> the distribution is accepted and PUBLISHES the
#                                conflict, addressable by IRI, for a consumer to
#                                inspect, reference, or escalate
#   a record naming anything else
#                             -> the build fails, because a record that does not
#                                name the disagreement licenses nothing
#
# -- which is what makes the record load-bearing rather than decorative. The
# match is a comparison across several records, so tools/validate.py owns it
# (dataset.identifier-uniqueness), not the SHACL.
#
# WHY THE SKOS INTEGRITY CONFLICTS ARE NOT ON THIS PATH, and cannot be. Atlas
# also refuses distributions that violate SKOS S46 (an exactMatch component
# spanned by a broadMatch, narrowMatch, or relatedMatch) and SKOS S27 (a related
# link across a hierarchy path). Those are integrity conditions of the SKOS
# Reference, not Atlas rules, and Atlas publishes SKOS: a conflict record beside
# the offending triples would describe the breakage without repairing it, and
# every SKOS consumer would still be right to reject the graph. Licensing them
# would trade a refusal a producer can act on for an artifact nobody downstream
# can use. Atlas already has the licensed form for the S27 class, and it is
# predicate-level rather than record-level -- atlas:thesaurusRelated, an
# authored associative link that must be backed by a real hierarchy path
# (negative case unjustified-thesaurus-related). Identifier uniqueness has no
# such external standard behind it; the terms are Atlas's own, so Atlas is free
# to say what a published disagreement looks like there.
#
# rkaf:Finding IS NOT ADOPTED, and this is the reason rather than an oversight.
# constraints/core/finding.cue models one detection about ONE rkaf:subject. The
# only contradiction this wire detects and can retain is a disagreement among
# two or more entries, which is precisely what #RegistryConflict exists for and
# what #Finding cannot state without a producer picking one entry arbitrarily
# and consumers indexing on the choice -- the same argument
# constraints/analysis/relation-finding.cue gives for why #RelationFinding does
# not compose #Finding either. The other surface a Finding might have covered,
# a validator refusal recorded in the acceptance record, does not exist:
# schemas/atlas-acceptance.schema.json admits gates with status "passed" and
# nothing else, and tools/validate.py has no warning path at all -- every
# detection raises. And the one refusal this wire does retain, a machine
# adjudication that ran and licensed nothing, already has rkaf's own records for
# it (rkaf:ResolverProofRecord with a non-passing rkaf:proofOutcome inside a
# non-satisfied rkaf:RelationComparisonContext; valid case
# adjudication-refused-comparison-record). A Finding here would be a second name
# for a fact the wire already carries, which is the thing this binding does not
# do.

atlas:RelationAssertion
  a owl:Class ;
  rdfs:label "relation assertion"@en .

atlas:MappingAssertion
  a owl:Class ;
  rdfs:subClassOf atlas:RelationAssertion ;
  rdfs:label "mapping assertion"@en .

atlas:SkosMappingAssertion
  a owl:Class ;
  rdfs:subClassOf atlas:MappingAssertion ;
  rdfs:label "SKOS mapping assertion"@en ;
  rdfs:comment "Subject-ring mapping assertion constrained to one of SKOS's five concrete mapping predicates."@en .

atlas:NativeRelationAssertion
  a owl:Class ;
  rdfs:subClassOf atlas:RelationAssertion ;
  rdfs:label "native relation assertion"@en .

atlas:SourceAssignment
  a owl:Class ;
  rdfs:subClassOf atlas:RelationAssertion ;
  rdfs:label "source assignment"@en .

atlas:CrossRingRelationAssertion
  a owl:Class ;
  rdfs:subClassOf atlas:RelationAssertion ;
  rdfs:label "cross-ring relation assertion"@en ;
  rdfs:comment "Evidence-bearing relation whose source and target resources belong to different, explicitly named semantic rings."@en .

atlas:ProjectedRelation
  a owl:Class ;
  rdfs:label "projected relation"@en .

atlas:DerivedRelation
  a owl:Class ;
  rdfs:label "derived relation"@en .

# The four semantic resource types are mutually exclusive. Identifier is a
# separate record and is deliberately not a fifth AtlasResource subtype.

atlas:SubjectConcept
  owl:disjointWith atlas:EntityResource,
    atlas:ValueResource,
    atlas:LegalIdentityResource .

atlas:EntityResource
  owl:disjointWith atlas:ValueResource,
    atlas:LegalIdentityResource .

atlas:ValueResource
  owl:disjointWith atlas:LegalIdentityResource .

atlas:AtlasResource
  owl:disjointWith atlas:Identifier,
    atlas:RegistrySource,
    atlas:SourceRecord,
    rkaf:EvidenceBinding,
    atlas:EditorialPolicy,
    atlas:RelationAssertion,
    atlas:ProjectedRelation,
    atlas:DerivedRelation,
    skosxl:Label .

atlas:Identifier
  owl:disjointWith atlas:RegistrySource,
    atlas:SourceRecord,
    rkaf:EvidenceBinding,
    atlas:EditorialPolicy,
    atlas:RelationAssertion,
    atlas:ProjectedRelation,
    atlas:DerivedRelation,
    skosxl:Label .

atlas:SourceRecord
  owl:disjointWith rkaf:EvidenceBinding,
    atlas:EditorialPolicy,
    atlas:RelationAssertion,
    atlas:ProjectedRelation,
    atlas:DerivedRelation,
    skosxl:Label .

atlas:RegistrySource
  owl:disjointWith atlas:ResourceScheme,
    atlas:SourceRecord,
    rkaf:EvidenceBinding,
    atlas:EditorialPolicy,
    atlas:RelationAssertion,
    atlas:ProjectedRelation,
    atlas:DerivedRelation,
    skosxl:Label .

atlas:RelationAssertion
  owl:disjointWith atlas:ProjectedRelation,
    atlas:DerivedRelation .

atlas:MappingAssertion
  owl:disjointWith atlas:NativeRelationAssertion,
    atlas:SourceAssignment,
    atlas:CrossRingRelationAssertion .

atlas:NativeRelationAssertion
  owl:disjointWith atlas:SourceAssignment,
    atlas:CrossRingRelationAssertion .

atlas:SourceAssignment
  owl:disjointWith atlas:CrossRingRelationAssertion .

atlas:ProjectedRelation
  owl:disjointWith atlas:DerivedRelation .

# Controlled vocabulary individuals

atlas:subject a atlas:SemanticRing ; rdfs:label "subject"@en .
atlas:entity a atlas:SemanticRing ; rdfs:label "entity"@en .
atlas:value a atlas:SemanticRing ; rdfs:label "value"@en .
atlas:legalIdentity a atlas:SemanticRing ; rdfs:label "legal identity"@en .

atlas:conceptScheme a atlas:ResourceProfile ; rdfs:label "concept scheme"@en .
atlas:codeScheme a atlas:ResourceProfile ; rdfs:label "code scheme"@en .
atlas:identifierScheme a atlas:ResourceProfile ; rdfs:label "identifier scheme"@en .
atlas:structureScheme a atlas:ResourceProfile ; rdfs:label "structure scheme"@en .
atlas:resourceCollection a atlas:ResourceProfile ; rdfs:label "resource collection"@en .

# The six atlas:ReviewMethod individuals conflated four independent Rulespec
# axes into one enum, so a consumer could not tell WHAT constructed a record
# (rkaf:assertionOrigin) from WHY it may be believed (rkaf:epistemicBasis),
# from what KIND of evidence backs it (rkaf:evidenceRole), from HOW that
# evidence bears on the claim (rkaf:evidentiaryFunction). Rulespec keeps the
# four apart deliberately -- the comment on #EvidenceRole says the split
# "prevents a consumer from treating retrieval evidence as authority evidence
# merely because both point at the same fragment". The six former values are
# now the six admissible axis combinations, enforced by the sh:xone on
# atlas:EvidenceBindingShape, which is what keeps the set closed.
#
#   publisherAssertion          sourceExplicit + officialSourceMetadata
#   deterministicTransformation deterministicDerivation + structuralEvidence
#   humanReview                 humanAsserted + humanUser attestor
#   operatorAdoption            editorialAssertion + formalAdoptionEvent,
#                               and rkaf:basedOnAttestation names what it adopted
#   twoMachineAdjudication      aiSuggested + reviewedAuthorityChain, and the
#                               bound assertion carries a machine-adjudication
#                               proof set (see the block above): this warrant
#                               is the trigger for the whole protocol, not a
#                               free-standing label a producer may claim
#   trustedPipelineReview       deterministicDerivation + authorityCitation

# Shared object properties

atlas:inRelease
  a owl:ObjectProperty ;
  rdfs:range atlas:AtlasRelease ;
  rdfs:label "in release"@en .

atlas:inSourceRelease
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:SourceRelease ;
  rdfs:label "in source release"@en .

atlas:inScheme
  a owl:ObjectProperty ;
  rdfs:range atlas:ResourceScheme ;
  rdfs:label "in scheme"@en .

atlas:semanticRing
  a owl:ObjectProperty ;
  rdfs:range atlas:SemanticRing ;
  rdfs:label "semantic ring"@en .

atlas:sourceRing
  a owl:ObjectProperty ;
  rdfs:range atlas:SemanticRing ;
  rdfs:label "source ring"@en ;
  rdfs:comment "Semantic ring of the source endpoint of a cross-ring assertion or projected relation."@en .

atlas:targetRing
  a owl:ObjectProperty ;
  rdfs:range atlas:SemanticRing ;
  rdfs:label "target ring"@en ;
  rdfs:comment "Semantic ring of the target endpoint of a cross-ring assertion or projected relation."@en .

atlas:supportedRing
  a owl:ObjectProperty ;
  rdfs:domain atlas:ResourceScheme ;
  rdfs:range atlas:SemanticRing ;
  rdfs:label "supported ring"@en .

atlas:resourceProfile
  a owl:ObjectProperty ;
  rdfs:range atlas:ResourceProfile ;
  rdfs:label "resource profile"@en .

atlas:sourceRecord
  a owl:ObjectProperty ;
  rdfs:range atlas:SourceRecord ;
  rdfs:label "source record"@en .

atlas:representsResource
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:AtlasResource ;
  rdfs:label "represents resource"@en .

atlas:collectionMember
  a owl:ObjectProperty ;
  rdfs:domain atlas:ResourceScheme ;
  rdfs:range atlas:ResourceScheme ;
  rdfs:label "collection member"@en .

atlas:sourceDescriptor
  a owl:ObjectProperty ;
  rdfs:domain atlas:ResourceScheme ;
  rdfs:range atlas:RegistrySource ;
  rdfs:label "source descriptor"@en ;
  rdfs:comment "Cataloged source that defines or supplies this governed resource scheme."@en .

atlas:sourceLocator
  a owl:ObjectProperty ;
  rdfs:label "source locator"@en .

atlas:identifierScheme
  a owl:ObjectProperty ;
  rdfs:domain atlas:Identifier ;
  rdfs:range atlas:ResourceScheme ;
  rdfs:label "identifier scheme"@en .

atlas:identifies
  a owl:ObjectProperty ;
  rdfs:domain atlas:Identifier ;
  rdfs:range atlas:AtlasResource ;
  rdfs:label "identifies"@en .

# Assertion and evidence properties

atlas:sourceRelease
  a owl:ObjectProperty ;
  rdfs:domain atlas:RelationAssertion ;
  rdfs:range atlas:Release ;
  rdfs:label "source release"@en .

atlas:targetRelease
  a owl:ObjectProperty ;
  rdfs:domain atlas:RelationAssertion ;
  rdfs:range atlas:Release ;
  rdfs:label "target release"@en .

atlas:governedByPolicy
  a owl:ObjectProperty ;
  rdfs:domain atlas:RelationAssertion ;
  rdfs:range atlas:EditorialPolicy ;
  rdfs:label "governed by policy"@en .

atlas:evidenceSourceRecord
  a owl:ObjectProperty ;
  rdfs:domain rkaf:EvidenceBinding ;
  rdfs:range atlas:SourceRecord ;
  rdfs:label "evidence source record"@en ;
  rdfs:comment "Atlas addresses evidence at whole-source-record granularity. rkaf:bindsSourceFragment is deliberately not used: an Atlas source record carries a locator and a digest but no selector or coordinate system, so calling it an rkaf:SourceFragment would claim an addressability Atlas does not have."@en .

atlas:relationSubject
  a owl:ObjectProperty ;
  rdfs:label "relation subject"@en .

atlas:relationPredicate
  a owl:ObjectProperty ;
  rdfs:label "relation predicate"@en .

atlas:relationObject
  a owl:ObjectProperty ;
  rdfs:label "relation object"@en .

atlas:fromRelease
  a owl:ObjectProperty ;
  rdfs:domain rkaf:LifecycleEvent ;
  rdfs:range atlas:Release ;
  rdfs:label "from release"@en ;
  rdfs:comment "Release a rescinded assertion is withdrawn from. Rulespec's kernel lifecycle event has no release pointer outside its concept-lifecycle branch, and an Atlas release is structure RefSpec owns, so this pointer stays atlas:."@en .

atlas:toRelease
  a owl:ObjectProperty ;
  rdfs:domain rkaf:LifecycleEvent ;
  rdfs:range atlas:Release ;
  rdfs:label "to release"@en ;
  rdfs:comment "Release a superseding assertion is admitted into. Atlas-owned for the same reason as atlas:fromRelease."@en .

# Projection and derivation properties

atlas:supportingAssertion
  a owl:ObjectProperty ;
  rdfs:domain atlas:ProjectedRelation ;
  rdfs:label "supporting assertion"@en ;
  rdfs:comment "Cross-graph assertion reference. Its target type is checked by the dataset validator rather than inferred into the projection graph."@en .

atlas:derivedFromAssertion
  a owl:ObjectProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:label "derived from assertion"@en ;
  rdfs:comment "Cross-graph assertion reference. Its target type is checked by the dataset validator rather than inferred into the derived graph."@en .

atlas:derivationRule
  a owl:ObjectProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:label "derivation rule"@en .

atlas:engine
  a owl:ObjectProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:label "engine"@en .

# Datatype properties

atlas:sourceDigest
  a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:label "source digest"@en .

atlas:evidenceSourceDigest
  a owl:DatatypeProperty ;
  rdfs:domain rkaf:EvidenceBinding ;
  rdfs:range xsd:string ;
  rdfs:label "evidence source digest"@en ;
  rdfs:comment "Pins the exact contentDigest of the SourceRecord named by an evidence binding."@en .

atlas:policyPayload
  a owl:DatatypeProperty ;
  rdfs:domain atlas:EditorialPolicy ;
  rdfs:range rdfs:Literal ;
  rdfs:label "policy payload"@en .

atlas:assertionIdentityDigest
  a owl:DatatypeProperty ;
  rdfs:domain atlas:RelationAssertion ;
  rdfs:range xsd:string ;
  rdfs:label "assertion identity digest"@en .

atlas:nativePayload
  a owl:DatatypeProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range rdfs:Literal ;
  rdfs:label "native payload"@en .

atlas:descriptorPayload
  a owl:DatatypeProperty ;
  rdfs:range rdfs:Literal ;
  rdfs:label "descriptor payload"@en ;
  rdfs:comment "Source or scheme catalog metadata retained as canonical JSON."@en .

atlas:memberDisposition
  a owl:DatatypeProperty ;
  rdfs:domain atlas:RegistrySource ;
  rdfs:range xsd:string ;
  rdfs:label "member disposition"@en ;
  rdfs:comment "How Atlas represents, defers, or declines member data from this cataloged source, including sources represented only by mapping assertions."@en .

atlas:notation
  a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:label "notation"@en .

atlas:definition
  a owl:DatatypeProperty ;
  rdfs:range rdfs:Literal ;
  rdfs:label "definition"@en .

atlas:note
  a owl:DatatypeProperty ;
  rdfs:range rdfs:Literal ;
  rdfs:label "note"@en .

atlas:recordStatus
  a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:label "record status"@en .

atlas:validationRule
  a owl:DatatypeProperty ;
  rdfs:domain atlas:ResourceScheme ;
  rdfs:range xsd:string ;
  rdfs:label "validation rule"@en .

atlas:componentPosition
  a owl:DatatypeProperty ;
  rdfs:domain atlas:AtlasResource ;
  rdfs:range xsd:integer ;
  rdfs:label "component position"@en .

atlas:validFrom
  a owl:DatatypeProperty ;
  rdfs:range xsd:dateTime ;
  rdfs:label "valid from"@en .

atlas:validUntil
  a owl:DatatypeProperty ;
  rdfs:range xsd:dateTime ;
  rdfs:label "valid until"@en .

atlas:identifierValue
  a owl:DatatypeProperty ;
  rdfs:domain atlas:Identifier ;
  rdfs:range xsd:string ;
  rdfs:label "identifier value"@en .

atlas:engineVersion
  a owl:DatatypeProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:range xsd:string ;
  rdfs:label "engine version"@en .

atlas:generatedAt
  a owl:DatatypeProperty ;
  rdfs:domain atlas:DerivedRelation ;
  rdfs:range xsd:dateTime ;
  rdfs:label "generated at"@en .

atlas:contentDigest
  a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:label "content digest"@en .

# Atlas-native predicates. These are intentionally ordinary object properties:
# the baseline does not declare any of them symmetric, transitive, inverse, or
# functional.

atlas:thesaurusUse
  a owl:ObjectProperty ;
  rdfs:domain atlas:SubjectConcept ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "thesaurus USE"@en ;
  rdfs:comment "Publisher-authored non-preferred-term pointer preserved without treating it as a SKOS semantic relation."@en .

atlas:thesaurusUsedFor
  a owl:ObjectProperty ;
  rdfs:domain atlas:SubjectConcept ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "thesaurus used for"@en ;
  rdfs:comment "Publisher-authored preferred-to-non-preferred-term pointer preserved without declaring inverse or label semantics."@en .

atlas:thesaurusRelated
  a owl:ObjectProperty ;
  rdfs:domain atlas:SubjectConcept ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "thesaurus related"@en ;
  rdfs:comment "Publisher-authored associative link retained when projecting it as skos:related would violate a SKOS integrity condition."@en .

atlas:sameEntityAs
  a owl:ObjectProperty ;
  rdfs:domain atlas:EntityResource ;
  rdfs:range atlas:EntityResource ;
  rdfs:label "same entity as"@en .

atlas:parentEntity
  a owl:ObjectProperty ;
  rdfs:domain atlas:EntityResource ;
  rdfs:range atlas:EntityResource ;
  rdfs:label "parent entity"@en .

atlas:relatedEntity
  a owl:ObjectProperty ;
  rdfs:domain atlas:EntityResource ;
  rdfs:range atlas:EntityResource ;
  rdfs:label "related entity"@en .

atlas:equivalentValue
  a owl:ObjectProperty ;
  rdfs:domain atlas:ValueResource ;
  rdfs:range atlas:ValueResource ;
  rdfs:label "equivalent value"@en .

atlas:broaderValue
  a owl:ObjectProperty ;
  rdfs:domain atlas:ValueResource ;
  rdfs:range atlas:ValueResource ;
  rdfs:label "broader value"@en .

atlas:replacementValue
  a owl:ObjectProperty ;
  rdfs:domain atlas:ValueResource ;
  rdfs:range atlas:ValueResource ;
  rdfs:label "replacement value"@en .

atlas:sameLegalIdentityAs
  a owl:ObjectProperty ;
  rdfs:domain atlas:LegalIdentityResource ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "same legal identity as"@en .

atlas:versionOf
  a owl:ObjectProperty ;
  rdfs:domain atlas:LegalIdentityResource ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "version of"@en .

atlas:relatedLegalIdentity
  a owl:ObjectProperty ;
  rdfs:domain atlas:LegalIdentityResource ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "related legal identity"@en .

atlas:hasIndexedSubject
  a owl:ObjectProperty ;
  rdfs:domain atlas:AtlasResource ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "has indexed subject"@en ;
  rdfs:comment "Reviewed indexing relation from an entity or legal-identity resource to a subject concept; the closed cross-ring policy determines admissible source rings."@en .

atlas:referencesLegalIdentity
  a owl:ObjectProperty ;
  rdfs:domain atlas:EntityResource ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "references legal identity"@en ;
  rdfs:comment "Reviewed relation from an entity resource to a legal-identity resource that it references."@en .

atlas:assignedSubject
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:SubjectConcept ;
  rdfs:label "assigned subject"@en .

atlas:assignedEntity
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:EntityResource ;
  rdfs:label "assigned entity"@en .

atlas:assignedValue
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:ValueResource ;
  rdfs:label "assigned value"@en .

atlas:assignedLegalIdentity
  a owl:ObjectProperty ;
  rdfs:domain atlas:SourceRecord ;
  rdfs:range atlas:LegalIdentityResource ;
  rdfs:label "assigned legal identity"@en .
