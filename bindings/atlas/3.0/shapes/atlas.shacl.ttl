@prefix atlas:   <https://refspec.org/ns/atlas/v3#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl:  <http://www.w3.org/2008/05/skos-xl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://refspec.org/ns/atlas/v3/shapes>
  a owl:Ontology ;
  rdfs:label "RefSpec Atlas SHACL shapes 3.0"@en ;
  rdfs:comment "Closed-world publication constraints for the asserted, projection, and derived roles of an Atlas 3.0 dataset."@en ;
  owl:versionInfo "3.0" .

# Reusable value shapes

atlas:DigestValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:Literal ;
  sh:datatype xsd:string ;
  sh:pattern "^sha256:[0-9a-f]{64}$" ;
  sh:message "A digest MUST use the lowercase sha256:<64 hex> form." .

atlas:SemanticRingValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:IRI .

atlas:ResourceProfileValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:IRI .

atlas:NonEmptyStringValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:Literal ;
  sh:datatype xsd:string ;
  sh:minLength 1 .

atlas:TextLiteralValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:Literal ;
  sh:or (
    [ sh:datatype rdf:langString ]
    [ sh:datatype xsd:string ]
  ) .

atlas:DateTimeValueShape
  a sh:NodeShape ;
  sh:nodeKind sh:Literal ;
  sh:datatype xsd:dateTime .

# Releases, schemes, resources, identifiers, and source records

atlas:RegistrySourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:RegistrySource ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path atlas:descriptorPayload ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype rdf:JSON
  ] ;
  sh:property [
    sh:path atlas:memberDisposition ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:in (
      "assignmentEvidenceOnly"
      "childReleaseOnly"
      "definitionOnly"
      "historicalEvidenceOnly"
      "mappingAssertionsOnly"
      "memberRelease"
      "noPublisherRecord"
      "resourceFamily"
      "reviewWithheld"
    )
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] .

atlas:SourceReleaseShape
  a sh:NodeShape ;
  sh:targetClass atlas:SourceRelease ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path dcterms:issued ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path atlas:sourceDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceLocator ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] .

atlas:AtlasReleaseShape
  a sh:NodeShape ;
  sh:targetClass atlas:AtlasRelease ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path dcterms:issued ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path atlas:inScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:ResourceScheme
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:resourceProfile ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:ResourceProfileValueShape
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:membershipMode ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue atlas:completeMembership
  ] ;
  sh:property [
    sh:path prov:hadMember ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasResource
  ] ;
  sh:property [
    sh:path ( atlas:inScheme atlas:resourceProfile ) ;
    sh:equals atlas:resourceProfile
  ] .

atlas:ResourceSchemeShape
  a sh:NodeShape ;
  sh:targetClass atlas:ResourceScheme ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:resourceProfile ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:ResourceProfileValueShape
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceDescriptor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:RegistrySource
  ] ;
  sh:property [
    sh:path atlas:supportedRing ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:descriptorPayload ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype rdf:JSON
  ] ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path atlas:collectionMember ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:ResourceScheme
  ] ;
  sh:property [ sh:path atlas:validationRule ; sh:node atlas:NonEmptyStringValueShape ] ;
  sh:property [ sh:path atlas:recordStatus ; sh:maxCount 1 ; sh:node atlas:NonEmptyStringValueShape ] ;
  sh:property [ sh:path atlas:definition ; sh:node atlas:TextLiteralValueShape ] ;
  sh:property [ sh:path atlas:note ; sh:node atlas:TextLiteralValueShape ] ;
  sh:property [
    sh:path atlas:validFrom ;
    sh:maxCount 1 ;
    sh:node atlas:DateTimeValueShape ;
    sh:lessThanOrEquals atlas:validUntil
  ] ;
  sh:property [ sh:path atlas:validUntil ; sh:maxCount 1 ; sh:node atlas:DateTimeValueShape ] ;
  sh:or (
    [ sh:not [ sh:property [ sh:path atlas:resourceProfile ; sh:hasValue atlas:conceptScheme ] ] ]
    [ sh:class skos:ConceptScheme ]
  ) .

atlas:ConceptHostingSchemeShape
  a sh:NodeShape ;
  sh:targetObjectsOf skos:inScheme ;
  sh:class skos:ConceptScheme .

atlas:AtlasResourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:AtlasResource ;
  sh:targetClass atlas:SubjectConcept ;
  sh:targetClass atlas:EntityResource ;
  sh:targetClass atlas:ValueResource ;
  sh:targetClass atlas:LegalIdentityResource ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:inRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasRelease
  ] ;
  sh:property [
    sh:path atlas:inScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:ResourceScheme
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:resourceProfile ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:ResourceProfileValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceRecord ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRecord
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [ sh:path atlas:notation ; sh:node atlas:NonEmptyStringValueShape ] ;
  sh:property [ sh:path atlas:recordStatus ; sh:maxCount 1 ; sh:node atlas:NonEmptyStringValueShape ] ;
  sh:property [ sh:path atlas:definition ; sh:node atlas:TextLiteralValueShape ] ;
  sh:property [ sh:path atlas:note ; sh:node atlas:TextLiteralValueShape ] ;
  sh:property [
    sh:path atlas:componentPosition ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0
  ] ;
  sh:property [
    sh:path atlas:validFrom ;
    sh:maxCount 1 ;
    sh:node atlas:DateTimeValueShape ;
    sh:lessThanOrEquals atlas:validUntil
  ] ;
  sh:property [ sh:path atlas:validUntil ; sh:maxCount 1 ; sh:node atlas:DateTimeValueShape ] ;
  sh:property [
    sh:path skos:inScheme ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class skos:ConceptScheme
  ] ;
  sh:property [
    sh:path skosxl:prefLabel ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class skosxl:Label ;
    sh:disjoint skosxl:altLabel ;
    sh:disjoint skosxl:hiddenLabel
  ] ;
  sh:property [
    sh:path skosxl:altLabel ;
    sh:nodeKind sh:IRI ;
    sh:class skosxl:Label ;
    sh:disjoint skosxl:hiddenLabel
  ] ;
  sh:property [
    sh:path skosxl:hiddenLabel ;
    sh:nodeKind sh:IRI ;
    sh:class skosxl:Label
  ] ;
  sh:property [
    sh:path [ sh:alternativePath ( skosxl:prefLabel skosxl:altLabel skosxl:hiddenLabel ) ] ;
    sh:minCount 1
  ] ;
  sh:property [ sh:path skos:prefLabel ; sh:maxCount 0 ] ;
  sh:property [ sh:path skos:altLabel ; sh:maxCount 0 ] ;
  sh:property [ sh:path skos:hiddenLabel ; sh:maxCount 0 ] ;
  sh:property [
    sh:path ( atlas:inRelease atlas:inScheme ) ;
    sh:equals atlas:inScheme
  ] ;
  sh:property [
    sh:path ( atlas:inRelease atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( atlas:inRelease atlas:resourceProfile ) ;
    sh:equals atlas:resourceProfile
  ] ;
  sh:property [
    sh:path [ sh:inversePath prov:hadMember ] ;
    sh:equals atlas:inRelease
  ] .

atlas:SubjectConceptShape
  a sh:NodeShape ;
  sh:targetClass atlas:SubjectConcept ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:subject ] ;
  sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:equals atlas:inScheme ] .

atlas:EntityResourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:EntityResource ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:entity ] ;
  sh:property [ sh:path skos:inScheme ; sh:maxCount 0 ] .

atlas:ValueResourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:ValueResource ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:value ] ;
  sh:or (
    [
      sh:not [ sh:class skos:Concept ] ;
      sh:property [ sh:path skos:inScheme ; sh:maxCount 0 ]
    ]
    [
      sh:class skos:Concept ;
      sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:equals atlas:inScheme ]
    ]
  ) .

atlas:LegalIdentityResourceShape
  a sh:NodeShape ;
  sh:targetClass atlas:LegalIdentityResource ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:legalIdentity ] ;
  sh:property [ sh:path skos:inScheme ; sh:maxCount 0 ] .

atlas:IdentifierShape
  a sh:NodeShape ;
  sh:targetClass atlas:Identifier ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:identifierValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path atlas:identifierScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:ResourceScheme
  ] ;
  sh:property [
    sh:path atlas:identifies ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasResource
  ] ;
  sh:property [
    sh:path atlas:sourceRecord ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRecord
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path ( atlas:identifierScheme atlas:resourceProfile ) ;
    sh:hasValue atlas:identifierScheme
  ] .

atlas:SourceRecordShape
  a sh:NodeShape ;
  sh:targetClass atlas:SourceRecord ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:inSourceRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRelease
  ] ;
  sh:property [
    sh:path atlas:sourceDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceLocator ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:nativePayload ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype rdf:JSON
  ] ;
  sh:property [
    sh:path atlas:representsResource ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasResource
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] .

atlas:EditorialPolicyShape
  a sh:NodeShape ;
  sh:targetClass atlas:EditorialPolicy ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:policyPayload ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype rdf:JSON
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] .

# Canonical SKOS-XL labels

atlas:SkosXlLabelShape
  a sh:NodeShape ;
  sh:targetClass skosxl:Label ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path skosxl:literalForm ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:minLength 1 ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" ) ;
    sh:message "Atlas 3.0 label literals MUST use the English language tag @en."
  ] ;
  sh:property [
    sh:path atlas:inRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:AtlasRelease
  ] ;
  sh:property [
    sh:path atlas:sourceRecord ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRecord
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] .

# Evidence-bearing relation assertions

atlas:RelationAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:RelationAssertion ;
  sh:targetClass atlas:MappingAssertion ;
  sh:targetClass atlas:SkosMappingAssertion ;
  sh:targetClass atlas:NativeRelationAssertion ;
  sh:targetClass atlas:SourceAssignment ;
  sh:targetClass atlas:CrossRingRelationAssertion ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path rdf:subject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rdf:predicate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rdf:object ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:sourceRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:Release
  ] ;
  sh:property [
    sh:path atlas:targetRelease ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:Release
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:targetRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:assertedAt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path atlas:governedByPolicy ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:EditorialPolicy
  ] ;
  sh:property [
    sh:path atlas:assertionStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( atlas:current atlas:superseded atlas:withdrawn )
  ] ;
  sh:property [
    sh:path atlas:supersedes ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:RelationAssertion
  ] ;
  sh:property [
    sh:path atlas:assertionIdentityDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path [ sh:inversePath atlas:bindsAssertion ] ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:EvidenceBinding
  ] ;
  sh:xone (
    [
      sh:property [ sh:path atlas:semanticRing ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:sourceRing ; sh:maxCount 0 ] ;
      sh:property [ sh:path atlas:targetRing ; sh:maxCount 0 ]
    ]
    [
      sh:property [ sh:path atlas:semanticRing ; sh:maxCount 0 ] ;
      sh:property [ sh:path atlas:sourceRing ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:targetRing ; sh:minCount 1 ]
    ]
  ) .

atlas:MappingAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:MappingAssertion ;
  sh:property [
    sh:path rdf:subject ;
    sh:class atlas:AtlasResource
  ] ;
  sh:property [
    sh:path rdf:object ;
    sh:class atlas:AtlasResource
  ] ;
  sh:property [
    sh:path atlas:sourceRelease ;
    sh:class atlas:AtlasRelease
  ] ;
  sh:property [
    sh:path atlas:targetRelease ;
    sh:class atlas:AtlasRelease
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:inRelease ) ;
    sh:equals atlas:sourceRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:inRelease ) ;
    sh:equals atlas:targetRelease
  ] .

atlas:SkosMappingAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:SkosMappingAssertion ;
  sh:property [ sh:path atlas:semanticRing ; sh:hasValue atlas:subject ] ;
  sh:property [ sh:path rdf:subject ; sh:class atlas:SubjectConcept ] ;
  sh:property [ sh:path rdf:object ; sh:class atlas:SubjectConcept ] ;
  sh:property [ sh:path atlas:sourceRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [ sh:path atlas:targetRelease ; sh:class atlas:AtlasRelease ] .

atlas:NativeRelationAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:NativeRelationAssertion ;
  sh:property [ sh:path rdf:subject ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path rdf:object ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path atlas:sourceRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [ sh:path atlas:targetRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [
    sh:path ( rdf:subject atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:inRelease ) ;
    sh:equals atlas:sourceRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:inRelease ) ;
    sh:equals atlas:targetRelease
  ] .

atlas:SourceAssignmentShape
  a sh:NodeShape ;
  sh:targetClass atlas:SourceAssignment ;
  sh:property [ sh:path rdf:subject ; sh:class atlas:SourceRecord ] ;
  sh:property [ sh:path rdf:object ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path atlas:targetRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [
    sh:path ( rdf:subject atlas:inSourceRelease ) ;
    sh:equals atlas:sourceRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:inRelease ) ;
    sh:equals atlas:targetRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:semanticRing ) ;
    sh:equals atlas:semanticRing
  ] .

atlas:CrossRingRelationAssertionShape
  a sh:NodeShape ;
  sh:targetClass atlas:CrossRingRelationAssertion ;
  sh:property [ sh:path rdf:subject ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path rdf:object ; sh:class atlas:AtlasResource ] ;
  sh:property [ sh:path atlas:sourceRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [ sh:path atlas:targetRelease ; sh:class atlas:AtlasRelease ] ;
  sh:property [
    sh:path atlas:sourceRing ;
    sh:disjoint atlas:targetRing
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:semanticRing ) ;
    sh:equals atlas:sourceRing
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:semanticRing ) ;
    sh:equals atlas:targetRing
  ] ;
  sh:property [
    sh:path ( rdf:subject atlas:inRelease ) ;
    sh:equals atlas:sourceRelease
  ] ;
  sh:property [
    sh:path ( rdf:object atlas:inRelease ) ;
    sh:equals atlas:targetRelease
  ] .

atlas:EvidenceBindingShape
  a sh:NodeShape ;
  sh:targetClass atlas:EvidenceBinding ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path atlas:bindsAssertion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:RelationAssertion
  ] ;
  sh:property [
    sh:path atlas:evidenceSourceRecord ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:SourceRecord
  ] ;
  sh:property [
    sh:path atlas:evidenceSourceDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:reviewedBy ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:decisionStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue atlas:approved
  ] ;
  sh:property [
    sh:path atlas:reviewMethod ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      atlas:humanReview
      atlas:trustedPipelineReview
      atlas:twoMachineAdjudication
      atlas:publisherAssertion
      atlas:operatorAdoption
      atlas:deterministicTransformation
    )
  ] ;
  sh:property [
    sh:path atlas:adoptedEvidence ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class atlas:EvidenceBinding
  ] ;
  sh:property [
    sh:path atlas:decidedAt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path atlas:confidence ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:or (
    [
      sh:not [ sh:property [ sh:path atlas:reviewMethod ; sh:hasValue atlas:operatorAdoption ] ] ;
      sh:property [ sh:path atlas:adoptedEvidence ; sh:maxCount 0 ]
    ]
    [
      sh:property [ sh:path atlas:reviewMethod ; sh:hasValue atlas:operatorAdoption ] ;
      sh:property [ sh:path atlas:adoptedEvidence ; sh:minCount 1 ]
    ]
  ) .

atlas:LifecycleEventShape
  a sh:NodeShape ;
  sh:targetClass atlas:LifecycleEvent ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path atlas:eventSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path atlas:eventType ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path atlas:eventAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
  sh:property [ sh:path atlas:fromRelease ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class atlas:Release ] ;
  sh:property [ sh:path atlas:toRelease ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class atlas:Release ] ;
  sh:property [ sh:path atlas:sourceRecord ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class atlas:SourceRecord ] ;
  sh:property [ sh:path atlas:contentDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:node atlas:DigestValueShape ] .

# Reproducible projection records

atlas:ProjectedRelationShape
  a sh:NodeShape ;
  sh:targetClass atlas:ProjectedRelation ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type rdfs:label ) ;
  sh:property [
    sh:path atlas:relationSubject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:relationPredicate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:relationObject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:sourceRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:targetRing ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:supportingAssertion ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:xone (
    [
      sh:property [ sh:path atlas:semanticRing ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:sourceRing ; sh:maxCount 0 ] ;
      sh:property [ sh:path atlas:targetRing ; sh:maxCount 0 ]
    ]
    [
      sh:property [ sh:path atlas:semanticRing ; sh:maxCount 0 ] ;
      sh:property [ sh:path atlas:sourceRing ; sh:minCount 1 ] ;
      sh:property [ sh:path atlas:targetRing ; sh:minCount 1 ]
    ]
  ) .

# Explicitly non-authoritative derived relation records

atlas:DerivedRelationShape
  a sh:NodeShape ;
  sh:targetClass atlas:DerivedRelation ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type rdfs:label ) ;
  sh:property [
    sh:path atlas:relationSubject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:relationPredicate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:relationObject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:semanticRing ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:SemanticRingValueShape
  ] ;
  sh:property [
    sh:path atlas:derivedFromAssertion ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:derivationRule ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:engine ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path atlas:engineVersion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minLength 1
  ] ;
  sh:property [
    sh:path atlas:inputDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] ;
  sh:property [
    sh:path atlas:generatedAt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path atlas:authorityStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:hasValue atlas:nonAuthoritative
  ] ;
  sh:property [
    sh:path atlas:contentDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node atlas:DigestValueShape
  ] .
