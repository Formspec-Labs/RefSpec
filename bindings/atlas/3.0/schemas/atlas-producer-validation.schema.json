{
  "$id": "https://refspec.org/bindings/atlas/3.0/schemas/atlas-producer-validation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertedInventoryDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "binding": {
      "$ref": "atlas-manifest.schema.json#/$defs/binding"
    },
    "checks": {
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "constructorProfile": {
      "const": "atlas-3-source-and-publisher-mapping-compiled-shacl-v1"
    },
    "constructionSummary": {
      "additionalProperties": false,
      "properties": {
        "compactPackCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "compactPackInventoryDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "path": {
          "const": "atlas-construction-summary.json"
        },
        "profile": {
          "const": "atlas-3-authenticated-construction-summary-v1"
        },
        "releaseCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "releaseInventoryDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "profile",
        "path",
        "digest",
        "releaseCount",
        "releaseInventoryDigest",
        "compactPackCount",
        "compactPackInventoryDigest"
      ],
      "type": "object"
    },
    "counts": {
      "$ref": "atlas-manifest.schema.json#/$defs/aggregateCounts"
    },
    "implementationDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "mode": {
      "const": "compiledSourceAndPublisherMappingProducerValidation"
    },
    "semanticConstruction": {
      "additionalProperties": false,
      "properties": {
        "inputFileCount": {
          "$ref": "common.schema.json#/$defs/nonnegativeInteger",
          "minimum": 1
        },
        "inputInventoryDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "profile": {
          "const": "atlas-3-exact-input-whole-distribution-reuse-v1"
        },
        "recipeDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "reuseScope": {
          "const": "wholeDistributionExactInputsOnly"
        }
      },
      "required": [
        "profile",
        "reuseScope",
        "recipeDigest",
        "inputInventoryDigest",
        "inputFileCount"
      ],
      "type": "object"
    },
    "shaclDataProof": {
      "const": "compiledAgainstPinnedOntologyAndShapes"
    },
    "shaclMetaValidation": {
      "const": "pySHACL"
    },
    "sourceAccountingDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "sourceReleaseCount": {
      "$ref": "common.schema.json#/$defs/nonnegativeInteger",
      "minimum": 1
    },
    "status": {
      "const": "passed"
    },
    "type": {
      "const": "AtlasProducerValidation"
    },
    "version": {
      "const": "3.0"
    }
  },
  "required": [
    "type",
    "version",
    "status",
    "mode",
    "constructorProfile",
    "constructionSummary",
    "implementationDigest",
    "binding",
    "assertedInventoryDigest",
    "sourceAccountingDigest",
    "sourceReleaseCount",
    "counts",
    "checks",
    "shaclDataProof",
    "shaclMetaValidation"
  ],
  "title": "RefSpec Atlas 3.0 compiled source and publisher-mapping validation",
  "type": "object"
}
