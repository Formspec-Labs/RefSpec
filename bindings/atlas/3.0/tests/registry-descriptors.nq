<urn:ref:atlas-source-descriptor:court-identifiers-and-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Official court identifiers and CourtListener-normalized values must remain distinct and source-attributed.\",\"identifierRepresentation\":\"Preserve court, case, docket, opinion, citation, package, and platform identifiers with authority type.\",\"officialLocator\":\"https://www.courtlistener.com/help/api/\",\"resourceId\":\"court-identifiers-and-controls\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"availableButUnreconciled\",\"title\":\"Court identifiers and source controls\",\"versionRepresentation\":\"Pin court source, platform API version, record version, capture time, and response digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
