<urn:ref:atlas-source-descriptor:sam-opportunities-native-controls> <http://purl.org/dc/terms/title> "SAM.gov Opportunities native controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-opportunities-native-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-opportunities-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:d93fb3dc070ae06e387816dc7019fb4c7890e953f3843d23bee48a34f32a6036" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-opportunities-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The official documentation is the only code source, the live API exposes only the latest active opportunity, and older set-aside history is incomplete.\",\"identifierRepresentation\":\"Preserve procurement notice type, opportunity status, and set-aside codes exactly, including publisher-marked retired values and source chronology.\",\"officialLocator\":\"https://open.gsa.gov/api/get-opportunities-public-api/\",\"resourceId\":\"sam-opportunities-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"SAM.gov Opportunities native controls\",\"versionRepresentation\":\"Pin the documentation version, exact page capture and digest, change-log evidence, complete scoped code membership, retired-code status, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-opportunities-native-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:scotus-opinion-and-package-types> <http://purl.org/dc/terms/identifier> "scotus-opinion-and-package-types" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:scotus-opinion-and-package-types> <http://purl.org/dc/terms/title> "Supreme Court opinion and package types" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:scotus-opinion-and-package-types> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:scotus-opinion-and-package-types> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:99a3053c8dd5014be000161e02622a00324b77d10dfb4ccd283ef483948c2d4c" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:scotus-opinion-and-package-types> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The Court publishes navigation labels and a prose publication ladder but no stable codes or IRIs, and it does not expose reliable boundaries for individual majority, concurrence, or dissent writings on this page.\",\"identifierRepresentation\":\"Preserve exact opinion-category and package-stage labels with source path and term context; mint no publisher identifier from a changing navigation URL.\",\"officialLocator\":\"https://www.supremecourt.gov/opinions/opinions.aspx\",\"resourceId\":\"scotus-opinion-and-package-types\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"unresolvedIdentity\",\"title\":\"Supreme Court opinion and package types\",\"versionRepresentation\":\"Pin the exact resolved page capture, observation time, artifact digest, category and publication-stage membership, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:scotus-opinion-and-package-types> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sec-rules-regulations-categories> <http://purl.org/dc/terms/identifier> "sec-rules-regulations-categories" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sec-rules-regulations-categories> <http://purl.org/dc/terms/title> "SEC Rules and Regulations page categories" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sec-rules-regulations-categories> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sec-rules-regulations-categories> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:38880d7d5cc17b4c5628165bcfcd354cc4d9c5f845f96706bbc0ef0ef1a0c951" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sec-rules-regulations-categories> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The two navigation blocks differ in labels and destinations and expose no stable category identifiers; they must remain separate dated observations.\",\"identifierRepresentation\":\"Preserve each SEC navigation collection, authored label, relative target path, position, and capture identity without reconciling labels by similarity.\",\"officialLocator\":\"https://www.sec.gov/rules-regulations\",\"resourceId\":\"sec-rules-regulations-categories\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"unresolvedIdentity\",\"title\":\"SEC Rules and Regulations page categories\",\"versionRepresentation\":\"Pin the exact page capture, observation time, artifact digest, separate navigation-block membership, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sec-rules-regulations-categories> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
