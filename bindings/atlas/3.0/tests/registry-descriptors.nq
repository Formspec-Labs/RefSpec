<urn:ref:atlas-resource-scheme:mesh-descriptors> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The complete annual descriptor file is available, but only descriptors are in scope; Supplemental Concept Records and qualifiers remain separate resources, and specialist use needs its own holdout.\",\"identifierRepresentation\":\"Preserve each National Library of Medicine DescriptorUI and corresponding id.nlm.nih.gov URI; never admit supplemental records through the descriptor reader.\",\"officialLocator\":\"https://www.nlm.nih.gov/databases/download/mesh.html\",\"resourceId\":\"mesh-descriptors\",\"resourceKind\":\"subjectVocabulary\",\"sourceAvailability\":\"available\",\"title\":\"Medical Subject Headings descriptors\",\"versionRepresentation\":\"Pin the exact annual descriptor release, source digest, record count, attribution notice, parser version, coverage report, and managed-release identity when produced.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
