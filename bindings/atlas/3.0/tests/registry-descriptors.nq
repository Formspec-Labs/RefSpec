<urn:ref:atlas-resource-scheme:nppes-data-dissemination-layout> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry captures a bounded weekly-file excerpt and the public field layout, not bulk NPPES provider records; NUCC taxonomy code values remain excluded for licensing reasons.\",\"identifierRepresentation\":\"Preserve the exact Version 2 public-file column names and positions as structural fields, including taxonomy field names without storing taxonomy code values.\",\"officialLocator\":\"https://download.cms.gov/nppes/NPI_Files.html\",\"resourceId\":\"nppes-data-dissemination-layout\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"partial\",\"title\":\"NPPES Data Dissemination file layout\",\"versionRepresentation\":\"Pin the file-layout version, exact source ZIP and entry, capture date, digest, bounded excerpt, field count, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:nppes-data-dissemination-layout> <https://refspec.org/ns/atlas/v3#resourceProfile> <https://refspec.org/ns/atlas/v3#structureScheme> <urn:ref:atlas-v3:registry-descriptors> .
