<urn:ref:atlas-source-descriptor:census-aspep-data-flags> <http://purl.org/dc/terms/title> "Census ASPEP data flags" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-aspep-data-flags> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-aspep-data-flags> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:3f2c6dabf21de16edfc56d86a5b560abe53f7951c7ba4e06ae89257b143d8eda" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-aspep-data-flags> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"These flags explain reported values but do not replace the independently versioned government-finance classifications they qualify.\",\"identifierRepresentation\":\"Preserve each official single-letter ASPEP data flag, publisher label, and Reported Data or Imputed Data grouping.\",\"officialLocator\":\"https://www.census.gov/programs-surveys/apes/technical-documentation/code-lists/data-flags.html\",\"resourceId\":\"census-aspep-data-flags\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"Census ASPEP data flags\",\"versionRepresentation\":\"Pin the exact HTML capture, observation time, artifact digest, complete flag count, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-aspep-data-flags> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
