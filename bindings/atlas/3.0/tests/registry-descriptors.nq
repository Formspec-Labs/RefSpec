<urn:ref:atlas-source-descriptor:federal-register-thesaurus-1995> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"evidenceOnly\",\"distributions\":[],\"evidence\":[{\"evidencePath\":\"research/evidence/federal-register-thesaurus-managed-release-2026-07-30/evidence.json\",\"identityStatus\":\"projectManagedConceptIdentityFromExactPublisherSource\",\"intendedUses\":[\"historicalLookup\",\"regressionTesting\",\"vocabularyChangeAnalysis\"],\"packageClass\":\"managedConceptRelease\",\"packageDigest\":\"sha256:96352a29a6ebadc0221af604eebebb2fffb0069ff4367181fd4640671215df70\"}],\"gap\":\"Retained only for historical lookup, regression tests, and vocabulary-change analysis.\",\"identifierRepresentation\":\"Historical RefSpec-managed identities preserve source ordinals; broad categories remain document groupings and are not SKOS hierarchy.\",\"officialLocator\":\"Federal Register Thesaurus of Indexing Terms, 1995 edition\",\"resourceId\":\"federal-register-thesaurus-1995\",\"resourceKind\":\"historicalVocabulary\",\"sourceAvailability\":\"historicalOnly\",\"title\":\"Federal Register Thesaurus of Indexing Terms, 1995\",\"versionRepresentation\":\"Historical package pins the 1995 publication for lookup, regression, and the 1995 to 2025 evidence crosswalk.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
