<urn:ref:atlas-source-descriptor:govinfo-cfr-packages> <http://purl.org/dc/terms/title> "GovInfo CFR package identifiers" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:govinfo-cfr-packages> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:govinfo-cfr-packages> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:d204eb9930309f398ca9cd2f7af4c58e14ecb69bbc8d93be6948ad1113a5ba94" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:govinfo-cfr-packages> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Package summaries and PREMIS records describe individual GovInfo packages; they do not by themselves supply typed legal-effect edges across packages.\",\"identifierRepresentation\":\"Preserve official GovInfo package, granule, collection, docket-class, version, file, and fixity identifiers without conflating them with eCFR current-state identities.\",\"officialLocator\":\"https://www.govinfo.gov/developers\",\"resourceId\":\"govinfo-cfr-packages\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"available\",\"title\":\"GovInfo CFR package identifiers\",\"versionRepresentation\":\"Pin the exact package ID, API response and PREMIS artifacts, capture time, file-level fixity, response digests, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:govinfo-cfr-packages> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
