<urn:ref:atlas-source-descriptor:psc> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The selected PSC edition must match the award or source-record vintage.\",\"identifierRepresentation\":\"Official Product and Service Code and edition.\",\"officialLocator\":\"https://www.acquisition.gov/psc-manual\",\"resourceId\":\"psc\",\"resourceKind\":\"classification\",\"sourceAvailability\":\"available\",\"title\":\"Product and Service Codes\",\"versionRepresentation\":\"Pin the PSC manual edition and official artifact digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
