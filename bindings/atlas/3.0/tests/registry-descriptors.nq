<urn:ref:atlas-resource-scheme:scotus-opinion-and-package-types> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The Court publishes navigation labels and a prose publication ladder but no stable codes or IRIs, and it does not expose reliable boundaries for individual majority, concurrence, or dissent writings on this page.\",\"identifierRepresentation\":\"Preserve exact opinion-category and package-stage labels with source path and term context; mint no publisher identifier from a changing navigation URL.\",\"officialLocator\":\"https://www.supremecourt.gov/opinions/opinions.aspx\",\"resourceId\":\"scotus-opinion-and-package-types\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"unresolvedIdentity\",\"title\":\"Supreme Court opinion and package types\",\"versionRepresentation\":\"Pin the exact resolved page capture, observation time, artifact digest, category and publication-stage membership, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
