<urn:ref:atlas-resource-scheme:omb-a11-budget-codes> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:d4a0f00b98ad4eca2efb532096ed62f05e95097d20c3b8397f1e4ae326ab70d8" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:omb-a11-budget-codes> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The source is a large narrative PDF rather than a machine-readable code service; only the named fiscal tables are imported, and later editions must remain separate.\",\"identifierRepresentation\":\"Preserve official budget function, subfunction, object-class, apportionment-category, and non-apportioned line codes exactly with table and edition.\",\"officialLocator\":\"https://www.whitehouse.gov/omb/information-resources/guidance/circulars/\",\"resourceId\":\"omb-a11-budget-codes\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"OMB Circular A-11 budget codes\",\"versionRepresentation\":\"Pin the Circular edition, full-document reference digest, exact page extracts and digests, source table, row counts, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
