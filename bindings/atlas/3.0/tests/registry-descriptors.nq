<urn:ref:atlas-resource-scheme:nasa-technology-taxonomy> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The current registry captures only the top-level technology-area roster; deeper nodes require additional requests and document-subject value remains unevaluated.\",\"identifierRepresentation\":\"Preserve NASA taxonomy root ID, publisher node ID, technology-area code, title, level, and current status; exclude instrument and platform branches from policy topics.\",\"officialLocator\":\"https://techport.nasa.gov/api/taxonomies\",\"resourceId\":\"nasa-technology-taxonomy\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"partial\",\"title\":\"NASA Technology Taxonomy\",\"versionRepresentation\":\"Pin the taxonomy root roster and selected taxonomy response, capture time, exact digests, release title and status, level coverage, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
