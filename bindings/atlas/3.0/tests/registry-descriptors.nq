<urn:ref:atlas-resource-scheme:cbo-cost-estimate-feed> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The topic-bearing XML endpoint is blocked by DataDome in the current environment; the verified per-Congress feed omits topics and fiscal facets, so the reconstructed topic-and-facet fixture is not publication-ready evidence.\",\"identifierRepresentation\":\"Preserve each cost-estimate record link, authored topic literal, publisher budget-function code, mandate flag, PAYGO flag, bill value, and committee value without minting topic identity.\",\"officialLocator\":\"https://www.cbo.gov/cost-estimates/xml\",\"resourceId\":\"cbo-cost-estimate-feed\",\"resourceKind\":\"sourceAssignedVocabulary\",\"sourceAvailability\":\"partial\",\"title\":\"CBO cost-estimate topics and fiscal facets\",\"versionRepresentation\":\"Pin the exact feed URL, Congress, capture time, response digest, and parser version; separately identify reconstructed fixtures and verified publisher captures.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
