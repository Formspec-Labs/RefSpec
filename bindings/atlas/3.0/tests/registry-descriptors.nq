<urn:ref:atlas-source-descriptor:pra-icr-native-controls> <http://purl.org/dc/terms/title> "Paperwork Reduction Act ICR search controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:pra-icr-native-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:pra-icr-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:8aa7c268068718b61fb4056e301b3e4f118d3d267113f885a1c22af50b9c8ed2" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:pra-icr-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The scoped page omits JavaScript-populated agency codes and several other search controls; those values remain explicit gaps rather than inferred enumerations.\",\"identifierRepresentation\":\"Preserve OMB Control Number grammar, request type, ICR status, and burden-range field identifiers and values exactly as published.\",\"officialLocator\":\"https://www.reginfo.gov/public/do/PRASearch\",\"resourceId\":\"pra-icr-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"Paperwork Reduction Act ICR search controls\",\"versionRepresentation\":\"Pin the exact PRASearch capture, observation time, artifact digest, scoped control membership, parser version, and declared out-of-scope fields.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:pra-icr-native-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
