<urn:ref:atlas-resource-scheme:oversight-report-types> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The report-type facet is embedded in a mutable results page and carries Drupal term IDs rather than a separately versioned code-list distribution.\",\"identifierRepresentation\":\"Preserve every published report-type option, Drupal filter identifier, display label, source position, and observation time.\",\"officialLocator\":\"https://www.oversight.gov/reports/federal\",\"resourceId\":\"oversight-report-types\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"Oversight.gov federal report types\",\"versionRepresentation\":\"Pin the exact page capture, retrieval time, artifact digest, complete facet membership, parser version, and volatile-page limitation.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
