<urn:ref:atlas-resource-scheme:usgs-gnis-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry captures identifier grammar and selected file fields only; it does not ingest the bulk Geographic Names Information System entity file.\",\"identifierRepresentation\":\"Preserve the permanent GNIS feature ID and the publisher-documented state and county code fields without substituting the retired FIPS 55 place code.\",\"officialLocator\":\"https://www.usgs.gov/us-board-on-geographic-names/download-gnis-data\",\"resourceId\":\"usgs-gnis-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"available\",\"title\":\"USGS GNIS feature identifiers\",\"versionRepresentation\":\"Pin the official file-format publication, exact artifact digest, observation date, and reviewed field coverage.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
