<urn:ref:atlas-source-descriptor:usgs-gnis-identifiers> <http://purl.org/dc/terms/title> "USGS GNIS feature identifiers" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:usgs-gnis-identifiers> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:usgs-gnis-identifiers> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:3bbb2e96a0bce3787662f8e3d756f7925bbbaaddc5f19c8d0b5f11448c344b33" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:usgs-gnis-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry captures identifier grammar and selected file fields only; it does not ingest the bulk Geographic Names Information System entity file.\",\"identifierRepresentation\":\"Preserve the permanent GNIS feature ID and the publisher-documented state and county code fields without substituting the retired FIPS 55 place code.\",\"officialLocator\":\"https://www.usgs.gov/us-board-on-geographic-names/download-gnis-data\",\"resourceId\":\"usgs-gnis-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"available\",\"title\":\"USGS GNIS feature identifiers\",\"versionRepresentation\":\"Pin the official file-format publication, exact artifact digest, observation date, and reviewed field coverage.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:usgs-gnis-identifiers> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
