<urn:ref:atlas-resource-scheme:treasury-fast-book> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Parts II and III are machine-readable while Part I remains a formatted PDF; page bytes also contain request-specific analytics tokens, so captures are dated observations.\",\"identifierRepresentation\":\"Preserve each official FAST Book Treasury account symbol, title, part, and fund group exactly; never mint concept identity from an account title.\",\"officialLocator\":\"https://fiscal.treasury.gov/accounting/fast-book/description-of-contents\",\"resourceId\":\"treasury-fast-book\",\"resourceKind\":\"classification\",\"sourceAvailability\":\"partial\",\"title\":\"Federal Account Symbols and Titles Book\",\"versionRepresentation\":\"Pin the page's Last Updated date, exact page capture, official workbook and digest, part coverage, complete parsed row counts, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
