<urn:ref:atlas-resource-scheme:nature-of-suit> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Courts and data providers may expose different vintages or normalized labels.\",\"identifierRepresentation\":\"Preserve the official Nature of Suit code, label, and version.\",\"officialLocator\":\"https://www.uscourts.gov/forms-rules/court-forms/nature-suit-code-descriptions\",\"resourceId\":\"nature-of-suit\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"Nature of Suit codes\",\"versionRepresentation\":\"Pin the official publication date, artifact, and digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
