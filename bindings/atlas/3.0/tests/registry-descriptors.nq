<urn:ref:atlas-source-descriptor:uslm> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:99c253832def8f02ed45c6bf824fb908402a72f3b219d3cb048e31e0c2f4030b" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:uslm> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Adoption is limited to structure needed by current bill and CFR profiles; it does not define RefSpec concepts.\",\"identifierRepresentation\":\"Preserve official USLM element and schema identifiers.\",\"officialLocator\":\"https://github.com/usgpo/uslm\",\"resourceId\":\"uslm\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"available\",\"title\":\"United States Legislative Markup\",\"versionRepresentation\":\"Pin the exact schema release or Git revision and artifact digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:uslm> <https://refspec.org/ns/atlas/v3#memberDisposition> "noPublisherRecord" <urn:ref:atlas-v3:registry-descriptors> .
