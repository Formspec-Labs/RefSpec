<urn:ref:atlas-resource-scheme:fast-topical> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The current registry has exact publisher samples and change records but no complete, reproducible frontier release suitable for atlas membership.\",\"identifierRepresentation\":\"Preserve each OCLC FAST identifier and id.worldcat.org URI plus publisher-authored LCSH derivation links; never replace LCSH identity with FAST identity.\",\"officialLocator\":\"https://www.oclc.org/research/areas/data-science/fast/download.html\",\"resourceId\":\"fast-topical\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"partial\",\"title\":\"OCLC FAST Topical facet\",\"versionRepresentation\":\"Pin the exact bulk snapshot or bounded frontier, chronological change files, source digests, ODC-BY attribution, coverage receipt, and conversion-rule version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
