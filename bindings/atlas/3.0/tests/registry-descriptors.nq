<urn:ref:atlas-source-descriptor:nalt-core> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:cd6c56c9ed73d4b3cc6bfabb3f22bc292bcca5cd99973454c10ddd663a05df87" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nalt-core> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"NALT Core has no single downloadable distribution, and its CC BY 4.0 statement conflicts with broader USDA public-domain or CC0 claims.\",\"identifierRepresentation\":\"Preserve each NALT publisher concept IRI and exact Core scheme membership; refuse NALT Full records and never mint identity from a label.\",\"officialLocator\":\"https://lod.nal.usda.gov/nalt-core/\",\"resourceId\":\"nalt-core\",\"resourceKind\":\"subjectVocabulary\",\"sourceAvailability\":\"partial\",\"title\":\"National Agricultural Library Thesaurus Core\",\"versionRepresentation\":\"Pin every concept response URL, capture time, exact digest, Core scheme assertion, membership coverage, license evidence, and eventual managed-release selection.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nalt-core> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-technology-taxonomy> <http://purl.org/dc/terms/identifier> "nasa-technology-taxonomy" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-technology-taxonomy> <http://purl.org/dc/terms/title> "NASA Technology Taxonomy" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-technology-taxonomy> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-technology-taxonomy> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:504f9056cd01ab819f35b81fdeb1e880ed195b292f6ac94b9e59d4bca2a39764" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-technology-taxonomy> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The current registry captures only the top-level technology-area roster; deeper nodes require additional requests and document-subject value remains unevaluated.\",\"identifierRepresentation\":\"Preserve NASA taxonomy root ID, publisher node ID, technology-area code, title, level, and current status; exclude instrument and platform branches from policy topics.\",\"officialLocator\":\"https://techport.nasa.gov/api/taxonomies\",\"resourceId\":\"nasa-technology-taxonomy\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"partial\",\"title\":\"NASA Technology Taxonomy\",\"versionRepresentation\":\"Pin the taxonomy root roster and selected taxonomy response, capture time, exact digests, release title and status, level coverage, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-technology-taxonomy> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-thesaurus> <http://purl.org/dc/terms/identifier> "nasa-thesaurus" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-thesaurus> <http://purl.org/dc/terms/title> "NASA Thesaurus" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-thesaurus> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-thesaurus> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:2a7030cb48f4b0d47eb0f1853e92e3d34f1021f6df7444462ec450eda187ec71" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-thesaurus> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The distribution states no explicit reuse license, and specialist adoption still requires freshness confirmation, a managed release, and a measured holdout.\",\"identifierRepresentation\":\"Preserve NASA's same-document concept, relation, and note identifiers exactly; do not invent a concept scheme or connect detached annotations by matching local strings.\",\"officialLocator\":\"https://sti.nasa.gov/nasa-thesaurus/\",\"resourceId\":\"nasa-thesaurus\",\"resourceKind\":\"subjectVocabulary\",\"sourceAvailability\":\"availableButUnreconciled\",\"title\":\"NASA Thesaurus\",\"versionRepresentation\":\"Pin the exact SKOS/RDF distribution URL, byte length, digest, capture or content date, attribution statement, parser version, and eventual managed-release coverage.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasa-thesaurus> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasbo-state-expenditure-program-areas> <http://purl.org/dc/terms/identifier> "nasbo-state-expenditure-program-areas" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasbo-state-expenditure-program-areas> <http://purl.org/dc/terms/title> "NASBO State Expenditure Report program areas" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasbo-state-expenditure-program-areas> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasbo-state-expenditure-program-areas> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:adc7c52247a9a8e4259bbe07af0d2bd1a19bf58aa14d0df6f6cefcdb19f172c3" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasbo-state-expenditure-program-areas> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"NASBO publishes program-area labels without stable per-area codes or IRIs, so they remain capture-local mapping references rather than publisher-identified concepts.\",\"identifierRepresentation\":\"Preserve the exact authored program-area heading and source section with no minted identifier.\",\"officialLocator\":\"https://www.nasbo.org/mainsite/reports-data/state-expenditure-report\",\"resourceId\":\"nasbo-state-expenditure-program-areas\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"unresolvedIdentity\",\"title\":\"NASBO State Expenditure Report program areas\",\"versionRepresentation\":\"Pin the report-page edition or observation date, exact capture digest, program-area membership, and any later report-specific mapping review.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nasbo-state-expenditure-program-areas> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nature-of-suit> <http://purl.org/dc/terms/identifier> "nature-of-suit" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nature-of-suit> <http://purl.org/dc/terms/title> "Nature of Suit codes" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nature-of-suit> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nature-of-suit> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:e63a2fa205ad425da68afface9de2eec955637b87cae50eabe7cd54a450bde26" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nature-of-suit> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Courts and data providers may expose different vintages or normalized labels.\",\"identifierRepresentation\":\"Preserve the official Nature of Suit code, label, and version.\",\"officialLocator\":\"https://www.uscourts.gov/forms-rules/court-forms/nature-suit-code-descriptions\",\"resourceId\":\"nature-of-suit\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"Nature of Suit codes\",\"versionRepresentation\":\"Pin the official publication date, artifact, and digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nature-of-suit> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-data-dissemination-layout> <http://purl.org/dc/terms/identifier> "nppes-data-dissemination-layout" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-data-dissemination-layout> <http://purl.org/dc/terms/title> "NPPES Data Dissemination file layout" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-data-dissemination-layout> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-data-dissemination-layout> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:23508dfb5dda9be6d61626f59c93f1f7d9141c0e78da7d27f383761da16142d0" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-data-dissemination-layout> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry captures a bounded weekly-file excerpt and the public field layout, not bulk NPPES provider records; NUCC taxonomy code values remain excluded for licensing reasons.\",\"identifierRepresentation\":\"Preserve the exact Version 2 public-file column names and positions as structural fields, including taxonomy field names without storing taxonomy code values.\",\"officialLocator\":\"https://download.cms.gov/nppes/NPI_Files.html\",\"resourceId\":\"nppes-data-dissemination-layout\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"partial\",\"title\":\"NPPES Data Dissemination file layout\",\"versionRepresentation\":\"Pin the file-layout version, exact source ZIP and entry, capture date, digest, bounded excerpt, field count, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-data-dissemination-layout> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-npi-authority> <http://purl.org/dc/terms/identifier> "nppes-npi-authority" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-npi-authority> <http://purl.org/dc/terms/title> "NPPES National Provider Identifier authority" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-npi-authority> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-npi-authority> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:c3fbef44adeb8285685b91e2094d6ad254466ba5f3a4e5df5d820712f0535dba" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-npi-authority> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry validates National Provider Identifier syntax and a bounded public-file sample; it does not ingest the multi-gigabyte bulk provider registry or licensed NUCC taxonomy values.\",\"identifierRepresentation\":\"Preserve each ten-digit NPI under the NPPES authority and validate its Luhn check digit using the health-industry prefix; never infer provider identity from taxonomy fields.\",\"officialLocator\":\"https://nppes.cms.hhs.gov/\",\"resourceId\":\"nppes-npi-authority\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"NPPES National Provider Identifier authority\",\"versionRepresentation\":\"Pin the official definition and file-vintage evidence, exact bounded sample digest, observation time, identifier validation revision, and sample ceiling.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nppes-npi-authority> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-identifiers> <http://purl.org/dc/terms/identifier> "nrc-adams-identifiers" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-identifiers> <http://purl.org/dc/terms/title> "NRC ADAMS docket and accession identifiers" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-identifiers> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-identifiers> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:ac58016de38a15c227da2d0c4925187a21a081ae3deb39d63c8842eca09b2206" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Legacy accession and docket shapes are documented, while the current ML accession shape is inferred only from publisher examples and no complete identifier authority file is published.\",\"identifierRepresentation\":\"Preserve NRC docket, Public Legacy Library accession, and current ML accession identifiers as distinct documented or source-observed shapes with explicit basis.\",\"officialLocator\":\"https://www.nrc.gov/reading-rm/adams/faq.html\",\"resourceId\":\"nrc-adams-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"definitionOnly\",\"title\":\"NRC ADAMS docket and accession identifiers\",\"versionRepresentation\":\"Pin each defining page or example capture, observation time, digest, identifier-shape basis, validation-rule revision, and known documentation gaps.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-identifiers> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-native-controls> <http://purl.org/dc/terms/identifier> "nrc-adams-native-controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-native-controls> <http://purl.org/dc/terms/title> "NRC ADAMS public-search controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-native-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:4baf48785eb8ae543bcd01b23a81b373bff17e4305ffbf09dc1fd20d4d24250a" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"ADAMS publishes no dedicated constants endpoint; result-field and library-facet labels are snapshot observations from the current search application, not publisher-asserted exhaustive lists.\",\"identifierRepresentation\":\"Preserve each observed search field, library facet, and reference-category label with exact source asset and position; do not mint concept identity.\",\"officialLocator\":\"https://www.nrc.gov/reading-rm/adams\",\"resourceId\":\"nrc-adams-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"NRC ADAMS public-search controls\",\"versionRepresentation\":\"Pin the exact NRC pages and application asset, full-asset and excerpt digests, capture time, observed membership, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:nrc-adams-native-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:oira-review-native-controls> <http://purl.org/dc/terms/identifier> "oira-review-native-controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:oira-review-native-controls> <http://purl.org/dc/terms/title> "OIRA EO 12866 review and meeting controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:oira-review-native-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:oira-review-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:34c5062850aac507bb4d986332145c23dfb265d8cd7cd779a14f9bf5b2d7f245" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:oira-review-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"RegInfo.gov publishes no separate release identifier for the review and meeting value sets, and the enclosing pages contain request-specific session and CSRF values.\",\"identifierRepresentation\":\"Preserve each Review Status, Stage of Rulemaking, Concluded Action, and Meeting Type value with its exact page-specific label and source field.\",\"officialLocator\":\"https://www.reginfo.gov/public/do/eoAdvancedSearch?eoStatusCode=CD\",\"resourceId\":\"oira-review-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"OIRA EO 12866 review and meeting controls\",\"versionRepresentation\":\"Pin each exact control byte span, anchor rule, source page, capture time, digest, option membership, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:oira-review-native-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:omb-a11-budget-codes> <http://purl.org/dc/terms/identifier> "omb-a11-budget-codes" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:omb-a11-budget-codes> <http://purl.org/dc/terms/title> "OMB Circular A-11 budget codes" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:omb-a11-budget-codes> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:omb-a11-budget-codes> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:cd4a526fad90c102c7034c4ce9a8bd13bc075e2fcfeb75cc1d5eadd23d235006" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:omb-a11-budget-codes> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The source is a large narrative PDF rather than a machine-readable code service; only the named fiscal tables are imported, and later editions must remain separate.\",\"identifierRepresentation\":\"Preserve official budget function, subfunction, object-class, apportionment-category, and non-apportioned line codes exactly with table and edition.\",\"officialLocator\":\"https://www.whitehouse.gov/omb/information-resources/guidance/circulars/\",\"resourceId\":\"omb-a11-budget-codes\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"OMB Circular A-11 budget codes\",\"versionRepresentation\":\"Pin the Circular edition, full-document reference digest, exact page extracts and digests, source table, row counts, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:omb-a11-budget-codes> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:opm-ehri-workforce-codes> <http://purl.org/dc/terms/identifier> "opm-ehri-workforce-codes" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:opm-ehri-workforce-codes> <http://purl.org/dc/terms/title> "OPM EHRI workforce codes" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:opm-ehri-workforce-codes> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:opm-ehri-workforce-codes> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:772ff5992dc9b161f844f149d9783545b64b203e02b4cbc94695ed04b2f535e9" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:opm-ehri-workforce-codes> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The current package fixtures are documented-shape samples, not verified full OPM captures; publication must use the complete official EHRI workbook and retain its edition.\",\"identifierRepresentation\":\"Preserve official pay-plan, work-schedule, appointment-type, and occupational-series codes with source sheet, label, status, and effective context.\",\"officialLocator\":\"https://data.opm.gov/data-standards/ehri-data-standards\",\"resourceId\":\"opm-ehri-workforce-codes\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"OPM EHRI workforce codes\",\"versionRepresentation\":\"Pin the complete workbook edition, source URL, capture time, artifact digest, sheet membership and counts, parser version, and any sample-versus-production limitation.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:opm-ehri-workforce-codes> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:opm-plum-position-status-codes> <http://purl.org/dc/terms/identifier> "opm-plum-position-status-codes" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:opm-plum-position-status-codes> <http://purl.org/dc/terms/title> "OPM PLUM position status codes" <urn:ref:atlas-v3:registry-descriptors> .
