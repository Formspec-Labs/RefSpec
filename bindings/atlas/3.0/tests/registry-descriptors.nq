<urn:ref:atlas-resource-scheme:usaspending-award-type-codes> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The endpoint is live and versionless; short API labels and fuller data-dictionary descriptions must remain separate source facts.\",\"identifierRepresentation\":\"Preserve each USAspending award and assistance type code, source-specific description, category, and observation time without reconciling differing labels implicitly.\",\"officialLocator\":\"https://api.usaspending.gov/api/v2/references/award_types/\",\"resourceId\":\"usaspending-award-type-codes\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"USAspending award and assistance type codes\",\"versionRepresentation\":\"Pin the exact endpoint response, capture time, digest, complete observed code count, referenced data-dictionary edition, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
