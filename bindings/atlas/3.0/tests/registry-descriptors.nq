<urn:ref:atlas-source-descriptor:lcsh-fast-mapping-references> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Only reviewed mappings may influence retrieval; label similarity never establishes identity.\",\"identifierRepresentation\":\"Preserve Library of Congress Subject Headings and FAST concept identifiers independently.\",\"officialLocator\":\"https://id.loc.gov/authorities/subjects.html\",\"resourceId\":\"lcsh-fast-mapping-references\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"available\",\"title\":\"LCSH and FAST mapping references\",\"versionRepresentation\":\"Pin each source release and every reviewed mapping snapshot independently.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
