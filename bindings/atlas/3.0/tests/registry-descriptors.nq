<urn:ref:atlas-source-descriptor:cms-certification-number-authority> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Only identifier shape is captured; a complete public authority file and lifecycle history are outside this registry reader.\",\"identifierRepresentation\":\"Preserve six- or ten-character CMS Certification Numbers as a distinct identifier kind from NPI and validate only the documented shape.\",\"officialLocator\":\"https://www.cms.gov/medicare/health-safety-standards/certification-compliance\",\"resourceId\":\"cms-certification-number-authority\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"definitionOnly\",\"title\":\"CMS Certification Number authority\",\"versionRepresentation\":\"Pin the official identifier definition, observation date, source locator, and validation-rule revision.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
