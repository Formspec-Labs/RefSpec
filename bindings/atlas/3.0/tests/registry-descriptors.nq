<urn:ref:atlas-resource-scheme:nalt-core> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"NALT Core has no single downloadable distribution, and its CC BY 4.0 statement conflicts with broader USDA public-domain or CC0 claims.\",\"identifierRepresentation\":\"Preserve each NALT publisher concept IRI and exact Core scheme membership; refuse NALT Full records and never mint identity from a label.\",\"officialLocator\":\"https://lod.nal.usda.gov/nalt-core/\",\"resourceId\":\"nalt-core\",\"resourceKind\":\"subjectVocabulary\",\"sourceAvailability\":\"partial\",\"title\":\"National Agricultural Library Thesaurus Core\",\"versionRepresentation\":\"Pin every concept response URL, capture time, exact digest, Core scheme assertion, membership coverage, license evidence, and eventual managed-release selection.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
