<urn:ref:atlas-source-descriptor:federal-register-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Some values are API-native observations rather than a separately downloadable controlled list.\",\"identifierRepresentation\":\"Preserve category, presidential subtype, TOC subject, agency, docket, CFR citation, and document-number values as authored.\",\"officialLocator\":\"https://www.federalregister.gov/developers/documentation/api/v1\",\"resourceId\":\"federal-register-native-controls\",\"resourceKind\":\"sourceAssignedVocabulary\",\"sourceAvailability\":\"partial\",\"title\":\"Federal Register native controls\",\"versionRepresentation\":\"Pin endpoint, API capture time, document version, and response digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
