<urn:ref:atlas-source-descriptor:agrovoc> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:agrovoc> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:4e042477fdc4a8c66dab5e8db0cb819563ea2b1e939bbfa710d029e01f3d5ab4" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:agrovoc> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry has one exact publisher concept sample, not a complete release package, and language-specific contributor rights still require reconciliation.\",\"identifierRepresentation\":\"Preserve each AGROVOC publisher concept IRI, multilingual label, and authored SKOS mapping relation without merging AGROVOC identity with NALT.\",\"officialLocator\":\"https://aims.fao.org/aos/agrovoc\",\"resourceId\":\"agrovoc\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"partial\",\"title\":\"AGROVOC multilingual concept scheme\",\"versionRepresentation\":\"Pin the exact AGROVOC distribution or concept response, observation time, byte digest, and applicable language rights evidence.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:agrovoc> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cage-authority> <http://purl.org/dc/terms/identifier> "cage-authority" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cage-authority> <http://purl.org/dc/terms/title> "Defense Logistics Agency CAGE code authority" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cage-authority> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cage-authority> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:36d3e1f355121a2c33d3c2029d61a333e24a1f1377a9294db4eb34360b05bf79" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cage-authority> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The DLA documentation is not reproducibly pinnable in the current environment, and SAM public responses do not publish DLA CAGE status.\",\"identifierRepresentation\":\"Preserve each five-character CAGE code under the Defense Logistics Agency authority and keep association evidence separate from SAM registration status.\",\"officialLocator\":\"https://www.dla.mil/Working-With-DLA/Applications/Details/Article/2920893/cage-code-commercial-and-government-entity-code/\",\"resourceId\":\"cage-authority\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"definitionOnly\",\"title\":\"Defense Logistics Agency CAGE code authority\",\"versionRepresentation\":\"Pin any reproducible official grammar evidence, lookup time, authority-specific record status, and source digest; otherwise retain the definition-only limitation.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cage-authority> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-cost-estimate-feed> <http://purl.org/dc/terms/identifier> "cbo-cost-estimate-feed" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-cost-estimate-feed> <http://purl.org/dc/terms/title> "CBO cost-estimate topics and fiscal facets" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-cost-estimate-feed> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-cost-estimate-feed> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:5d4de012cbc90053b3c84ca5b6bd91ddfd45bd593c03baacccc17333527424ca" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-cost-estimate-feed> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The topic-bearing XML endpoint is blocked by DataDome in the current environment; the verified per-Congress feed omits topics and fiscal facets, so the reconstructed topic-and-facet fixture is not publication-ready evidence.\",\"identifierRepresentation\":\"Preserve each cost-estimate record link, authored topic literal, publisher budget-function code, mandate flag, PAYGO flag, bill value, and committee value without minting topic identity.\",\"officialLocator\":\"https://www.cbo.gov/cost-estimates/xml\",\"resourceId\":\"cbo-cost-estimate-feed\",\"resourceKind\":\"sourceAssignedVocabulary\",\"sourceAvailability\":\"partial\",\"title\":\"CBO cost-estimate topics and fiscal facets\",\"versionRepresentation\":\"Pin the exact feed URL, Congress, capture time, response digest, and parser version; separately identify reconstructed fixtures and verified publisher captures.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-cost-estimate-feed> <https://refspec.org/ns/atlas/v3#memberDisposition> "assignmentEvidenceOnly" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-publication-identifiers> <http://purl.org/dc/terms/identifier> "cbo-publication-identifiers" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-publication-identifiers> <http://purl.org/dc/terms/title> "CBO publication identifiers" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-publication-identifiers> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-publication-identifiers> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:936a0dba6f3ce75234123fe7bae5d30d2c4b845e7cbc99032e095ab47f0960bb" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-publication-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The exact 119th-Congress feed is complete for that captured response but does not cover CBO's full publication history.\",\"identifierRepresentation\":\"Preserve each publisher-issued numeric publication identifier, canonical CBO publication URL, title, date, description, bill value, and exact feed row.\",\"officialLocator\":\"https://www.cbo.gov/rss/119congress-cost-estimates.xml\",\"resourceId\":\"cbo-publication-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"CBO publication identifiers\",\"versionRepresentation\":\"Pin the Congress-specific feed URL, exact response digest, retrieval time, item key, publication identifier, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:cbo-publication-identifiers> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
