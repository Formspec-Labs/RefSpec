<urn:ref:atlas-resource-scheme:oira-review-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:dfc8b6164effafb62cb560e027ca5fad24368a7746917ca8b126c8d15ac69d1b" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:oira-review-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"RegInfo.gov publishes no separate release identifier for the review and meeting value sets, and the enclosing pages contain request-specific session and CSRF values.\",\"identifierRepresentation\":\"Preserve each Review Status, Stage of Rulemaking, Concluded Action, and Meeting Type value with its exact page-specific label and source field.\",\"officialLocator\":\"https://www.reginfo.gov/public/do/eoAdvancedSearch?eoStatusCode=CD\",\"resourceId\":\"oira-review-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"OIRA EO 12866 review and meeting controls\",\"versionRepresentation\":\"Pin each exact control byte span, anchor rule, source page, capture time, digest, option membership, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
