<urn:ref:atlas-source-descriptor:icpsr-subject-thesaurus> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"evidenceOnly\",\"distributions\":[],\"evidence\":[{\"evidencePath\":\"research/evidence/icpsr-managed-release-2026-07-30/evidence.json\",\"identityStatus\":\"publisherConceptIdentitiesPreservedForVerifiedSubset\",\"intendedUses\":[\"mappingReference\",\"searchExpansion\"],\"packageClass\":\"managedConceptRelease\",\"packageDigest\":\"sha256:28030c45eda86882483957b9c3689ad9631627770b28b1ba1bd809cba46e1cd7\"}],\"gap\":\"The current public term index and pinned XML differ in membership; full import must stop until every record joins to an official URI or code.\",\"identifierRepresentation\":\"Official ICPSR numeric code and public term URI; XML record numbers remain source-local evidence.\",\"officialLocator\":\"https://icpsr.umich.edu/web/pages/ICPSR/thesaurus/\",\"resourceId\":\"icpsr-subject-thesaurus\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"availableButUnreconciled\",\"title\":\"ICPSR Subject Thesaurus\",\"versionRepresentation\":\"Pin the XML artifact plus every public index page, capture time, and aggregate digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
