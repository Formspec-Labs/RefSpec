<urn:ref:atlas-resource-scheme:fac-api-dictionary> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The data dictionary documents fields and legacy mappings but does not publish the enumerated values those fields may contain.\",\"identifierRepresentation\":\"Preserve endpoint name, field name, SQL type, legacy Census field, source position, and observation time; do not infer code values from field labels.\",\"officialLocator\":\"https://www.fac.gov/api/dictionary/\",\"resourceId\":\"fac-api-dictionary\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"available\",\"title\":\"Federal Audit Clearinghouse API data dictionary\",\"versionRepresentation\":\"Pin the exact documentation-page capture, retrieval time, digest, endpoint-table membership, and parser version because the page publishes no release identifier.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
