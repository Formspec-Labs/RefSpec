<urn:ref:atlas-resource-scheme:cage-authority> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The DLA documentation is not reproducibly pinnable in the current environment, and SAM public responses do not publish DLA CAGE status.\",\"identifierRepresentation\":\"Preserve each five-character CAGE code under the Defense Logistics Agency authority and keep association evidence separate from SAM registration status.\",\"officialLocator\":\"https://www.dla.mil/Working-With-DLA/Applications/Details/Article/2920893/cage-code-commercial-and-government-entity-code/\",\"resourceId\":\"cage-authority\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"definitionOnly\",\"title\":\"Defense Logistics Agency CAGE code authority\",\"versionRepresentation\":\"Pin any reproducible official grammar evidence, lookup time, authority-specific record status, and source digest; otherwise retain the definition-only limitation.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
