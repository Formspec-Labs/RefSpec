<urn:ref:atlas-source-descriptor:federal-hierarchy> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:6995829cd30b5e5b00ad15b55fcd7b4f634878cb5b784f7db3e0336018aa25ca" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:federal-hierarchy> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The hierarchy changes over time and source systems may expose only partial snapshots.\",\"identifierRepresentation\":\"Preserve official agency and organization identifiers and parent relations.\",\"officialLocator\":\"https://sam.gov/content/federal-hierarchy\",\"resourceId\":\"federal-hierarchy\",\"resourceKind\":\"classification\",\"sourceAvailability\":\"available\",\"title\":\"Federal Hierarchy\",\"versionRepresentation\":\"Pin the source snapshot date, hierarchy artifact, and digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:federal-hierarchy> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
