<urn:ref:atlas-source-descriptor:census-tiger-geoid-structure> <http://purl.org/dc/terms/title> "Census TIGER/Line GEOID structure" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-tiger-geoid-structure> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-tiger-geoid-structure> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:f7f7a054e9c4493f4af85ec4e63d05615af5fa25f45f0d4e3145fbf3eca28c18" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-tiger-geoid-structure> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The identifier structure is documented, but the registry deliberately does not ingest the nationwide geography entity table.\",\"identifierRepresentation\":\"Preserve the publisher's summary-level, geographic-component, state, county, tract, block-group, block, and related GEOID components and concatenation rules.\",\"officialLocator\":\"https://www.census.gov/programs-surveys/geography/guidance/geo-identifiers.html\",\"resourceId\":\"census-tiger-geoid-structure\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"available\",\"title\":\"Census TIGER/Line GEOID structure\",\"versionRepresentation\":\"Pin the exact guidance-page capture, observation date, digest, documented structure rows, and any referenced vintage.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
