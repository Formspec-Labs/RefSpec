<urn:ref:atlas-source-descriptor:ecfr-govinfo-cfr-structure> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"eCFR current state and GovInfo packages have different publication/version behavior that must remain visible.\",\"identifierRepresentation\":\"Preserve official title, chapter, part, section, granule, package, and citation identities.\",\"officialLocator\":\"https://www.ecfr.gov/developers/documentation/api/v1\",\"resourceId\":\"ecfr-govinfo-cfr-structure\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"available\",\"title\":\"eCFR and GovInfo CFR structure\",\"versionRepresentation\":\"Pin point-in-time date or GovInfo package version plus exact artifact digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
