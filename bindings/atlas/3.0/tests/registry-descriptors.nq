<urn:ref:atlas-source-descriptor:unified-agenda-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:b362a7360022acc81ab1e7ccc413bf60dc57497eb23a0523e74946df50e751d8" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:unified-agenda-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"A complete current distribution of all observed stage, priority, agency, and relationship values must be proven from source.\",\"identifierRepresentation\":\"Preserve Unified Agenda codes or authored values and their record context.\",\"officialLocator\":\"https://www.reginfo.gov/public/do/eAgendaMain\",\"resourceId\":\"unified-agenda-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"Unified Agenda native controls\",\"versionRepresentation\":\"Pin agenda edition, record identity, acquisition time, and source artifact digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
