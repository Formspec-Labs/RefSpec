<urn:ref:atlas-resource-scheme:pra-icr-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The scoped page omits JavaScript-populated agency codes and several other search controls; those values remain explicit gaps rather than inferred enumerations.\",\"identifierRepresentation\":\"Preserve OMB Control Number grammar, request type, ICR status, and burden-range field identifiers and values exactly as published.\",\"officialLocator\":\"https://www.reginfo.gov/public/do/PRASearch\",\"resourceId\":\"pra-icr-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"Paperwork Reduction Act ICR search controls\",\"versionRepresentation\":\"Pin the exact PRASearch capture, observation time, artifact digest, scoped control membership, parser version, and declared out-of-scope fields.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
