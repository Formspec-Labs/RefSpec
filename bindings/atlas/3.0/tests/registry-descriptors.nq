<urn:ref:atlas-source-descriptor:grants-gov-status-codes> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The official page publishes eligibility and funding-category tables only; instrument, opportunity-status, and statutory-initiative lists named elsewhere are absent.\",\"identifierRepresentation\":\"Preserve exact Grants.gov eligibility and funding-category codes, labels, source table, and observation time; treat funding categories as publisher-assigned evidence, not managed concepts.\",\"officialLocator\":\"https://www.grants.gov/api/status-codes\",\"resourceId\":\"grants-gov-status-codes\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"Grants.gov eligibility and funding category codes\",\"versionRepresentation\":\"Pin the exact page capture, observation time, artifact digest, complete scoped table counts, parser version, and declared absent-list gaps.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
