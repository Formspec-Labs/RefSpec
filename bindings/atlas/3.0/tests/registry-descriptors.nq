<urn:ref:atlas-resource-scheme:nasbo-state-expenditure-program-areas> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"NASBO publishes program-area labels without stable per-area codes or IRIs, so they remain capture-local mapping references rather than publisher-identified concepts.\",\"identifierRepresentation\":\"Preserve the exact authored program-area heading and source section with no minted identifier.\",\"officialLocator\":\"https://www.nasbo.org/mainsite/reports-data/state-expenditure-report\",\"resourceId\":\"nasbo-state-expenditure-program-areas\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"unresolvedIdentity\",\"title\":\"NASBO State Expenditure Report program areas\",\"versionRepresentation\":\"Pin the report-page edition or observation date, exact capture digest, program-area membership, and any later report-specific mapping review.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
