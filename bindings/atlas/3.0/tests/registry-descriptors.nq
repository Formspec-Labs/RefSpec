<urn:ref:atlas-resource-scheme:treasury-account-symbol-structure> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The source documents the eight-component grammar and page edition but does not publish a separate machine-readable authority table for every valid Treasury Account Symbol.\",\"identifierRepresentation\":\"Preserve the Treasury Account Symbol string and each documented component field without deriving account identity from the account title.\",\"officialLocator\":\"https://fiscal.treasury.gov/accounting/central-accounting-reporting-system-cars/\",\"resourceId\":\"treasury-account-symbol-structure\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"definitionOnly\",\"title\":\"Treasury Account Symbol structure\",\"versionRepresentation\":\"Pin the documentation page edition, exact capture digest, component grammar, supporting component-size authority, observation time, and validation-rule revision.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
