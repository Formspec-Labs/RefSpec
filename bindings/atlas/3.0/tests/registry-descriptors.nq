<urn:ref:atlas-resource-scheme:nppes-npi-authority> <http://purl.org/dc/terms/title> "NPPES National Provider Identifier authority" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:nppes-npi-authority> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#ResourceScheme> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:nppes-npi-authority> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:b615c204e62015f6346b56d614e2be9d4fee15248c83799c30f43481d3963f6e" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:nppes-npi-authority> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry validates National Provider Identifier syntax and a bounded public-file sample; it does not ingest the multi-gigabyte bulk provider registry or licensed NUCC taxonomy values.\",\"identifierRepresentation\":\"Preserve each ten-digit NPI under the NPPES authority and validate its Luhn check digit using the health-industry prefix; never infer provider identity from taxonomy fields.\",\"officialLocator\":\"https://nppes.cms.hhs.gov/\",\"resourceId\":\"nppes-npi-authority\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"NPPES National Provider Identifier authority\",\"versionRepresentation\":\"Pin the official definition and file-vintage evidence, exact bounded sample digest, observation time, identifier validation revision, and sample ceiling.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:nppes-npi-authority> <https://refspec.org/ns/atlas/v3#resourceProfile> <https://refspec.org/ns/atlas/v3#identifierScheme> <urn:ref:atlas-v3:registry-descriptors> .
