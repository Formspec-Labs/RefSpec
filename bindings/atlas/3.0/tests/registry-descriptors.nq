<urn:ref:atlas-source-descriptor:rin-authority> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:f6ef56ee759d4c057e92e388d57b285aa37f84f9799aca306399f5c762012867" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:rin-authority> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The grammar is public, while complete issuance and lifecycle history requires source-specific captures.\",\"identifierRepresentation\":\"Regulation Identifier Number in its official printable form.\",\"officialLocator\":\"https://www.reginfo.gov/public/jsp/Utilities/faq.myjsp\",\"resourceId\":\"rin-authority\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"definitionOnly\",\"title\":\"Regulation Identifier Number authority\",\"versionRepresentation\":\"Pin the official grammar definition and the exact source observation date.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:rin-authority> <https://refspec.org/ns/atlas/v3#memberDisposition> "assignmentEvidenceOnly" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-assistance-listing-controls> <http://purl.org/dc/terms/identifier> "sam-assistance-listing-controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-assistance-listing-controls> <http://purl.org/dc/terms/title> "SAM.gov Assistance Listings controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-assistance-listing-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-assistance-listing-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:0cb362c5bc97f35c816b7080a2e6793334da17c869d7aeb88dfc7b209793a3cf" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-assistance-listing-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The documentation publishes assistance, applicant, and beneficiary type tables, while mission and subject values are record-level evidence outside this reader and several referenced restrictions have no list.\",\"identifierRepresentation\":\"Preserve each official assistance type, eligible applicant type, and eligible beneficiary type code and label with source table and interface version.\",\"officialLocator\":\"https://open.gsa.gov/api/assistance-listings-api/\",\"resourceId\":\"sam-assistance-listing-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"SAM.gov Assistance Listings controls\",\"versionRepresentation\":\"Pin the documentation interface version, exact page capture and digest, complete scoped table counts, parser version, and documented schema inconsistencies.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:sam-assistance-listing-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
