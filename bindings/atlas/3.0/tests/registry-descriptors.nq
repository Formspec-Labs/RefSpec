<urn:ref:atlas-source-descriptor:federal-legislative-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The authorities are separately maintained and require exact source-specific version evidence.\",\"identifierRepresentation\":\"Preserve BioGuide, committee, bill, and related legislative identifiers in their native authorities.\",\"officialLocator\":\"https://bioguide.congress.gov/\",\"resourceId\":\"federal-legislative-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"available\",\"title\":\"Federal legislative identifier authorities\",\"versionRepresentation\":\"Pin each authority capture date, source locator, and digest independently.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
