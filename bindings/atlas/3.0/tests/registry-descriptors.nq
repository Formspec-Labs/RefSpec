<urn:ref:atlas-source-descriptor:ecfr-cfr-structure> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The current-title roster and point-in-time structure endpoints have different version behavior; observed node-type values are not a separately published closed enumeration.\",\"identifierRepresentation\":\"Preserve CFR title, chapter, subchapter, part, subpart, subject-group, section, appendix, and heading identities with their point-in-time source context.\",\"officialLocator\":\"https://www.ecfr.gov/developers/documentation/api/v1\",\"resourceId\":\"ecfr-cfr-structure\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"available\",\"title\":\"eCFR title and provision structure\",\"versionRepresentation\":\"Pin each point-in-time date, endpoint and query, exact response digest, title currency fields, and observed-versus-authoritative structure coverage.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
