<urn:ref:atlas-resource-scheme:opm-ehri-workforce-codes> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The current package fixtures are documented-shape samples, not verified full OPM captures; publication must use the complete official EHRI workbook and retain its edition.\",\"identifierRepresentation\":\"Preserve official pay-plan, work-schedule, appointment-type, and occupational-series codes with source sheet, label, status, and effective context.\",\"officialLocator\":\"https://data.opm.gov/data-standards/ehri-data-standards\",\"resourceId\":\"opm-ehri-workforce-codes\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"OPM EHRI workforce codes\",\"versionRepresentation\":\"Pin the complete workbook edition, source URL, capture time, artifact digest, sheet membership and counts, parser version, and any sample-versus-production limitation.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
