<urn:ref:atlas-resource-scheme:uei-authority> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Public SAM responses are bounded samples and do not provide complete entity history; a UEI must remain distinct from associated CAGE identifiers.\",\"identifierRepresentation\":\"Preserve the official twelve-character Unique Entity ID, SAM registration status, source record, and authority type exactly.\",\"officialLocator\":\"https://sam.gov/entity-registration\",\"resourceId\":\"uei-authority\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"SAM.gov Unique Entity ID authority\",\"versionRepresentation\":\"Pin the official grammar documentation, exact bounded public API response, record status, capture time, digest, and sample ceiling.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
