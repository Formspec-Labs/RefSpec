<urn:ref:atlas-source-descriptor:epa-substance-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry captures identifier syntax and a bounded sample, not the bulk SRS, CompTox, DSSTox, or TSCA inventories.\",\"identifierRepresentation\":\"Preserve DTXSID substance identifiers and DTXCID structure identifiers as separate kinds; retain TSCA membership as status and never merge identity by label or CAS number.\",\"officialLocator\":\"https://sor.epa.gov/sor_internet/registry/sysofreg/sorservices/sorServices.html\",\"resourceId\":\"epa-substance-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"EPA SRS and CompTox substance identifiers\",\"versionRepresentation\":\"Pin each source endpoint or documentation capture, observation time, digest, identifier-shape revision, and bounded sample coverage.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:epa-substance-identifiers> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:eurovoc> <http://purl.org/dc/terms/identifier> "eurovoc" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:eurovoc> <http://purl.org/dc/terms/title> "EuroVoc multilingual thesaurus" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:eurovoc> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:eurovoc> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:f00da624d3127579cd7f7c23b1c2caa39998e5a126249d7e04a1ef57e543d880" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:eurovoc> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry contains a pinned mapping sample, not a reconciled complete EuroVoc release, and search-expansion use remains evaluation-gated.\",\"identifierRepresentation\":\"Preserve EuroVoc domain, micro-thesaurus, and concept identifiers exactly; keep domain records distinct even when the source also types them as SKOS concepts.\",\"officialLocator\":\"https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://eurovoc.europa.eu/100141\",\"resourceId\":\"eurovoc\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"partial\",\"title\":\"EuroVoc multilingual thesaurus\",\"versionRepresentation\":\"Pin the exact EuroVoc release or export version, source artifact, digest, language coverage, and selected mapping scope.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:eurovoc> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fac-api-dictionary> <http://purl.org/dc/terms/identifier> "fac-api-dictionary" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fac-api-dictionary> <http://purl.org/dc/terms/title> "Federal Audit Clearinghouse API data dictionary" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fac-api-dictionary> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fac-api-dictionary> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:fdb102183d5303c6e03a426b4b9103c4195592150c3a8c432f6398dafaf6ef3d" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fac-api-dictionary> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The data dictionary documents fields and legacy mappings but does not publish the enumerated values those fields may contain.\",\"identifierRepresentation\":\"Preserve endpoint name, field name, SQL type, legacy Census field, source position, and observation time; do not infer code values from field labels.\",\"officialLocator\":\"https://www.fac.gov/api/dictionary/\",\"resourceId\":\"fac-api-dictionary\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"available\",\"title\":\"Federal Audit Clearinghouse API data dictionary\",\"versionRepresentation\":\"Pin the exact documentation-page capture, retrieval time, digest, endpoint-table membership, and parser version because the page publishes no release identifier.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fac-api-dictionary> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fast-topical> <http://purl.org/dc/terms/identifier> "fast-topical" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fast-topical> <http://purl.org/dc/terms/title> "OCLC FAST Topical facet" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fast-topical> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fast-topical> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:30fda6495bdf14d75f8d973f98bace928104594690837eb2715b98e0a90fe6f2" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fast-topical> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The current registry has exact publisher samples and change records but no complete, reproducible frontier release suitable for atlas membership.\",\"identifierRepresentation\":\"Preserve each OCLC FAST identifier and id.worldcat.org URI plus publisher-authored LCSH derivation links; never replace LCSH identity with FAST identity.\",\"officialLocator\":\"https://www.oclc.org/research/areas/data-science/fast/download.html\",\"resourceId\":\"fast-topical\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"partial\",\"title\":\"OCLC FAST Topical facet\",\"versionRepresentation\":\"Pin the exact bulk snapshot or bounded frontier, chronological change files, source digests, ODC-BY attribution, coverage receipt, and conversion-rule version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fast-topical> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
