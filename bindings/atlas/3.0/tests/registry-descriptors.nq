<urn:ref:atlas-source-descriptor:gemet> <http://purl.org/dc/terms/title> "GEMET multilingual environmental thesaurus" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gemet> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gemet> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:7501542cc8245b4c1bff1b74ac240b996c229d36299d2dcdfc5f9c4c63aa9d2f" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gemet> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"A complete publisher distribution is available, but atlas specialist use still requires a managed release, United States regulatory-text holdout, and strong abstention gate.\",\"identifierRepresentation\":\"Preserve GEMET publisher concept and scheme IRIs, multilingual labels, and authored SKOS relations without modeling collection and bibliographic records as concepts.\",\"officialLocator\":\"https://www.eionet.europa.eu/gemet/en/exports/rdf/latest\",\"resourceId\":\"gemet\",\"resourceKind\":\"subjectVocabulary\",\"sourceAvailability\":\"available\",\"title\":\"GEMET multilingual environmental thesaurus\",\"versionRepresentation\":\"Pin GEMET release 4.2.3 or its successor by compressed and decompressed digests, byte lengths, source URL, license, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gemet> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:governmentwide-spending-data-model> <http://purl.org/dc/terms/identifier> "governmentwide-spending-data-model" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:governmentwide-spending-data-model> <http://purl.org/dc/terms/title> "Governmentwide Spending Data Model" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:governmentwide-spending-data-model> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:governmentwide-spending-data-model> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:41123e760e2e61e8d322da315479e35e1c094fd087b90df05ac87e3e29204422" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:governmentwide-spending-data-model> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The architecture document defines the model while the separately maintained online data dictionary supplies element domains; only the catalog-scoped elements are curated here.\",\"identifierRepresentation\":\"Preserve each Governmentwide Spending Data Model element name, version, mapped submission or download field, and reviewed domain values as schema facts.\",\"officialLocator\":\"https://fiscal.treasury.gov/files/data-transparency/gsdm-architecture-v1.0.1.pdf\",\"resourceId\":\"governmentwide-spending-data-model\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"available\",\"title\":\"Governmentwide Spending Data Model\",\"versionRepresentation\":\"Pin GSDM version 1.0.1, exact architecture-document digest, online data-dictionary capture or pin, selected element scope, and review revision.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:governmentwide-spending-data-model> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
