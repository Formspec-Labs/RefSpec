<urn:ref:atlas-source-descriptor:federal-register-api-topics> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"evidenceOnly\",\"distributions\":[],\"evidence\":[{\"evidencePath\":\"research/evidence/federal-register-topics-source-package-2026-08-04/evidence.json\",\"identityStatus\":\"captureLocalObservationsOnly\",\"intendedUses\":[\"sourceAssignedEvidence\"],\"packageClass\":\"sourceControlledResource\",\"packageDigest\":\"sha256:4a8da29052cf18ed20dc21ef75bd5800264c60865a0bbee914231e212f22ced4\"}],\"gap\":\"The API exposes mutable source assignments, not a complete versioned thesaurus distribution; do not merge it with the 2025 release.\",\"identifierRepresentation\":\"Source topic strings and record links are evidence until official concept identifiers are available.\",\"officialLocator\":\"https://www.federalregister.gov/developers/documentation/api/v1\",\"resourceId\":\"federal-register-api-topics\",\"resourceKind\":\"sourceAssignedVocabulary\",\"sourceAvailability\":\"availableButUnreconciled\",\"title\":\"Federal Register API topics\",\"versionRepresentation\":\"Capture time, endpoint, query, record identity, and response digest pin each observation.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
