<urn:ref:atlas-resource-scheme:unified-agenda-legal-authority-citations> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"LEGAL_AUTHORITY remains unrestricted free text; only three citation-type prefixes are documented, and no row establishes a resolved legal identity or legal-effect edge by itself.\",\"identifierRepresentation\":\"Preserve the exact authored legal-authority citation, source ordinal, and any documented U.S.C., Public Law, or Executive Order prefix classification without rewriting the citation.\",\"officialLocator\":\"https://www.reginfo.gov/public/jsp/eAgenda/StaticContent/202210/RiscPreamble.pdf\",\"resourceId\":\"unified-agenda-legal-authority-citations\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"Unified Agenda legal authority citations\",\"versionRepresentation\":\"Pin the agenda edition, exact RISC Preamble artifact and digest, source record identity, observation time, citation text, classifier revision, and unresolved values.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
