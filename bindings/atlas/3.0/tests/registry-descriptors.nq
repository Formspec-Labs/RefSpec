<urn:ref:atlas-source-descriptor:epa-enterprise-vocabulary> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Only one topic-tier export is captured; current edition, complete membership, maintenance history, durable bulk access, license, and stable term identifiers remain unverified.\",\"identifierRepresentation\":\"Preserve exact labels, definitions, scope notes, child nesting, and positional source paths; the source exports no stable term code or IRI, so mint none.\",\"officialLocator\":\"https://www.epa.gov/research/epa-enterprise-vocabulary\",\"resourceId\":\"epa-enterprise-vocabulary\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"unresolvedIdentity\",\"title\":\"EPA Enterprise Vocabulary\",\"versionRepresentation\":\"Pin the landing-page claims, selected tier, export request, observation time, exact XML digest, and all unresolved edition, access, license, and identity gaps.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
