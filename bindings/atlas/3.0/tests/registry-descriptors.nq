<urn:ref:atlas-resource-scheme:nasa-thesaurus> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The distribution states no explicit reuse license, and specialist adoption still requires freshness confirmation, a managed release, and a measured holdout.\",\"identifierRepresentation\":\"Preserve NASA's same-document concept, relation, and note identifiers exactly; do not invent a concept scheme or connect detached annotations by matching local strings.\",\"officialLocator\":\"https://sti.nasa.gov/nasa-thesaurus/\",\"resourceId\":\"nasa-thesaurus\",\"resourceKind\":\"subjectVocabulary\",\"sourceAvailability\":\"availableButUnreconciled\",\"title\":\"NASA Thesaurus\",\"versionRepresentation\":\"Pin the exact SKOS/RDF distribution URL, byte length, digest, capture or content date, attribution statement, parser version, and eventual managed-release coverage.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
