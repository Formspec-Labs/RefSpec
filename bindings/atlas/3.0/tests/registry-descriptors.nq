<urn:ref:atlas-source-descriptor:treasury-fast-book> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:fc10eb93d430d33e3d88445c2edf8457818cf3f6dbd107afa184d5b34a5e377a" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:treasury-fast-book> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Parts II and III are machine-readable while Part I remains a formatted PDF; page bytes also contain request-specific analytics tokens, so captures are dated observations.\",\"identifierRepresentation\":\"Preserve each official FAST Book Treasury account symbol, title, part, and fund group exactly; never mint concept identity from an account title.\",\"officialLocator\":\"https://fiscal.treasury.gov/accounting/fast-book/description-of-contents\",\"resourceId\":\"treasury-fast-book\",\"resourceKind\":\"classification\",\"sourceAvailability\":\"partial\",\"title\":\"Federal Account Symbols and Titles Book\",\"versionRepresentation\":\"Pin the page's Last Updated date, exact page capture, official workbook and digest, part coverage, complete parsed row counts, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:treasury-fast-book> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:uei-authority> <http://purl.org/dc/terms/identifier> "uei-authority" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:uei-authority> <http://purl.org/dc/terms/title> "SAM.gov Unique Entity ID authority" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:uei-authority> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:uei-authority> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:4b3f742a3778d02f0dbe956b1f22373965bbb6a19a737fc3e87bcae40768e441" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:uei-authority> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Public SAM responses are bounded samples and do not provide complete entity history; a UEI must remain distinct from associated CAGE identifiers.\",\"identifierRepresentation\":\"Preserve the official twelve-character Unique Entity ID, SAM registration status, source record, and authority type exactly.\",\"officialLocator\":\"https://sam.gov/entity-registration\",\"resourceId\":\"uei-authority\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"SAM.gov Unique Entity ID authority\",\"versionRepresentation\":\"Pin the official grammar documentation, exact bounded public API response, record status, capture time, digest, and sample ceiling.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:uei-authority> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:unified-agenda-legal-authority-citations> <http://purl.org/dc/terms/identifier> "unified-agenda-legal-authority-citations" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:unified-agenda-legal-authority-citations> <http://purl.org/dc/terms/title> "Unified Agenda legal authority citations" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:unified-agenda-legal-authority-citations> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:unified-agenda-legal-authority-citations> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:ef38f18f0aeac058b3db5368f4ecb085be3ce7ce0224610259c19f54b4483f9c" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:unified-agenda-legal-authority-citations> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"LEGAL_AUTHORITY remains unrestricted free text; only three citation-type prefixes are documented, and no row establishes a resolved legal identity or legal-effect edge by itself.\",\"identifierRepresentation\":\"Preserve the exact authored legal-authority citation, source ordinal, and any documented U.S.C., Public Law, or Executive Order prefix classification without rewriting the citation.\",\"officialLocator\":\"https://www.reginfo.gov/public/jsp/eAgenda/StaticContent/202210/RiscPreamble.pdf\",\"resourceId\":\"unified-agenda-legal-authority-citations\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"Unified Agenda legal authority citations\",\"versionRepresentation\":\"Pin the agenda edition, exact RISC Preamble artifact and digest, source record identity, observation time, citation text, classifier revision, and unresolved values.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
