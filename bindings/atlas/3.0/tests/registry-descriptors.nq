<urn:ref:atlas-source-descriptor:regulations-gov-native-controls> <http://purl.org/dc/terms/title> "Regulations.gov native controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:regulations-gov-native-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:regulations-gov-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:5eade42d0ff9c9570bd6a98a743acd2f971074e3af3395e1f9869b050f2fa738" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:regulations-gov-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The source schemas and live value sets must be captured together so unpublished values cannot enter silently.\",\"identifierRepresentation\":\"Preserve Regulations.gov docket, document, comment, attachment, agency, docket-ID, and Federal Register-number values.\",\"officialLocator\":\"https://open.gsa.gov/api/regulationsgov/\",\"resourceId\":\"regulations-gov-native-controls\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"available\",\"title\":\"Regulations.gov native controls\",\"versionRepresentation\":\"Pin API version, schema or OpenAPI artifact, capture time, and artifact digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:regulations-gov-native-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
