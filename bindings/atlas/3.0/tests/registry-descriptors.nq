<urn:ref:atlas-resource-scheme:nrc-adams-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:952570d324667c425234263cbc3d75bd4181d3a7cb1627379584e24b800daf2d" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:nrc-adams-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"ADAMS publishes no dedicated constants endpoint; result-field and library-facet labels are snapshot observations from the current search application, not publisher-asserted exhaustive lists.\",\"identifierRepresentation\":\"Preserve each observed search field, library facet, and reference-category label with exact source asset and position; do not mint concept identity.\",\"officialLocator\":\"https://www.nrc.gov/reading-rm/adams\",\"resourceId\":\"nrc-adams-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"NRC ADAMS public-search controls\",\"versionRepresentation\":\"Pin the exact NRC pages and application asset, full-asset and excerpt digests, capture time, observed membership, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
