<urn:ref:atlas-source-descriptor:fcc-ecfs-native-controls> <http://purl.org/dc/terms/title> "FCC ECFS native controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fcc-ecfs-native-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fcc-ecfs-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:dcb62600b447cc44f73abba9085464393a1f692df7c66c02be622eb6d993f94d" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fcc-ecfs-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"ECFS source fields and local genre mappings are separate; no maintained FCC topic thesaurus is known.\",\"identifierRepresentation\":\"Preserve proceeding, submission, bureau, status, attachment, filer, and author values with source field.\",\"officialLocator\":\"https://www.fcc.gov/ecfs/public-api-docs.html\",\"resourceId\":\"fcc-ecfs-native-controls\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"partial\",\"title\":\"FCC ECFS native controls\",\"versionRepresentation\":\"Pin API version, record version, capture time, response digest, and local genre-map version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fcc-ecfs-native-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
