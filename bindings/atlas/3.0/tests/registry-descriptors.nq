<urn:ref:atlas-resource-scheme:nrc-adams-identifiers> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:3446b1ad510a627ed47aa1f38d9d16775b132ce227a20c607c12cd0c26b3ed27" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:nrc-adams-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Legacy accession and docket shapes are documented, while the current ML accession shape is inferred only from publisher examples and no complete identifier authority file is published.\",\"identifierRepresentation\":\"Preserve NRC docket, Public Legacy Library accession, and current ML accession identifiers as distinct documented or source-observed shapes with explicit basis.\",\"officialLocator\":\"https://www.nrc.gov/reading-rm/adams/faq.html\",\"resourceId\":\"nrc-adams-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"definitionOnly\",\"title\":\"NRC ADAMS docket and accession identifiers\",\"versionRepresentation\":\"Pin each defining page or example capture, observation time, digest, identifier-shape basis, validation-rule revision, and known documentation gaps.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-resource-scheme:nrc-adams-identifiers> <https://refspec.org/ns/atlas/v3#resourceProfile> <https://refspec.org/ns/atlas/v3#identifierScheme> <urn:ref:atlas-v3:registry-descriptors> .
