<urn:ref:atlas-source-descriptor:federal-register-thesaurus-2025> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"evidenceOnly\",\"distributions\":[],\"evidence\":[{\"evidencePath\":\"research/evidence/federal-register-thesaurus-2025-managed-release-2026-07-30/evidence.json\",\"identityStatus\":\"projectManagedConceptIdentityFromExactPublisherSource\",\"intendedUses\":[\"federalRegisterDefaultSubjectCandidate\",\"mappingReference\",\"searchExpansion\"],\"packageClass\":\"managedConceptRelease\",\"packageDigest\":\"sha256:3491acfdb3c4b51fda6351fcc47c2ca13e63e9df99e30399e05f745c97bf9df6\"}],\"gap\":\"The official styled PDF is packaged with a pinned digest, a checked semantic extract, and explicit source anomalies.\",\"identifierRepresentation\":\"RefSpec-managed concept IRIs use source-local term ordinals from the exact April 1, 2025 publication.\",\"officialLocator\":\"https://www.archives.gov/files/federal-register/cfr/thesaurus-4-1-2025.pdf\",\"resourceId\":\"federal-register-thesaurus-2025\",\"resourceKind\":\"subjectVocabulary\",\"sourceAvailability\":\"available\",\"title\":\"Federal Register Thesaurus of Indexing Terms, April 1, 2025\",\"versionRepresentation\":\"Managed release pins the April 1, 2025 publication, exact PDF digest, parser, source extract, and coverage report.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
