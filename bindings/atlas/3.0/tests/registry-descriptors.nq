<urn:ref:atlas-source-descriptor:fec-native-controls> <http://purl.org/dc/terms/title> "Federal Election Commission native controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fec-native-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fec-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:b2f7ae3247973f013ac4bb4a9d3976d2dc4127527ef0a6ffa583e083ef56f035" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fec-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Code definitions and committee records are time-varying; exact effective dates must remain attached.\",\"identifierRepresentation\":\"Preserve FEC committee ID and native committee, designation, organization, party, sponsor, and candidate codes.\",\"officialLocator\":\"https://api.open.fec.gov/developers/\",\"resourceId\":\"fec-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"available\",\"title\":\"Federal Election Commission native controls\",\"versionRepresentation\":\"Pin API version, cycle, effective date, capture time, and response digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:fec-native-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
