<urn:ref:atlas-resource-scheme:doe-osti-semantic-thesaurus-2020> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The verified public export is from 2020, embeds no release metadata or license, and no newer public release or changelog has been verified.\",\"identifierRepresentation\":\"Preserve each DOE OSTI publisher concept IRI and authored SKOS relation; never infer currency or licensing from the identifier.\",\"officialLocator\":\"https://www.osti.gov/dataexplorer/biblio/dataset/1668761\",\"resourceId\":\"doe-osti-semantic-thesaurus-2020\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"availableButUnreconciled\",\"title\":\"DOE OSTI Semantic Thesaurus v1, 2020\",\"versionRepresentation\":\"Pin dataset identifier 1668761, DOI, publication date 2020-09-30, exact RDF digest and byte length, and the unresolved currency and license findings.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
