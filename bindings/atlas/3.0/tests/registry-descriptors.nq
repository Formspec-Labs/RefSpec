<urn:ref:atlas-source-descriptor:congress-billstatus-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Congress.gov API and BILLSTATUS files must remain source/version-specific when their fields differ.\",\"identifierRepresentation\":\"Preserve official bill, action, version, committee, and package identities.\",\"officialLocator\":\"https://api.congress.gov/\",\"resourceId\":\"congress-billstatus-native-controls\",\"resourceKind\":\"structuralSchema\",\"sourceAvailability\":\"available\",\"title\":\"Congress API and BILLSTATUS controls\",\"versionRepresentation\":\"Pin API version or BILLSTATUS bulk-data date and artifact digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
