<urn:ref:atlas-resource-scheme:opm-plum-position-status-codes> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The current package fixture is an unverified documented-shape sample; PLUM releases also carry statutory redaction, agency-certification, and vintage rules.\",\"identifierRepresentation\":\"Preserve PLUM appointment-authority and incumbent-status marker values exactly without inferring redacted incumbent identity.\",\"officialLocator\":\"https://www.opm.gov/about-us/open-government/plum-reporting/plum-data/\",\"resourceId\":\"opm-plum-position-status-codes\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"OPM PLUM position status codes\",\"versionRepresentation\":\"Pin the exact PLUM release vintage, certified source file, capture time, digest, code membership, redaction rules, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
