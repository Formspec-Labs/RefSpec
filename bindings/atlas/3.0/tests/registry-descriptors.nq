<urn:ref:atlas-source-descriptor:ferc-elibrary-identifiers> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:6a13eb94bbf0db0d53ebf35369f693b399699cea86e2806ad0074cf779ab0896" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:ferc-elibrary-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The source documents accession-number format and docket-prefix values, but it does not provide a separately versioned authority file for all filing identifiers.\",\"identifierRepresentation\":\"Preserve FERC accession-number grammar and docket-prefix code as distinct identifier components with their exact official source.\",\"officialLocator\":\"https://elibrary.ferc.gov/eLibraryhelp/General_Search.htm\",\"resourceId\":\"ferc-elibrary-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"definitionOnly\",\"title\":\"FERC eLibrary filing identifiers\",\"versionRepresentation\":\"Pin the exact search-help and docket-prefix publications, observation date, digests, and identifier-shape parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:ferc-elibrary-identifiers> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:ferc-elibrary-native-controls> <http://purl.org/dc/terms/identifier> "ferc-elibrary-native-controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:ferc-elibrary-native-controls> <http://purl.org/dc/terms/title> "FERC eLibrary native controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:ferc-elibrary-native-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:ferc-elibrary-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:77a1276a38666870756832742e74fc0bde269f616e3d70a2b658bd25eaa48b89" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:ferc-elibrary-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Some legacy package paths still rely on a constructed compatibility fixture; only the separately pinned class/type and docket-prefix publications count as current source evidence.\",\"identifierRepresentation\":\"Preserve FERC document class, document type, sector, security-level, and docket-prefix codes exactly with source family and effective status.\",\"officialLocator\":\"https://www.ferc.gov/media/elibrary-classtype-information\",\"resourceId\":\"ferc-elibrary-native-controls\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"FERC eLibrary native controls\",\"versionRepresentation\":\"Pin each official PDF or help-page publication independently by edition, capture time, exact digest, complete row count, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:ferc-elibrary-native-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:frn-authority> <http://purl.org/dc/terms/identifier> "frn-authority" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:frn-authority> <http://purl.org/dc/terms/title> "FCC Registration Number authority" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:frn-authority> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:frn-authority> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:f7e40104ca14e464f7eabd0ad6891123576e63179885eac3aa415ac77e630ea8" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:frn-authority> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"FRNs identify registrants, not topical concepts, and resolution evidence must remain source-specific.\",\"identifierRepresentation\":\"Official FCC Registration Number.\",\"officialLocator\":\"https://apps.fcc.gov/cores/userLogin.do\",\"resourceId\":\"frn-authority\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"available\",\"title\":\"FCC Registration Number authority\",\"versionRepresentation\":\"Pin source record status, lookup time, and authority evidence.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:frn-authority> <https://refspec.org/ns/atlas/v3#memberDisposition> "noPublisherRecord" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-cra-database-facets> <http://purl.org/dc/terms/identifier> "gao-cra-database-facets" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-cra-database-facets> <http://purl.org/dc/terms/title> "GAO Congressional Review Act database facets" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-cra-database-facets> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-cra-database-facets> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:cc57f0ae432d6f8d6a9a8af373644d9ce9aa0b632c397f1f35d2d807f0235d01" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-cra-database-facets> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The real page confirms priority and type controls, while exhaustive query-slug and processed-state behavior still needs a rendered-page capture and review.\",\"identifierRepresentation\":\"Preserve the exact GAO query value, visible label, source field, and capture identity; do not invent a subject concept from a search facet.\",\"officialLocator\":\"https://www.gao.gov/legal/congressional-review-act/search-database-rules\",\"resourceId\":\"gao-cra-database-facets\",\"resourceKind\":\"codeList\",\"sourceAvailability\":\"partial\",\"title\":\"GAO Congressional Review Act database facets\",\"versionRepresentation\":\"Pin the exact rendered source capture, observation time, digest, form field, option membership, and unresolved query-behavior gaps.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-cra-database-facets> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-native-controls> <http://purl.org/dc/terms/identifier> "gao-native-controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-native-controls> <http://purl.org/dc/terms/title> "GAO report native controls" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-native-controls> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-native-controls> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:5a8bc372a2a69b4bfb5768b0de1c1b11061ec2c2bd4f977217594409361b3183" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-native-controls> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"GAO report controls are record-derived; exact enumerations may require bounded source captures.\",\"identifierRepresentation\":\"Preserve report ID, product type, agency, recommendation state, and evidence-depth values.\",\"officialLocator\":\"https://www.gao.gov/reports-testimonies\",\"resourceId\":\"gao-native-controls\",\"resourceKind\":\"sourceAssignedVocabulary\",\"sourceAvailability\":\"partial\",\"title\":\"GAO report native controls\",\"versionRepresentation\":\"Pin report edition, source fields, capture time, and artifact digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-native-controls> <https://refspec.org/ns/atlas/v3#memberDisposition> "assignmentEvidenceOnly" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-report-identifiers> <http://purl.org/dc/terms/identifier> "gao-report-identifiers" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-report-identifiers> <http://purl.org/dc/terms/title> "GAO report identifiers" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-report-identifiers> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-report-identifiers> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:69b8d9a10b82880e8f7fe065fae0bfca5d42dd3b2773b3b84a657279e1dca834" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-report-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry has one exact report-page capture, not GAO's complete publication history.\",\"identifierRepresentation\":\"Preserve the publisher-issued GAO report number, canonical product URL, title, publication date, and exact source record as distinct identity evidence.\",\"officialLocator\":\"https://www.gao.gov/products/\",\"resourceId\":\"gao-report-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"GAO report identifiers\",\"versionRepresentation\":\"Pin each exact product-page capture, report number, canonical URL, publication date, retrieval time, and source digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-report-identifiers> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-thesaurus-historical> <http://purl.org/dc/terms/identifier> "gao-thesaurus-historical" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-thesaurus-historical> <http://purl.org/dc/terms/title> "GAO Thesaurus" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-thesaurus-historical> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-thesaurus-historical> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:0b71ab3fefe0ea8d95400099ee3472924ec4a061f2ea748c59bf8175f1e2696a" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-thesaurus-historical> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The historical publication is not a maintained authority and is mapping-only unless a successor appears.\",\"identifierRepresentation\":\"Preserve historical source entries and identifiers without promoting them to current selectable concepts.\",\"officialLocator\":\"GAO Thesaurus, 1998 publication\",\"resourceId\":\"gao-thesaurus-historical\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"historicalOnly\",\"title\":\"GAO Thesaurus\",\"versionRepresentation\":\"Pin the 1998 edition and exact scanned or machine-readable artifact digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-thesaurus-historical> <https://refspec.org/ns/atlas/v3#memberDisposition> "historicalEvidenceOnly" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-topics> <http://purl.org/dc/terms/identifier> "gao-topics" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-topics> <http://purl.org/dc/terms/title> "GAO report topics" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-topics> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-topics> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:fd2c7813cb33cbbb1157fc39deef1bf2a3cb5c5ddf85aa7756b8a4c91b257d13" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-topics> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"GAO topics are source assignments and no complete maintained reusable thesaurus distribution is known.\",\"identifierRepresentation\":\"Preserve the exact topic literal and report assignment context.\",\"officialLocator\":\"https://www.gao.gov/reports-testimonies\",\"resourceId\":\"gao-topics\",\"resourceKind\":\"sourceAssignedVocabulary\",\"sourceAvailability\":\"partial\",\"title\":\"GAO report topics\",\"versionRepresentation\":\"Pin report identity, edition or publication date, capture time, and source digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gao-topics> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gcmd-science-keywords> <http://purl.org/dc/terms/identifier> "gcmd-science-keywords" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gcmd-science-keywords> <http://purl.org/dc/terms/title> "NASA GCMD Science Keywords" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gcmd-science-keywords> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gcmd-science-keywords> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:2e015c01232601e96ee60d5489a1ffdab43b38b6f4c288cff7dfe28955a111e8" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gcmd-science-keywords> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry packages a bounded source-evidence sample and does not yet publish a complete managed atlas frontier or demonstrate document-subject value.\",\"identifierRepresentation\":\"Preserve every GCMD publisher concept UUID, authored path label, category, and version; exclude separately governed instrument, platform, project, and provider schemes.\",\"officialLocator\":\"https://gcmd.earthdata.nasa.gov/KeywordViewer/scheme/sciencekeywords/27478148-b4b6-4c89-8829-08d2ee7bfe10/\",\"resourceId\":\"gcmd-science-keywords\",\"resourceKind\":\"mappingReference\",\"sourceAvailability\":\"partial\",\"title\":\"NASA GCMD Science Keywords\",\"versionRepresentation\":\"Pin the exact keyword version, revision date, CSV bytes, source digest, concept-scheme UUID, coverage statement, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:gcmd-science-keywords> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
