<urn:ref:atlas-source-descriptor:cfr-list-of-subjects> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Resolve each literal as an official term, recognized variant, source-local open term, or unresolved value; never mint a managed concept implicitly.\",\"identifierRepresentation\":\"Preserve the exact CFR part identity, authored literal, resolution class, matched managed identity when present, and source location.\",\"officialLocator\":\"https://www.ecfr.gov/current/title-1/chapter-I/subchapter-A/part-3/subpart-B/section-3.12\",\"resourceId\":\"cfr-list-of-subjects\",\"resourceKind\":\"sourceAssignedVocabulary\",\"sourceAvailability\":\"partial\",\"title\":\"CFR List of Subjects assignments\",\"versionRepresentation\":\"Pin CFR title, part, edition or point-in-time date, source artifact, and digest.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
