<urn:ref:atlas-source-descriptor:census-acs-geography-identifiers> <http://purl.org/dc/terms/title> "Census ACS geography identifier fields" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-acs-geography-identifiers> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-acs-geography-identifiers> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:489665e42a4d2bb456537ab3a43867987694894624382a3b6dee30cda279f572" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-acs-geography-identifiers> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The registry pins reviewed byte spans and a representative field subset rather than the full mutable variables table.\",\"identifierRepresentation\":\"Preserve ACS variable names and geography predicate fields exactly as publisher-issued structural identifiers; do not treat variable labels as entity identities.\",\"officialLocator\":\"https://api.census.gov/data/2024/acs/acs1/spp/variables.html\",\"resourceId\":\"census-acs-geography-identifiers\",\"resourceKind\":\"identifierAuthority\",\"sourceAvailability\":\"partial\",\"title\":\"Census ACS geography identifier fields\",\"versionRepresentation\":\"Pin the ACS product vintage, exact captured byte spans, observation time, source digest, and promoted-versus-excluded coverage counts.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-acs-geography-identifiers> <https://refspec.org/ns/atlas/v3#memberDisposition> "memberRelease" <urn:ref:atlas-v3:registry-descriptors> .
