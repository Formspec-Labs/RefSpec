<urn:ref:atlas-source-descriptor:specialist-subject-modules> <http://purl.org/dc/terms/title> "Measured specialist subject modules" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:specialist-subject-modules> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:specialist-subject-modules> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:2958776ad507594dbc5ffd5f7433716b50d8afba23158f42508353d59050b5fd" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:specialist-subject-modules> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"Each specialist scheme is admitted only after measured misses justify it and its own acquisition is reproducible.\",\"identifierRepresentation\":\"Each member keeps its publisher-owned concept identifiers; the family mints no shared identities.\",\"officialLocator\":\"RefSpec/plans/active-profile-controlled-resource-import-plan.md\",\"resourceId\":\"specialist-subject-modules\",\"resourceKind\":\"resourceFamily\",\"sourceAvailability\":\"plannedFamily\",\"title\":\"Measured specialist subject modules\",\"versionRepresentation\":\"Every selected member requires an independent exact managed-release pin.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:specialist-subject-modules> <https://refspec.org/ns/atlas/v3#memberDisposition> "resourceFamily" <urn:ref:atlas-v3:registry-descriptors> .
