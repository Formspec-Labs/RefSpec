<urn:ref:atlas-source-descriptor:census-aspep-function-item-codes> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://refspec.org/ns/atlas/v3#RegistrySource> <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-aspep-function-item-codes> <https://refspec.org/ns/atlas/v3#contentDigest> "sha256:fbe8597d161cdf87f58fd289fcbde42452ff672a16804e3cc3db297351aca80f" <urn:ref:atlas-v3:registry-descriptors> .
<urn:ref:atlas-source-descriptor:census-aspep-function-item-codes> <https://refspec.org/ns/atlas/v3#descriptorPayload> "{\"consumability\":\"inventoryOnly\",\"distributions\":[],\"evidence\":[],\"gap\":\"The independently published HTML list covers functional item codes only; object, fund-source, and other classifications in the larger manual remain separate work.\",\"identifierRepresentation\":\"Preserve each official three-digit ASPEP function item code, label, section, and source edition exactly.\",\"officialLocator\":\"https://www.census.gov/programs-surveys/apes/technical-documentation/code-lists/data-function.html\",\"resourceId\":\"census-aspep-function-item-codes\",\"resourceKind\":\"classification\",\"sourceAvailability\":\"available\",\"title\":\"Census ASPEP function item codes\",\"versionRepresentation\":\"Pin the exact HTML capture, observation time, artifact digest, complete code count, and parser version.\"}"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> <urn:ref:atlas-v3:registry-descriptors> .
