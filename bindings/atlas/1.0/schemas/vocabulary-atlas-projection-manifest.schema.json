{
  "$defs": {
    "absoluteIri": {
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>]+$",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "graph": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "quadCount": {
          "$ref": "#/$defs/positiveInteger"
        },
        "role": {
          "enum": [
            "releaseFacts",
            "analysis"
          ]
        }
      },
      "required": [
        "role",
        "id",
        "quadCount"
      ],
      "type": "object"
    },
    "implementation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "runtime": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        "sourceModules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "path",
              "digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sourceModules",
        "runtime"
      ],
      "type": "object"
    },
    "nonnegativeInteger": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "positiveInteger": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    }
  },
  "$id": "https://refspec.org/bindings/atlas/1.0/schemas/vocabulary-atlas-projection-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "graphs": {
          "contains": {
            "properties": {
              "role": {
                "const": "releaseFacts"
              }
            },
            "required": [
              "role"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "graphs": {
          "contains": {
            "properties": {
              "role": {
                "const": "analysis"
              }
            },
            "required": [
              "role"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        }
      }
    }
  ],
  "description": "A subset of one generated vocabulary atlas, chosen by a named projection policy. It is not an atlas: its identity is derived from the parent it names rather than from generation inputs, and it reproduces from that parent plus its keep rule.",
  "properties": {
    "canonicalPayloadDigest": {
      "$ref": "#/$defs/digest"
    },
    "counts": {
      "additionalProperties": false,
      "description": "Every count is re-derived from this projection's own payload, so the file is checkable without opening its parent.",
      "properties": {
        "analysisFacts": {
          "$ref": "#/$defs/positiveInteger"
        },
        "feedback": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "hierarchyEdges": {
          "$ref": "#/$defs/positiveInteger"
        },
        "labelClusters": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "machineValidations": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "mappingCandidates": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "referenceReleases": {
          "$ref": "#/$defs/positiveInteger"
        },
        "releaseFacts": {
          "$ref": "#/$defs/positiveInteger"
        },
        "searchOnlyMappings": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      },
      "required": [
        "referenceReleases",
        "releaseFacts",
        "analysisFacts",
        "labelClusters",
        "mappingCandidates",
        "searchOnlyMappings",
        "machineValidations",
        "feedback"
      ],
      "type": "object"
    },
    "derivedFrom": {
      "additionalProperties": false,
      "description": "The exact generation this file was cut from. The payload's named graph IRIs are derived from assetId, so the relationship is stated in the bytes as well as the manifest.",
      "properties": {
        "assetId": {
          "$ref": "#/$defs/absoluteIri"
        },
        "distributionDigest": {
          "$ref": "#/$defs/digest"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "assetId",
        "manifestDigest",
        "distributionDigest"
      ],
      "type": "object"
    },
    "format": {
      "const": "refspec-vocabulary-atlas-projection-nquads-1.0"
    },
    "graphs": {
      "items": {
        "$ref": "#/$defs/graph"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "$ref": "#/$defs/absoluteIri"
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/positiveInteger"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "const": "application/n-quads"
        },
        "path": {
          "const": "atlas.nq"
        },
        "quadCount": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "required": [
        "path",
        "mediaType",
        "digest",
        "byteLength",
        "quadCount"
      ],
      "type": "object"
    },
    "projectionDigest": {
      "$ref": "#/$defs/digest"
    },
    "projectionPolicy": {
      "additionalProperties": false,
      "description": "The named keep rule, carried in full so a reader can check what was dropped instead of diffing against the parent.",
      "properties": {
        "id": {
          "$ref": "#/$defs/absoluteIri"
        },
        "keepRule": {
          "minProperties": 1,
          "type": "object"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "keepRule"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "type": {
      "const": "urn:ref:type:VocabularyAtlasProjectionManifest"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "format",
    "projectionDigest",
    "derivedFrom",
    "projectionPolicy",
    "implementation",
    "graphs",
    "output",
    "counts",
    "canonicalPayloadDigest"
  ],
  "title": "RefSpec vocabulary atlas projection manifest 1.0",
  "type": "object"
}
