{"category":"policyArea","conceptIdentityClaimed":false,"definition":"Primary focus of measure is all sources and supplies of energy, including renewable energy sources (e.g., solar and wind), oil and gas, coal, nuclear power; energy efficiency and conservation; costs, prices, and revenues; electric power transmission; public utility matters; hydropower.","id":"urn:ref:crs-source-record:16d806e4a07df391de776d0bd5fade9d0bce89fe33b564036c94e0749df91326:policyArea:%2Fhelp%2Ffield-values%2Fpolicy-area:12","identifiers":[],"identityStatus":"publisherIdentifierAbsent","labels":[{"language":"en","role":"preferred","value":"Energy"}],"localRecordId":"urn:uuid:019fc9f2-c758-74b3-89ca-4747f4b5c9fa","publisherReleaseStatus":"namedReleaseAbsent","resourceName":"policyAreas","sourceArtifact":"urn:ref:crs-source-artifact:policyArea:16d806e4a07df391de776d0bd5fade9d0bce89fe33b564036c94e0749df91326","sourceFetchId":"019fb31d-7cd0-71a4-a23c-d3a206d345f7","sourceObservedAt":"2026-07-30T13:01:22Z","sourceOrdinal":12,"sourcePath":"fieldValues/policyArea[12]","sourceUrl":"https://www.congress.gov/help/field-values/policy-area","uses":["navigation","sourceAssignedEvidence"]}
