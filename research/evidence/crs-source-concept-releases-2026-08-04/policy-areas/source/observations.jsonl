{"category":"policyArea","conceptIdentityClaimed":false,"definition":"Primary focus of measure is natural areas (including wilderness); lands under government jurisdiction (e.g., national parks, national forests, and monuments); land use practices and policies; parks, monuments, and historic sites; fisheries and marine resources; wildfire mitigation and disaster relief on federal lands. Measures concerning energy supplies and production may fall under Energy policy area.","id":"urn:ref:crs-source-record:16d806e4a07df391de776d0bd5fade9d0bce89fe33b564036c94e0749df91326:policyArea:%2Fhelp%2Ffield-values%2Fpolicy-area:25","identifiers":[],"identityStatus":"publisherIdentifierAbsent","labels":[{"language":"en","role":"preferred","value":"Public Lands and Natural Resources"}],"localRecordId":"urn:uuid:019fc9f2-c758-7e0f-8217-e6bb2c30d6b0","publisherReleaseStatus":"namedReleaseAbsent","resourceName":"policyAreas","sourceArtifact":"urn:ref:crs-source-artifact:policyArea:16d806e4a07df391de776d0bd5fade9d0bce89fe33b564036c94e0749df91326","sourceFetchId":"019fb31d-7cd0-71a4-a23c-d3a206d345f7","sourceObservedAt":"2026-07-30T13:01:22Z","sourceOrdinal":25,"sourcePath":"fieldValues/policyArea[25]","sourceUrl":"https://www.congress.gov/help/field-values/policy-area","uses":["navigation","sourceAssignedEvidence"]}
