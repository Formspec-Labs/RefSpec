{"category":"policyArea","conceptIdentityClaimed":false,"definition":"Primary focus of measure is agricultural practices; agricultural prices and marketing; agricultural education; food assistance or nutrition programs; food industry, supply, and safety; aquaculture; horticulture and plants. Measures concerning international trade in agricultural products may fall under Foreign Trade and International Finance policy area. Measures concerning forests on public lands may fall under Public Lands and Natural Resources policy area.","id":"urn:ref:crs-source-record:16d806e4a07df391de776d0bd5fade9d0bce89fe33b564036c94e0749df91326:policyArea:%2Fhelp%2Ffield-values%2Fpolicy-area:1","identifiers":[],"identityStatus":"publisherIdentifierAbsent","labels":[{"language":"en","role":"preferred","value":"Agriculture and Food"}],"localRecordId":"urn:uuid:019fc9f2-c758-73a7-81e8-e1ae4dfc7689","publisherReleaseStatus":"namedReleaseAbsent","resourceName":"policyAreas","sourceArtifact":"urn:ref:crs-source-artifact:policyArea:16d806e4a07df391de776d0bd5fade9d0bce89fe33b564036c94e0749df91326","sourceFetchId":"019fb31d-7cd0-71a4-a23c-d3a206d345f7","sourceObservedAt":"2026-07-30T13:01:22Z","sourceOrdinal":1,"sourcePath":"fieldValues/policyArea[1]","sourceUrl":"https://www.congress.gov/help/field-values/policy-area","uses":["navigation","sourceAssignedEvidence"]}
