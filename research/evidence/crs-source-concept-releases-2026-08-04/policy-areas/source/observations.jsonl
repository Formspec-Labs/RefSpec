{"category":"policyArea","conceptIdentityClaimed":false,"definition":"Primary focus of measure is home ownership; housing programs administration and funding; residential rehabilitation; regional planning, rural and urban development; affordable housing; homelessness; housing industry and construction; fair housing. Measures concerning mortgages and mortgage finance may fall under Finance and Financial Sector policy area.","id":"urn:ref:crs-source-record:16d806e4a07df391de776d0bd5fade9d0bce89fe33b564036c94e0749df91326:policyArea:%2Fhelp%2Ffield-values%2Fpolicy-area:19","identifiers":[],"identityStatus":"publisherIdentifierAbsent","labels":[{"language":"en","role":"preferred","value":"Housing and Community Development"}],"localRecordId":"urn:uuid:019fc9f2-c758-7138-8dbe-48c31c9fe8b8","publisherReleaseStatus":"namedReleaseAbsent","resourceName":"policyAreas","sourceArtifact":"urn:ref:crs-source-artifact:policyArea:16d806e4a07df391de776d0bd5fade9d0bce89fe33b564036c94e0749df91326","sourceFetchId":"019fb31d-7cd0-71a4-a23c-d3a206d345f7","sourceObservedAt":"2026-07-30T13:01:22Z","sourceOrdinal":19,"sourcePath":"fieldValues/policyArea[19]","sourceUrl":"https://www.congress.gov/help/field-values/policy-area","uses":["navigation","sourceAssignedEvidence"]}
